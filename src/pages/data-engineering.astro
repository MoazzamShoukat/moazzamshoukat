---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';

const capabilities = [
  {
    icon: "🔀",
    title: "High-Volume ETL & ELT Pipelines",
    desc: "Robust automated data ingestion pipelines handling scheduled and streaming datasets with zero data loss."
  },
  {
    icon: "🗄️",
    title: "Relational & NoSQL Schema Engineering",
    desc: "Optimized relational database schemas (PostgreSQL) and flexible document stores (MongoDB) designed for 3NF normalization."
  },
  {
    icon: "⚡",
    title: "Database Indexing & Query Optimization",
    desc: "Deep query plan analysis (EXPLAIN ANALYZE), multi-column composite indexing, and partitioning to reduce execution times by up to 90%."
  },
  {
    icon: "🧱",
    title: "ORM Modeling & Data Layer Architecture",
    desc: "Clean object-relational mapping using Peewee ORM, SQLAlchemy, and Django ORM for maintainable application data access."
  },
  {
    icon: "📊",
    title: "Data Warehousing & Mart Structuring",
    desc: "Star-schema and snowflake-schema data modeling for business intelligence dashboards and operational analytics."
  },
  {
    icon: "🚨",
    title: "Automated Data Validation & Alerting",
    desc: "Automated schema drift detection, duplicate detection algorithms, and Slack/email alerting on pipeline anomalies."
  }
];

const faqs = [
  {
    q: "Which databases and data tools do you work with?",
    a: "We have deep hands-on expertise in PostgreSQL, MongoDB, Redis, Python (Pandas, Polars, Peewee ORM, SQLAlchemy), Apache Airflow, Docker, and AWS cloud storage services (S3, RDS)."
  },
  {
    q: "How do you handle pipeline failures and network interruptions?",
    a: "All pipelines are built with idempotent execution principles, exponential backoff retries, persistent state checkpoints, and automated alerting, ensuring zero duplicate records or incomplete data ingestion."
  },
  {
    q: "Can you optimize our existing slow database queries?",
    a: "Yes. We perform systematic database performance audits, analyzing query execution trees, adding missing indexes, refactoring N+1 query patterns, and configuring connection pooling."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title={`Data Engineering & Scalable ETL Pipelines | ${siteData.name}`}
  description="Enterprise data engineering, scalable ETL/ELT workflows, data warehousing, and PostgreSQL optimization by Senior Software & Data Engineer Moazzam Shoukat."
  schema={faqSchema}
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-400">
          <li>
            <a href="/" class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">Home</a>
          </li>
          <li class="text-slate-400">/</li>
          <li>
            <a href="/services" class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">Services</a>
          </li>
          <li class="text-slate-400">/</li>
          <li class="text-amber-700 dark:text-amber-400 font-semibold">
            Data Engineering
          </li>
        </ol>
      </nav>

      <!-- Hero Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-[11px] font-bold uppercase tracking-widest mb-4">
          ENTERPRISE DATA ARCHITECTURE
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0A1128] dark:text-white tracking-tight leading-[1.1]">
          Data Engineering. <br />
          <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-200 bg-clip-text text-transparent">Reliable, Automated Pipelines.</span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Transform fragmented, raw data into clean, normalized analytics-ready assets. Architected by Moazzam Shoukat with 6+ years designing high-throughput ETL workflows, PostgreSQL warehousing schemas, and Peewee ORM models.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="px-8 py-4 rounded-full bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>Consult on Data Architecture</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a
            href="https://wa.me/923280484399?text=Hi%20Moazzam%2C%20I%20want%20to%20discuss%20a%20data%20engineering%20pipeline%20project."
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>WhatsApp Data Engineer</span>
            <span class="text-xs opacity-90">+92-328-048-4399</span>
          </a>
        </div>
      </div>

      <!-- Trust Stats Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-20">
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 text-center shadow-xs">
          <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400">10M+</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-bold mt-1">Records Ingested Daily</div>
        </div>
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 text-center shadow-xs">
          <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400">99.9%</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-bold mt-1">Pipeline Reliability</div>
        </div>
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 text-center shadow-xs">
          <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400">Zero</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-bold mt-1">Data Ingestion Loss</div>
        </div>
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 text-center shadow-xs">
          <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400">Up to 90%</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-bold mt-1">Query Speed Gain</div>
        </div>
      </div>

      <!-- Capabilities Grid -->
      <div class="mb-24">
        <div class="max-w-2xl mb-12">
          <span class="text-xs uppercase tracking-widest font-black text-amber-700 dark:text-amber-400 block mb-2">END-TO-END DATA ENGINEERING</span>
          <h2 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight">Core Competencies</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {capabilities.map((cap) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs hover:border-amber-400/50 transition-all flex flex-col justify-between">
              <div>
                <div class="text-3xl mb-4">{cap.icon}</div>
                <h3 class="text-xl font-bold text-[#0A1128] dark:text-white mb-2">{cap.title}</h3>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{cap.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- FAQs -->
      <div class="mb-24">
        <div class="max-w-2xl mb-12">
          <span class="text-xs uppercase tracking-widest font-black text-amber-700 dark:text-amber-400 block mb-2">TECHNICAL QUESTIONS</span>
          <h2 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight">Frequently Asked Questions</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {faqs.map((faq) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs space-y-3">
              <h4 class="text-base font-bold text-[#0A1128] dark:text-white">{faq.q}</h4>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Bottom Callout -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h3 class="text-2xl sm:text-3xl font-black text-[#0A1128] dark:text-white tracking-tight">
          Ready to Scale Your Data Infrastructure?
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">
          Book an architectural discovery session to review your pipeline requirements and eliminate database bottlenecks.
        </p>
        <div class="pt-2 flex justify-center gap-3">
          <a
            href="/contact"
            class="px-8 py-3.5 rounded-full font-bold text-xs bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 transition-colors shadow-md"
          >
            Start Data Engineering Consultation &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
