---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';

const capabilities = [
  {
    icon: "🔀",
    title: "High-Volume ETL & ELT Pipelines",
    desc: "Robust automated data ingestion pipelines handling scheduled and streaming datasets with zero data loss using Python, Scrapy, and Airflow."
  },
  {
    icon: "🗄️",
    title: "Relational & NoSQL Schema Engineering",
    desc: "Optimized relational database schemas (PostgreSQL) and flexible document stores (MongoDB) designed for 3NF normalization and high-write throughput."
  },
  {
    icon: "⚡",
    title: "Database Indexing & Query Optimization",
    desc: "Deep query plan analysis (EXPLAIN ANALYZE), multi-column composite indexing, and partitioning to reduce execution times by up to 90%."
  },
  {
    icon: "🧱",
    title: "ORM Modeling & Data Layer Architecture",
    desc: "Clean object-relational mapping using Peewee ORM, SQLAlchemy, and Django ORM for maintainable application data access."
  },
  {
    icon: "📊",
    title: "Data Warehousing & Mart Structuring",
    desc: "Star-schema and snowflake-schema data modeling for business intelligence dashboards, real-time analytics, and reporting."
  },
  {
    icon: "🚨",
    title: "Automated Data Validation & Alerting",
    desc: "Automated schema drift detection, duplicate detection algorithms, and Slack/email alerting on pipeline anomalies."
  }
];

const faqs = [
  {
    q: "Which databases, programming languages, and data tools do you work with?",
    a: "We have deep hands-on expertise in Python (Pandas, Polars, Peewee ORM, SQLAlchemy, Scrapy, Selenium), PostgreSQL, MongoDB, Redis, Apache Airflow, Docker, and AWS cloud services (S3, RDS, EC2)."
  },
  {
    q: "How do you handle pipeline failures and network interruptions?",
    a: "All pipelines are built with idempotent execution principles, exponential backoff retries, persistent state checkpoints, and automated alerting, ensuring zero duplicate records or incomplete data ingestion."
  },
  {
    q: "Can you optimize our existing slow database queries and high-traffic bottlenecks?",
    a: "Yes. We perform systematic database performance audits, analyzing query execution trees, adding missing indexes, refactoring N+1 query patterns, and configuring connection pooling."
  },
  {
    q: "Do you build enterprise web scrapers and automated data extractors?",
    a: "Yes. We architect distributed web crawlers using Scrapy and headless browser automation (Playwright/Selenium) capable of bypassing Cloudflare and anti-bot protections to extract clean structured data at scale."
  }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://moazzamshoukat.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://moazzamshoukat.com/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Data Engineering",
      "item": "https://moazzamshoukat.com/data-engineering/"
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Data Engineering & Scalable ETL Pipeline Development",
  "description": "Enterprise data engineering, automated ETL workflows, web scraping, and PostgreSQL optimization by Senior Software & Data Engineer Moazzam Shoukat.",
  "provider": {
    "@type": "Person",
    "name": "Moazzam Shoukat",
    "url": "https://moazzamshoukat.com/"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title={`Data Engineer & Python Developer | Scalable ETL Pipelines | ${siteData.name}`}
  description="Enterprise data engineering, Python ETL pipelines, automated web scraping systems, and PostgreSQL database optimization by Senior Data Engineer Moazzam Shoukat."
  keywords="Data Engineer, Python Developer, Web Developer, Web Scraping Services, Data Engineering Services, PostgreSQL Optimization, Python ETL Pipelines, Peewee ORM"
  schema={[breadcrumbSchema, serviceSchema, faqSchema]}
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-400">
          <li>
            <a href="/" class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">Home</a>
          </li>
          <li class="text-slate-400">/</li>
          <li>
            <a href="/services/" class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">Services</a>
          </li>
          <li class="text-slate-400">/</li>
          <li class="text-amber-700 dark:text-amber-400 font-semibold">
            Data Engineering
          </li>
        </ol>
      </nav>

      <!-- Hero Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-[11px] font-bold uppercase tracking-widest mb-4">
          ENTERPRISE DATA ARCHITECTURE & PYTHON DEVELOPMENT
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0A1128] dark:text-white tracking-tight leading-[1.1]">
          Data Engineering. <br />
          <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-200 bg-clip-text text-transparent">Reliable, Automated Pipelines.</span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Transform fragmented, raw data into clean, normalized analytics-ready assets. Architected by Moazzam Shoukat with 6+ years designing high-throughput Python ETL workflows, PostgreSQL warehousing schemas, and Peewee ORM models.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/contact/"
            class="px-8 py-4 rounded-full bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>Consult on Data Architecture</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a
            href="https://wa.me/923280484399?text=Hi%20Moazzam%2C%20I%20want%20to%20discuss%20a%20data%20engineering%20pipeline%20project."
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>WhatsApp Data Engineer</span>
          </a>
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-20">
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 text-center">
          <div class="text-3xl font-black text-amber-600 dark:text-amber-400">10M+</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">Records Ingested Daily</div>
        </div>
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 text-center">
          <div class="text-3xl font-black text-amber-600 dark:text-amber-400">99.9%</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">Pipeline Uptime</div>
        </div>
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 text-center">
          <div class="text-3xl font-black text-amber-600 dark:text-amber-400">&lt;100ms</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">Indexed Query Speeds</div>
        </div>
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 text-center">
          <div class="text-3xl font-black text-amber-600 dark:text-amber-400">0%</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">Data Ingestion Loss</div>
        </div>
      </div>

      <!-- Capabilities Grid -->
      <div class="mb-20">
        <h2 class="text-2xl sm:text-3xl font-black text-[#0A1128] dark:text-white mb-2">
          Core Data Engineering Capabilities
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-8">
          End-to-end data systems engineered for resilience, data hygiene, and automated error recovery.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {capabilities.map((item) => (
            <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800 hover:border-amber-500/50 transition-all">
              <span class="text-3xl mb-4 block">{item.icon}</span>
              <h3 class="text-base font-bold text-[#0A1128] dark:text-white mb-2">
                {item.title}
              </h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Tech Stack Ribbon -->
      <div class="mb-20 p-8 rounded-3xl bg-slate-50 dark:bg-[#111827] border border-slate-200 dark:border-slate-800">
        <h2 class="text-base font-extrabold text-[#0A1128] dark:text-white mb-4 uppercase tracking-wider text-xs">
          Production Technologies & Frameworks
        </h2>
        <div class="flex flex-wrap gap-2">
          {["Python", "PostgreSQL", "MongoDB", "Redis", "Peewee ORM", "SQLAlchemy", "Scrapy", "Selenium", "Pandas", "Polars", "Docker", "AWS S3", "AWS RDS", "Apache Airflow", "Git"].map((tech) => (
            <span class="px-3.5 py-1.5 rounded-xl bg-white dark:bg-[#0A1128] border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-800 dark:text-slate-200">
              {tech}
            </span>
          ))}
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="mb-20">
        <h2 class="text-2xl sm:text-3xl font-black text-[#0A1128] dark:text-white mb-6">
          Frequently Asked Questions: Data Engineering
        </h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800">
              <h3 class="text-sm font-bold text-[#0A1128] dark:text-white mb-2">
                {faq.q}
              </h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Contact Banner -->
      <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-[#0A1128] to-[#1E293B] text-white border border-amber-500/20 text-center">
        <h2 class="text-2xl sm:text-3xl font-black mb-3">
          Need a Custom Data Pipeline or Web Scraper?
        </h2>
        <p class="text-xs sm:text-sm text-slate-300 max-w-xl mx-auto mb-6">
          Whether you need a high-concurrency scraping cluster, PostgreSQL database optimization, or an end-to-end ETL system, let's architect your solution.
        </p>
        <a
          href="/contact/"
          class="inline-block px-8 py-3.5 rounded-full bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-xs uppercase tracking-wider transition-all shadow-lg"
        >
          Schedule Technical Consultation &rarr;
        </a>
      </div>

    </div>
  </div>
</Layout>
