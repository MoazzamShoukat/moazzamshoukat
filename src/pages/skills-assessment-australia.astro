---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';
import SkillsAssessmentSteps from '../components/infographics/SkillsAssessmentSteps.astro';

const faqs = [
  {
    q: "What is an ACS Skills Assessment and how much experience is deducted?",
    a: "The Australian Computer Society (ACS) assesses IT professionals. ACS compares your tertiary degree to Australian standards. If your degree is an ICT Major closely related to your nominated ANZSCO code, ACS typically deducts 2 years of work experience to deem you 'skilled'. If your degree is not closely related or an ICT Minor, 4 to 6 years may be deducted. We structure your documentation to minimize deductions."
  },
  {
    q: "What is a Competency Demonstration Report (CDR) for Engineers Australia?",
    a: "If your engineering degree from Pakistan was completed under Non-Washington Accord accreditation (or you wish to qualify under a specific engineering occupational code), you must submit a CDR. This requires three distinct Career Episodes showcasing your technical engineering contributions, a Continuing Professional Development (CPD) record, and a cross-referenced Summary Statement."
  },
  {
    q: "Can non-IT graduates pass an ACS assessment via Recognition of Prior Learning (RPL)?",
    a: "Yes. Professionals with non-ICT degrees or no formal university qualification who possess 6+ years of relevant industry experience can submit an ACS RPL report containing two detailed Project Reports demonstrating ICT core bodies of knowledge."
  },
  {
    q: "How long is a positive Australian Skills Assessment valid?",
    a: "Most Australian skills assessments (including ACS and Engineers Australia) remain valid for 2 to 3 years from the date of issuance (or as specified on the outcome letter) for lodgement in SkillSelect EOIs."
  },
  {
    q: "What third-party evidence is required to prove paid employment?",
    a: "Assessing bodies mandate official third-party documentary proof alongside employer reference letters. This includes income tax returns (FBR withholding statements or active tax assessments), official bank salary credit statements, and employment social security or provident fund records."
  },
  {
    q: "Which assessing authority handles management and business roles?",
    a: "VETASSESS evaluates over 350 general professional occupations, including Marketing Specialists, Management Consultants, Project Administrators, and Financial Investment Advisors. Each requires highly specific job descriptions meeting Group A/B/C criteria."
  }
];

const offerings = [
  {
    icon: "💻",
    title: "ACS Skills Assessment (ICT)",
    desc: "Complete documentation for Software Engineers (261313), Developer Programmers (261312), Systems Analysts, and Data Scientists."
  },
  {
    icon: "⚙️",
    title: "Engineers Australia CDR Preparation",
    desc: "High-level drafting of 3 Career Episodes, Summary Statement, and CPD list fully compliant with the EA Migration Skills Assessment booklet."
  },
  {
    icon: "📋",
    title: "VETASSESS Professional Dossiers",
    desc: "Meticulous organizational chart preparation, task descriptions, and tertiary qualification alignment for Group A, B, and C occupations."
  },
  {
    icon: "✍️",
    title: "ACS RPL (Prior Learning) Reports",
    desc: "Expert technical authorship of the 2 mandatory Project Reports for candidates transitioning from engineering/business into tech."
  },
  {
    icon: "📑",
    title: "ANZSCO Reference Letter Drafting",
    desc: "Precision employer reference letters written to match 65%+ of the official ANZSCO core duties without generic copying."
  },
  {
    icon: "🔍",
    title: "Pre-Submission Forensic Audit",
    desc: "Line-by-line verification of payslips, bank statements, tax documents, and academic transcripts prior to official filing."
  }
];

const stats = [
  { value: "100%", label: "Positive Outcome Rate" },
  { value: "4-6 Wks", label: "Average Dossier Assembly" },
  { value: "+15 Pts", label: "Points Unlocked for EOI" },
  { value: "0", label: "Fraud / Discrepancy Flags" }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title="Skills Assessment Australia | ACS, Engineers Australia & VETASSESS | Moazzam Shoukat"
  description="Meticulous Australian skills assessment documentation. Expert guidance for ACS IT assessments (Software Engineers, Data Scientists), Engineers Australia CDR reports, and VETASSESS from Pakistan."
  keywords="Skills Assessment Australia, ACS Skills Assessment Pakistan, Engineers Australia CDR Lahore, VETASSESS assessment Pakistan, ACS RPL Project Report, ANZSCO Software Engineer 261313, Australia migration skills assessment"
  schema={faqSchema}
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Service Page Hero Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-[11px] font-bold uppercase tracking-widest mb-4">
          AUSTRALIA SKILLS ASSESSMENT (ACS, EA, VETASSESS)
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0A1128] dark:text-white tracking-tight leading-[1.1]">
          Skills Assessment Australia. <br />
          <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-200 bg-clip-text text-transparent">Flawless Audit-Proof Dossiers.</span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          The foundation of your Australian Permanent Residency. As a Senior Software Engineer and Migration Strategist, Moazzam Shoukat structures your ACS, Engineers Australia (CDR), and VETASSESS filings to eliminate work experience deduction surprises.
        </p>

        <!-- CTA Action Row -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="px-8 py-4 rounded-full bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>Book Assessment Audit</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a
            href="https://wa.me/923280484399?text=Hi%20Moazzam%2C%20I%20need%20help%20with%20my%20Australia%20Skills%20Assessment."
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>WhatsApp Specialist</span>
            <span class="text-xs opacity-90">+92-328-048-4399</span>
          </a>
        </div>
      </div>

      <!-- Trust Stat Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-20">
        {stats.map((s) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs text-center">
            <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400 tracking-tight">{s.value}</div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-1 font-bold">{s.label}</div>
          </div>
        ))}
      </div>

      <!-- Offerings Grid -->
      <div class="mb-24">
        <div class="max-w-2xl mb-12">
          <h2 class="text-xs uppercase tracking-widest font-black text-amber-700 dark:text-amber-400 mb-2">ASSESSMENT DOMAINS</h2>
          <h3 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight">Authorities Covered</h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm mt-3">Tailored documentation strategies matching the exacting requirements of Australia's premier assessing bodies.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {offerings.map((item) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs hover:border-amber-400/50 transition-all flex flex-col justify-between">
              <div>
                <div class="text-3xl mb-4">{item.icon}</div>
                <h4 class="text-xl font-bold text-[#0A1128] dark:text-white mb-2">{item.title}</h4>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- NEW EMBEDDED INFOGRAPHIC: 4-Step Skills Assessment Workflow -->
      <div class="mb-24">
        <SkillsAssessmentSteps />
      </div>

      <!-- Why Choose Moazzam Shoukat Section -->
      <div class="p-8 sm:p-12 lg:p-16 rounded-3xl bg-[#0A1128] text-white border border-amber-500/20 mb-24">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-7 space-y-6">
            <span class="inline-block px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-400 text-[11px] font-bold uppercase tracking-widest">
              WHY CHOOSE MOAZZAM SHOUKAT
            </span>
            <h3 class="text-3xl sm:text-4xl font-black tracking-tight leading-tight">
              Software Precision Meets Migration Governance.
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Standard visa agents lack technical backgrounds; they copy and paste generic job descriptions that lead to immediate ACS rejections or massive 4-year experience deductions. As an active Senior Software Engineer, Moazzam speaks the technical language of your actual daily work and translates it into compliant ANZSCO terminology.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
              <div class="flex items-start gap-3">
                <span class="text-amber-400 font-bold text-lg">✓</span>
                <div>
                  <h5 class="text-sm font-bold text-white">Zero Deduction Surprises</h5>
                  <p class="text-xs text-slate-400 mt-0.5">We calculate your deemed 'skilled' date prior to submission.</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-amber-400 font-bold text-lg">✓</span>
                <div>
                  <h5 class="text-sm font-bold text-white">Plagiarism-Free CDR Reports</h5>
                  <p class="text-xs text-slate-400 mt-0.5">Custom drafted engineering episodes reflecting your genuine FYP or projects.</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-amber-400 font-bold text-lg">✓</span>
                <div>
                  <h5 class="text-sm font-bold text-white">Tax & Salary Reconciliation</h5>
                  <p class="text-xs text-slate-400 mt-0.5">Verification that bank statements, FBR records, and letters harmonize.</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-amber-400 font-bold text-lg">✓</span>
                <div>
                  <h5 class="text-sm font-bold text-white">Direct EOI Integration</h5>
                  <p class="text-xs text-slate-400 mt-0.5">Seamless transition to SkillSelect EOI once the outcome letter arrives.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="lg:col-span-5 flex flex-col gap-4 p-6 sm:p-8 rounded-2xl bg-slate-900/90 border border-slate-800">
            <div class="text-xs uppercase tracking-widest text-amber-400 font-bold">PRE-ASSESSMENT AUDIT</div>
            <div class="text-2xl font-black text-white">Review Your Experience</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Send your resume and degree title to evaluate whether you meet the ICT Major / ANZSCO criteria and calculate your deductible years.
            </p>
            <div class="pt-2 flex flex-col sm:flex-row gap-3">
              <a
                href="/contact"
                class="text-center px-6 py-3 rounded-full bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-bold text-xs transition-all shadow-md"
              >
                Request Audit
              </a>
              <a
                href="https://wa.me/923280484399?text=Hello%20Moazzam,%20I%20want%20to%20audit%20my%20resume%20for%20ACS%20Skills%20Assessment."
                target="_blank"
                rel="noopener noreferrer"
                class="text-center px-6 py-3 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-xs transition-all shadow-md"
              >
                WhatsApp Advisor
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ Accordion / Cards -->
      <div class="mb-24">
        <div class="max-w-2xl mb-12">
          <h2 class="text-xs uppercase tracking-widest font-black text-amber-700 dark:text-amber-400 mb-2">FREQUENTLY ASKED QUESTIONS</h2>
          <h3 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight">Skills Assessment Queries</h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm mt-3">Essential details regarding deduction guidelines, RPL, and document authentication.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {faqs.map((faq, i) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs">
              <div class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">
                  {i + 1}
                </span>
                <div>
                  <h4 class="text-base font-bold text-[#0A1128] dark:text-white mb-2">{faq.q}</h4>
                  <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{faq.a}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Bottom Conversion Callout -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h3 class="text-2xl sm:text-3xl font-black text-[#0A1128] dark:text-white tracking-tight">
          Ready to Secure a Positive Assessment Outcome?
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">
          Book an audit session to analyze your employment letters, avoid ACS deduction pitfalls, and claim full points for your career.
        </p>
        <div class="pt-2 flex justify-center gap-3">
          <a
            href="/contact"
            class="px-8 py-3.5 rounded-full font-bold text-xs bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 transition-colors shadow-md"
          >
            Start Assessment Review &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
