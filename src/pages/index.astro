---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';
---

<Layout
  title={`${siteData.name} | Senior Software Engineer & Immigration Strategist`}
  description={siteData.shortBio}
>
  <!-- Hero Section (Nova Minimalist Style) -->
  <section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
    <!-- Subtle Organic Ambient Lights -->
    <div class="absolute top-10 right-1/4 w-96 h-96 bg-amber-400/10 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute bottom-10 left-1/4 w-96 h-96 bg-stone-300/20 dark:bg-zinc-800/20 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Tagline Pill -->
      <div class="flex items-center gap-2 mb-6">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-stone-200/60 dark:bg-zinc-800/80 border border-stone-300/60 dark:border-zinc-700/60 text-stone-800 dark:text-stone-200 text-xs font-bold uppercase tracking-widest">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          STRATEGY • TECHNOLOGY • IMMIGRATION
        </span>
      </div>

      <!-- Main Headline Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <div class="lg:col-span-8 space-y-6">
          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-stone-900 dark:text-white tracking-tight leading-[1.08]">
            Designing Resilient Backends. <br />
            <span class="text-stone-500 dark:text-stone-400">Guiding Global PR.</span>
          </h1>

          <p class="text-base sm:text-xl text-stone-600 dark:text-stone-300 max-w-2xl font-normal leading-relaxed">
            I am <strong class="text-stone-900 dark:text-white font-bold">{siteData.name}</strong>. Senior Software Engineer with a research background in speech processing, and an immigration strategist specializing in Canadian & Australian permanent residency.
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="/contact"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-xs font-bold bg-amber-400 hover:bg-amber-300 text-stone-950 transition-all shadow-2xs hover:shadow-xs active:scale-95"
            >
              <span>Let’s Talk</span>
              <span>→</span>
            </a>

            <a
              href="/selected-work"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-xs font-semibold text-stone-800 dark:text-stone-200 bg-stone-200/60 dark:bg-zinc-800/70 hover:bg-stone-200 dark:hover:bg-zinc-800 transition-colors"
            >
              <span>See Selected Work</span>
              <span>↗</span>
            </a>

            <a
              href="/immigration"
              class="inline-flex items-center gap-2 px-5 py-3.5 rounded-full text-xs font-semibold text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-white transition-colors"
            >
              Immigration Pathways →
            </a>
          </div>

          <!-- Quick Verified Badges -->
          <div class="pt-4 flex flex-wrap items-center gap-3 text-xs text-stone-500 dark:text-stone-400 font-medium">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 shadow-2xs">
              📍 Lahore, Pakistan
            </span>
            <a href={siteData.socials.scholar} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 hover:border-amber-400 transition-colors">
              🎓 5 Research Papers
            </a>
            <a href={siteData.socials.upwork} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 hover:border-emerald-500 transition-colors">
              💼 Upwork Talent
            </a>
            <a href={siteData.contact.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
              💬 Direct WhatsApp
            </a>
          </div>
        </div>

        <!-- Right Visual Card (Nova Rounded Bento Style) -->
        <div class="lg:col-span-4 flex justify-center">
          <div class="w-full max-w-sm bg-white dark:bg-[#18181B] rounded-3xl p-6 border border-stone-200/80 dark:border-zinc-800 shadow-xl space-y-5">
            
            <div class="aspect-square rounded-2xl overflow-hidden bg-stone-100 dark:bg-zinc-800 relative">
              <img
                src="/images/moazzam.png"
                alt="Moazzam Shoukat"
                class="w-full h-full object-cover object-top"
                onerror="this.src='/favicon.svg'"
              />
              <div class="absolute bottom-3 left-3 px-3 py-1 rounded-full bg-stone-900/80 backdrop-blur-md text-white text-[10px] font-bold tracking-wider uppercase">
                Dual Practice
              </div>
            </div>

            <div>
              <h2 class="text-xl font-extrabold text-stone-900 dark:text-white leading-tight">Moazzam Shoukat</h2>
              <p class="text-xs text-stone-600 dark:text-stone-300 mt-0.5">Software Engineer & Migration Advisor</p>
            </div>

            <!-- Two Visual Cards inside -->
            <div class="space-y-2 pt-2 border-t border-stone-100 dark:border-zinc-800 text-xs">
              <div class="p-3 rounded-xl bg-stone-50 dark:bg-zinc-900/80 border border-stone-100 dark:border-zinc-800/60 flex items-center justify-between">
                <div>
                  <span class="block font-bold text-stone-900 dark:text-white">Backend Systems</span>
                  <span class="text-[11px] text-stone-600 dark:text-stone-300">Django, Scrapy, PostgreSQL</span>
                </div>
                <a href="/experience" class="text-xs font-bold text-stone-900 dark:text-white hover:text-amber-500">→</a>
              </div>

              <div class="p-3 rounded-xl bg-amber-50/70 dark:bg-amber-950/30 border border-amber-100 dark:border-amber-900/40 flex items-center justify-between">
                <div>
                  <span class="block font-bold text-amber-950 dark:text-amber-200">Canada & Australia PR</span>
                  <span class="text-[11px] text-amber-800 dark:text-amber-400">ACS, EA, NAATI CCL Urdu</span>
                </div>
                <a href="/immigration" class="text-xs font-bold text-amber-600 dark:text-amber-400">→</a>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Minimalist Stat Strip -->
      <div class="mt-16 pt-10 border-t border-stone-200/80 dark:border-zinc-800">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {siteData.stats.map((st) => (
            <div class="p-5 rounded-2xl bg-white dark:bg-[#18181B] border border-stone-200/70 dark:border-zinc-800">
              <span class="block text-3xl sm:text-4xl font-black text-stone-900 dark:text-white tracking-tight">
                {st.value}
              </span>
              <span class="block text-xs font-bold text-stone-800 dark:text-stone-200 mt-1">
                {st.label}
              </span>
              <span class="block text-[11px] text-stone-600 dark:text-stone-300 mt-0.5">
                {st.sublabel}
              </span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- Featured Selected Work Strip (Nova Style) -->
  <section class="py-20 bg-stone-100/60 dark:bg-zinc-900/40 border-y border-stone-200/60 dark:border-zinc-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-widest text-stone-600 dark:text-stone-300 block mb-2">FEATURED CASES</span>
          <h2 class="text-3xl sm:text-4xl font-black text-stone-900 dark:text-white tracking-tight">
            Selected Work
          </h2>
        </div>
        <a
          href="/selected-work"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-stone-900 dark:text-white hover:text-amber-600 dark:hover:text-amber-400 transition-colors"
        >
          <span>View all {siteData.selectedProjects.length} projects</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {siteData.selectedProjects.slice(0, 3).map((item) => (
          <div class="group p-6 rounded-3xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 hover:border-stone-400 dark:hover:border-zinc-600 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-stone-100 dark:bg-zinc-800 text-stone-700 dark:text-stone-300">
                  {item.category}
                </span>
                <span class="text-xs text-stone-400">{item.period}</span>
              </div>
              <h3 class="text-lg font-bold text-stone-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors mb-2">
                {item.title}
              </h3>
              <p class="text-xs text-stone-600 dark:text-stone-300 leading-relaxed mb-4">
                {item.shortDesc}
              </p>
            </div>
            <div class="pt-4 border-t border-stone-100 dark:border-zinc-800 flex items-center justify-between text-xs font-semibold">
              <span class="text-stone-600 dark:text-stone-300">{item.tag}</span>
              <a href="/selected-work" class="text-stone-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400">
                Explore →
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Two Pillars of Mastery Infographic (Minimalist) -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-[11px] font-bold uppercase tracking-widest text-stone-600 dark:text-stone-300 block mb-2">VALUE PROPOSITION</span>
        <h2 class="text-3xl sm:text-4xl font-black text-stone-900 dark:text-white tracking-tight">
          Engineering & Immigration Synergy
        </h2>
        <p class="mt-3 text-sm text-stone-600 dark:text-stone-300">
          How rigorous technical engineering principles translate into zero-error migration petitions.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Pillar 1: Engineering -->
        <div class="p-8 sm:p-10 rounded-3xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 shadow-xs space-y-6">
          <div class="w-12 h-12 rounded-2xl bg-stone-900 dark:bg-white text-white dark:text-stone-950 flex items-center justify-center font-black text-lg">
            01
          </div>
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-stone-600 dark:text-stone-300 block mb-1">Pillar One</span>
            <h3 class="text-2xl font-extrabold text-stone-900 dark:text-white">Software Architecture & Data Pipelines</h3>
          </div>
          <p class="text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
            Hands-on development at Emulation AI and Ibtidah Solutions. Scalable Django microservices, anti-bot web crawling with Scrapy/Selenium, and published research in speech transformer models.
          </p>
          <div class="pt-4 border-t border-stone-100 dark:border-zinc-800 flex items-center gap-4">
            <a href="/experience" class="text-xs font-bold text-stone-900 dark:text-white hover:underline">
              Experience Timeline →
            </a>
            <a href="/education-research" class="text-xs font-bold text-stone-600 dark:text-stone-300 hover:underline">
              5 Research Papers →
            </a>
          </div>
        </div>

        <!-- Pillar 2: Immigration -->
        <div class="p-8 sm:p-10 rounded-3xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 shadow-xs space-y-6">
          <div class="w-12 h-12 rounded-2xl bg-amber-400 text-stone-950 flex items-center justify-center font-black text-lg">
            02
          </div>
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400 block mb-1">Pillar Two</span>
            <h3 class="text-2xl font-extrabold text-stone-900 dark:text-white">Immigration & Language Pedagogy</h3>
          </div>
          <p class="text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
            Data-backed strategy for Canada Express Entry, Australia GSM (189/190/491), ANZSCO Skills Assessment submissions, and NAATI CCL Urdu training (+5 PR points).
          </p>
          <div class="pt-4 border-t border-stone-100 dark:border-zinc-800 flex items-center gap-4">
            <a href="/immigration" class="text-xs font-bold text-amber-700 dark:text-amber-400 hover:underline">
              Immigration Roadmaps →
            </a>
            <a href="/english-training" class="text-xs font-bold text-stone-600 dark:text-stone-300 hover:underline">
              NAATI CCL Urdu & IELTS →
            </a>
          </div>
        </div>

      </div>

      <!-- Bottom Nova CTA -->
      <div class="mt-16 p-8 sm:p-12 rounded-3xl bg-stone-900 text-white dark:bg-zinc-900 border border-stone-800 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-[11px] font-bold text-amber-400 uppercase tracking-widest block mb-1">START A CONVERSATION</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold">Ready to evaluate your case or hire engineering leadership?</h2>
        </div>
        <a
          href="/contact"
          class="px-6 py-3.5 rounded-full text-xs font-bold bg-amber-400 hover:bg-amber-300 text-stone-950 transition-colors flex-shrink-0"
        >
          Book Consultation →
        </a>
      </div>

    </div>
  </section>
</Layout>
