---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';
import { successStoriesData } from '../data/successStoriesData';
import { blogPosts } from '../data/blogData';

// Infographics
import IeltsBandGuide from '../components/infographics/IeltsBandGuide.astro';
import PteScoreComparison from '../components/infographics/PteScoreComparison.astro';
import CanadaVsAustraliaPathway from '../components/infographics/CanadaVsAustraliaPathway.astro';
import SkillsAssessmentSteps from '../components/infographics/SkillsAssessmentSteps.astro';

const coreCoachingServices = [
  {
    href: "/online-pte-classes/",
    badge: "PTE 79+ / SUPERIOR",
    title: "Online PTE Classes (1-on-1)",
    desc: "Personalized live online coaching for Pakistan, Australia & Gulf candidates. Speech AI waveform diagnostics, prediction banks, and full mock test portals.",
    target: "Target: 79+ (+20 PR Pts)",
    icon: "🌐"
  },
  {
    href: "/naati-ccl-urdu-preparation/",
    badge: "AUSTRALIA +5 POINTS",
    title: "NAATI CCL Urdu Online Classes",
    desc: "Master bilateral dialogue interpretation with proprietary symbol shorthand, 50+ authentic recorded dialogues, and proctored MS Teams mock exams.",
    target: "+5 Migration Bonus",
    icon: "🗣️"
  },
  {
    href: "/pte-trainer-lahore/",
    badge: "LAHORE IN-PERSON",
    title: "PTE Trainer in Lahore",
    desc: "Rigorous classroom and hybrid PTE Academic coaching in Lahore with test center noise simulations, headset calibration, and individual voice analysis.",
    target: "In-Person & Online",
    icon: "📍"
  },
  {
    href: "/ielts-trainer-lahore/",
    badge: "BAND 7.5+ & 8.0",
    title: "IELTS Coaching (Lahore & Online)",
    desc: "Examiner-rubric evaluation for Speaking and Writing Task 2. AREA response frameworks and structured Cambridge practice tests for Academic and General Training.",
    target: "CLB 9/10 Reach",
    icon: "🎯"
  },
  {
    href: "/australia-skilled-migration/",
    badge: "AUSTRALIA PR (189/190/491)",
    title: "Australia PR Points Guidance",
    desc: "Merit-based points test engineering for Subclasses 189, 190, and 491. Strategic EOI lodgement and State Nomination Registrations of Interest.",
    target: "Points Optimization",
    icon: "🦘"
  },
  {
    href: "/skill-assessment-guidance/",
    badge: "ACS • EA CDR • VETASSESS",
    title: "Skills Assessment Guidance",
    desc: "Meticulous pre-vetting of reference letters, ANZSCO duty alignment, Engineers Australia CDR Career Episodes, and third-party salary evidence.",
    target: "Pre-Vetting & Audit",
    icon: "📊"
  }
];

const technicalHighlights = [
  {
    title: "AI & Speech Processing Research",
    desc: "7 peer-reviewed papers in Elsevier Computer Science Review and IEEE on speech transformers, audio foundation models, and healthcare acoustics.",
    link: "/ai-research/",
    label: "Explore Research Papers"
  },
  {
    title: "Data Engineering & Distributed Scraping",
    desc: "Architecting high-scale web crawlers, proxy rotation, and automated ETL pipelines loading millions of records into PostgreSQL warehouses.",
    link: "/data-engineering/",
    label: "View Data Architecture"
  },
  {
    title: "Full-Stack Software Development",
    desc: "Production web applications engineered with Next.js, Astro, Python backends, and modern cloud deployment standards.",
    link: "/web-development/",
    label: "Review Development Stack"
  }
];

const latestBlogs = blogPosts.slice(0, 3);
const topStories = successStoriesData.slice(0, 3);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Moazzam Shoukat",
  "jobTitle": "PTE, NAATI CCL & IELTS Master Trainer, Australia PR Guidance Specialist",
  "url": "https://moazzamshoukat.com/",
  "sameAs": [
    "https://www.linkedin.com/in/moazzamshoukat/",
    "https://scholar.google.com/citations?user=uU550yYAAAAJ",
    "https://github.com/moazzamshoukat"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Lahore",
    "addressRegion": "Punjab",
    "addressCountry": "PK"
  },
  "knowsAbout": [
    "PTE Academic Preparation",
    "NAATI CCL Urdu",
    "IELTS Academic and General Training",
    "Australia Skilled Migration Points Guidance",
    "Australian Skills Assessment Documentation"
  ]
};
---

<Layout
  title="Moazzam Shoukat | PTE, NAATI CCL & IELTS Trainer"
  description="Expert 1-on-1 coaching for PTE Academic, NAATI CCL Urdu, and IELTS in Lahore and online. Strategic guidance for Australian PR points and skills assessment."
  schema={personSchema}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-[#0A1128] via-[#0F172A] to-[#0A1128] text-white pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden border-b border-amber-500/20">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_25%,rgba(212,175,55,0.09),transparent_60%)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Identity Badge -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-slate-900/80 border border-amber-400/30 text-amber-300 text-xs font-semibold mb-8 backdrop-blur-xl shadow-lg">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="tracking-wide">Online PTE Trainer &bull; NAATI CCL Urdu &bull; IELTS &bull; Australia PR Points Guidance</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Hero Content (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-[1.1] text-white">
            PTE, NAATI CCL & IELTS Coaching. <br class="hidden sm:inline" />
            <span class="bg-gradient-to-r from-amber-200 via-amber-400 to-amber-200 bg-clip-text text-transparent">
              Australia PR Points & Skills Assessment
            </span> Guidance.
          </h1>

          <p class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed max-w-2xl">
            Specialized 1-on-1 coaching to score <strong class="text-white font-semibold">PTE 79+ Superior English (+20 points)</strong> and clear <strong class="text-white font-semibold">NAATI CCL Urdu (+5 points)</strong>, paired with technical pre-vetting for Australian skills assessments (ACS, Engineers Australia CDR, VETASSESS).
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
            <a
              href="/contact/"
              class="inline-flex items-center justify-center px-8 py-4 text-xs sm:text-sm font-black text-slate-950 bg-gradient-to-r from-amber-400 via-amber-300 to-amber-400 hover:from-amber-300 hover:to-amber-200 rounded-full shadow-lg shadow-amber-500/20 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-0.5 active:translate-y-0 text-center cursor-pointer"
            >
              Book Consultation &rarr;
            </a>

            <a
              href="/online-pte-classes/"
              class="inline-flex items-center justify-center px-7 py-4 text-xs sm:text-sm font-bold text-slate-200 hover:text-white bg-white/10 hover:bg-white/15 border border-white/20 hover:border-amber-400/60 rounded-full backdrop-blur-md transition-all duration-300 text-center cursor-pointer"
            >
              <span>Explore Online PTE Classes</span>
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="pt-4 flex flex-wrap items-center gap-4 text-xs text-slate-400">
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span>Speech AI Researcher (Google Scholar Verified)</span>
            </div>
            <span>&bull;</span>
            <span>ITU Lahore BS CS</span>
            <span>&bull;</span>
            <span>Lahore &bull; Online Worldwide</span>
          </div>

        </div>

        <!-- Right Profile Visual Card (5 cols) -->
        <div class="lg:col-span-5">
          <div class="relative mx-auto max-w-sm sm:max-w-md lg:max-w-none">
            <div class="relative rounded-3xl bg-white/10 dark:bg-[#0C1428]/85 border border-white/20 dark:border-amber-500/30 p-5 sm:p-6 backdrop-blur-2xl shadow-2xl text-white">
              
              <div class="relative overflow-hidden rounded-2xl bg-gradient-to-b from-[#101935] to-[#0A1128] border border-amber-400/30 group">
                <div class="aspect-[4/5] w-full relative overflow-hidden bg-slate-900 flex items-center justify-center">
                  <picture>
                    <source srcset="/images/moazzam.webp" type="image/webp" />
                    <img
                      src="/images/moazzam.png"
                      alt="Moazzam Shoukat - PTE, NAATI CCL and IELTS Master Trainer"
                      width="800"
                      height="1000"
                      fetchpriority="high"
                      loading="eager"
                      decoding="async"
                      class="w-full h-full object-cover object-center"
                    />
                  </picture>
                  <div class="absolute bottom-3 left-3 px-3 py-1.5 rounded-xl bg-slate-950/85 backdrop-blur-md border border-white/15 text-[11px] font-bold text-white shadow-lg flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Accepting 1-on-1 Students</span>
                  </div>
                </div>
              </div>

              <div class="pt-4 pb-1 flex items-center justify-between border-b border-white/10">
                <div>
                  <h2 class="text-lg font-black text-white tracking-tight">Moazzam Shoukat</h2>
                  <p class="text-[11px] text-amber-400/90 font-medium">
                    Master English Trainer &bull; Australia PR Points Strategist
                  </p>
                </div>
                <div class="text-right">
                  <span class="text-xs font-black text-amber-300">PTE 79+ &bull; NAATI CCL</span>
                  <p class="text-[10px] text-slate-400">1-on-1 Coaching</p>
                </div>
              </div>

            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- LEAD SERVICES: Core Coaching & PR Points Guidance -->
  <section class="py-20 bg-white dark:bg-[#0F172A] border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="max-w-3xl">
        <span class="text-xs font-extrabold uppercase tracking-widest text-amber-700 dark:text-amber-400">
          CORE SERVICES & SPECIALIZATIONS
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight mt-1">
          Master Your Test Scores & Maximize Australia PR Points
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2">
          Specialized preparation engineered around the actual test mechanics and official immigration criteria.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {coreCoachingServices.map((svc) => (
          <a
            href={svc.href}
            class="group p-8 rounded-3xl bg-slate-50 dark:bg-[#111827] border border-slate-200 dark:border-slate-800 hover:border-amber-400/60 shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-5">
                <span class="text-3xl group-hover:scale-110 transition-transform">{svc.icon}</span>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold tracking-wider bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20">
                  {svc.badge}
                </span>
              </div>

              <h3 class="text-xl font-bold text-[#0A1128] dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors mb-2">
                {svc.title}
              </h3>

              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                {svc.desc}
              </p>
            </div>

            <div class="pt-5 mt-5 border-t border-slate-200/60 dark:border-slate-800 flex items-center justify-between text-xs font-bold">
              <span class="text-amber-700 dark:text-amber-400 font-extrabold">{svc.target}</span>
              <span class="text-slate-500 group-hover:text-amber-600 dark:group-hover:text-amber-400 group-hover:translate-x-1 transition-all">
                View Program &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- INFOGRAPHICS SECTION: Concise Comparative Systems -->
  <section class="py-20 bg-slate-50 dark:bg-[#0B0F19] border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-extrabold uppercase tracking-widest text-amber-700 dark:text-amber-400">
          Visual Decision Frameworks
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight">
          Clear Roadmaps for Language Scores & PR Points
        </h2>
      </div>

      <!-- Concise PTE Score Comparison with link to full page -->
      <PteScoreComparison compact={true} />

      <!-- Canada vs Australia Pathway -->
      <CanadaVsAustraliaPathway />

      <!-- Skills Assessment Workflow -->
      <SkillsAssessmentSteps />

    </div>
  </section>

  <!-- SECONDARY SECTION: Technology, Engineering & AI Research -->
  <section class="py-20 bg-white dark:bg-[#0F172A] border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-8 mb-10 border-b border-slate-200 dark:border-slate-800">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-widest text-amber-700 dark:text-amber-400">
            ENGINEERING & RESEARCH BACKGROUND
          </span>
          <h2 class="text-3xl font-black text-[#0A1128] dark:text-white tracking-tight mt-1">
            Technology, Data Architecture & Speech AI Research
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2 max-w-2xl">
            Beyond test coaching, Moazzam Shoukat is an active software engineer and published researcher in speech transformers and large audio foundation models.
          </p>
        </div>
        <a
          href="/ai-research/"
          class="text-xs font-bold text-amber-700 dark:text-amber-400 hover:underline inline-flex items-center gap-1 shrink-0"
        >
          <span>Explore AI Research & Papers &rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {technicalHighlights.map((tech) => (
          <div class="p-8 rounded-3xl bg-slate-50 dark:bg-[#111827] border border-slate-200 dark:border-slate-800 flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-bold text-[#0A1128] dark:text-white mb-2">{tech.title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{tech.desc}</p>
            </div>
            <div class="pt-6 mt-6 border-t border-slate-200/60 dark:border-slate-800">
              <a href={tech.link} class="text-xs font-bold text-amber-700 dark:text-amber-400 hover:underline">
                {tech.label} &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Success Stories Spotlight -->
  <!-- OWNER_VERIFY: Testimonials, client names, and specific score claims pending owner verification -->
  <section class="py-20 bg-slate-50 dark:bg-[#0B0F19] border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-widest text-amber-700 dark:text-amber-400">
            Candidate Testimonials
          </span>
          <h2 class="text-3xl font-black text-[#0A1128] dark:text-white tracking-tight mt-1">
            Student & Applicant Experiences
          </h2>
        </div>
        <a
          href="/success-stories/"
          class="text-xs font-bold text-amber-700 dark:text-amber-400 hover:underline inline-flex items-center gap-1"
        >
          <span>View All Scorecards</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {topStories.map((story) => (
          <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 flex flex-col justify-between shadow-xs">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20">
                  {story.category}
                </span>
                <span class="text-xs font-bold text-amber-700 dark:text-amber-400">
                  {story.targetBadge}
                </span>
              </div>

              <h3 class="text-lg font-bold text-[#0A1128] dark:text-white">
                {story.name}
              </h3>

              <p class="text-xs font-semibold text-amber-600 dark:text-amber-400">
                {story.achievement}
              </p>

              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 italic leading-relaxed">
                "{story.testimonial}"
              </p>
            </div>

            <div class="pt-6 mt-6 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between text-xs text-slate-500">
              <span>{story.city}</span>
              <span class="text-slate-400">{story.date}</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Latest Insights & Guides Section -->
  <section class="py-20 bg-white dark:bg-[#0F172A] border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-extrabold uppercase tracking-widest text-amber-700 dark:text-amber-400">
            Knowledge Hub ({blogPosts.length} Guides Available)
          </span>
          <h2 class="text-3xl font-black text-[#0A1128] dark:text-white tracking-tight mt-1">
            Latest Preparation Guides & Analysis
          </h2>
        </div>
        <a
          href="/blog/"
          class="text-xs font-bold text-amber-700 dark:text-amber-400 hover:underline inline-flex items-center gap-1"
        >
          <span>Explore All Articles</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {latestBlogs.map((post) => (
          <article class="p-8 rounded-3xl bg-slate-50 dark:bg-[#111827] border border-slate-200 dark:border-slate-800 flex flex-col justify-between hover:border-amber-400/60 shadow-xs hover:shadow-lg transition-all group">
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-4">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20">
                  {post.category}
                </span>
                <span>{post.readTime}</span>
              </div>

              <h3 class="text-lg font-bold text-[#0A1128] dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors leading-snug">
                <a href={`/blog/${post.slug}/`}>
                  {post.title}
                </a>
              </h3>

              <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 line-clamp-3 leading-relaxed">
                {post.excerpt}
              </p>
            </div>

            <div class="pt-6 mt-6 border-t border-slate-200/60 dark:border-slate-800 flex items-center justify-between">
              <span class="text-xs text-slate-400">{post.publishDate}</span>
              <a
                href={`/blog/${post.slug}/`}
                class="text-xs font-bold text-amber-700 dark:text-amber-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1"
              >
                <span>Read Guide</span>
                <span>&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- Final Consultation Action Banner -->
  <section class="py-20 bg-gradient-to-r from-[#0A1128] to-[#1E293B] text-white border-t border-amber-500/20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <span class="px-3.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-widest bg-amber-500/10 text-amber-300 border border-amber-500/20">
        START YOUR PREPARATION TODAY
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight">
        Ready to Achieve 79+ in PTE or +5 Points in NAATI CCL?
      </h2>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Whether you need 1-on-1 diagnostic PTE voice coaching, NAATI CCL Urdu dialogue interpretation, or Australian PR points planning, connect directly with Moazzam Shoukat.
      </p>
      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contact/"
          class="px-8 py-4 rounded-full font-black text-xs sm:text-sm bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 transition-colors shadow-xl"
        >
          Book Consultation &rarr;
        </a>
        <a
          href="https://wa.me/923280484399?text=Hi%20Moazzam%2C%20I%20would%20like%20to%20book%20a%20consultation"
          target="_blank"
          rel="noopener noreferrer"
          class="px-7 py-4 rounded-full font-bold text-xs sm:text-sm border border-white/20 hover:bg-white/10 text-white transition-colors flex items-center gap-2"
