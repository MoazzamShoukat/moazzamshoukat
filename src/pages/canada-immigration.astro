---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';
import CanadaVsAustraliaPathway from '../components/infographics/CanadaVsAustraliaPathway.astro';

const faqs = [
  {
    q: "What is the current CRS cutoff trend for Canada Express Entry?",
    a: "While general all-program draws have elevated CRS score requirements (often 510–540), Category-Based Selection draws (such as STEM occupations, Healthcare, Trades, and French speakers) and Provincial Nominee Program (PNP) aligned draws offer significantly lower CRS thresholds (frequently 470–495 for STEM category draws)."
  },
  {
    q: "How do Category-Based Selection draws help Pakistani tech professionals?",
    a: "Under category-based selection, IRCC invites candidates based on specific NOC (National Occupational Classification) work experience—including Software Engineers, Data Scientists, Web Developers, and Cybersecurity Specialists. This allows Pakistani IT professionals with 6+ months of qualified experience and CLB 7+ language scores to receive ITAs ahead of higher-scoring general candidates."
  },
  {
    q: "Which Provincial Nominee Program (PNP) works best without a Canadian job offer?",
    a: "Top programs include Ontario Immigrant Nominee Program (OINP Human Capital Priorities - Tech Draws), Saskatchewan Immigrant Nominee Program (SINP Occupations In-Demand & Express Entry), and Alberta Advantage Immigration Program (AAIP Tech Pathway). Each grants 600 bonus CRS points, virtually guaranteeing an ITA."
  },
  {
    q: "What is an Educational Credential Assessment (ECA) and which body should I use?",
    a: "An ECA verifies that your foreign degree (e.g. 4-year BS from HEC-recognized universities) is equivalent to a Canadian credential. World Education Services (WES) is the most popular, fast, and reliable choice for general degrees; medical degrees use MCC, and pharmacy degrees use PEBC."
  },
  {
    q: "How much settlement funds (Proof of Funds - POF) are required?",
    a: "As of current IRCC tables, a single applicant requires approximately CAD $14,690, a couple needs around CAD $18,288, and a family of four needs approx CAD $27,315. Funds must be unencumbered, liquid in a bank account, and officially documented."
  },
  {
    q: "Can I apply for Canada PR without prior Canadian study or work experience?",
    a: "Yes. The Federal Skilled Worker Program (FSWP) under Express Entry evaluates candidates solely on age, foreign education, foreign skilled work experience, and official English/French language proficiency."
  }
];

const offerings = [
  {
    icon: "🍁",
    title: "Express Entry (FSW & CEC)",
    desc: "End-to-end profile building, NOC code matching, and strategic pool management for maximum competitive advantage."
  },
  {
    icon: "💻",
    title: "STEM & Tech Category Draws",
    desc: "Capitalize on targeted IRCC invitations designed specifically for software engineers, data architects, and IT specialists in Pakistan."
  },
  {
    icon: "🏛️",
    title: "Provincial Nominee Programs (PNP)",
    desc: "Targeted nomination filings for Ontario (OINP Tech), Saskatchewan (SINP), Alberta (AAIP), and British Columbia (BC PNP)."
  },
  {
    icon: "📈",
    title: "CRS Score Maximization",
    desc: "Systematic points optimization combining CLB 9/10 English scores, dual-degree evaluations, and spousal point bonuses."
  },
  {
    icon: "📑",
    title: "e-APR Flawless Audit",
    desc: "Rigorous verification of reference letters, job duties alignment, police clearances, and proof of funds before post-ITA submission."
  },
  {
    icon: "🎓",
    title: "ECA (WES) & HEC Attestation",
    desc: "Step-by-step guidance for degree verification, university transcripts dispatch, and WES Canadian equivalency reports."
  }
];

const stats = [
  { value: "95+", label: "Successful PR Applications" },
  { value: "480-505", label: "Average Client CRS Range" },
  { value: "600 Pts", label: "PNP Bonus Nominations" },
  { value: "100%", label: "NOC Alignment Accuracy" }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title="Canada Immigration Consultant Lahore | Express Entry & PNP | Moazzam Shoukat"
  description="Trusted Canada immigration consultant in Lahore. Expert guidance on Express Entry STEM category draws, Provincial Nominee Programs (OINP, SINP, AAIP), CRS score optimization, and WES ECA."
  keywords="Canada Immigration Consultant, Canada Immigration Consultant Lahore, Canada PR Pakistan, Express Entry Lahore, OINP Tech Draw, Canada STEM category draws, WES ECA Pakistan, CRS calculator Canada"
  schema={faqSchema}
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Service Page Hero Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-[11px] font-bold uppercase tracking-widest mb-4">
          CANADA PERMANENT RESIDENCY & IMMIGRATION
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0A1128] dark:text-white tracking-tight leading-[1.1]">
          Canada Immigration Consultant. <br />
          <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-200 bg-clip-text text-transparent">Express Entry & PNP Strategy.</span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Navigate the Canadian immigration system with algorithmic precision. From maximizing your Comprehensive Ranking System (CRS) score to securing Provincial Nominations and STEM Category Draw invitations from Lahore, Pakistan.
        </p>

        <!-- CTA Action Row -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="px-8 py-4 rounded-full bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>Book CRS Assessment</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a
            href="https://wa.me/923280484399?text=Hi%20Moazzam%2C%20I%20want%20a%20Canada%20PR%20profile%20evaluation."
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>WhatsApp Consultant</span>
            <span class="text-xs opacity-90">+92-328-048-4399</span>
          </a>
        </div>
      </div>

      <!-- Trust Stat Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-20">
        {stats.map((s) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs text-center">
            <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400 tracking-tight">{s.value}</div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-1 font-bold">{s.label}</div>
          </div>
        ))}
      </div>

      <!-- Offerings Grid -->
      <div class="mb-24">
        <div class="max-w-2xl mb-12">
          <h2 class="text-xs uppercase tracking-widest font-black text-amber-700 dark:text-amber-400 mb-2">IMMIGRATION PATHWAYS</h2>
          <h3 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight">Comprehensive Canada PR Roadmap</h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm mt-3">From initial points assessment to receiving your Confirmation of Permanent Residence (COPR).</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {offerings.map((item) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs hover:border-amber-400/50 transition-all flex flex-col justify-between">
              <div>
                <div class="text-3xl mb-4">{item.icon}</div>
                <h4 class="text-xl font-bold text-[#0A1128] dark:text-white mb-2">{item.title}</h4>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- NEW EMBEDDED INFOGRAPHIC: Canada vs Australia Pathway Matrix -->
      <div class="mb-24">
        <CanadaVsAustraliaPathway />
      </div>

      <!-- Why Choose Moazzam Shoukat Section -->
      <div class="p-8 sm:p-12 lg:p-16 rounded-3xl bg-[#0A1128] text-white border border-amber-500/20 mb-24">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-7 space-y-6">
            <span class="inline-block px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-400 text-[11px] font-bold uppercase tracking-widest">
              WHY CHOOSE MOAZZAM SHOUKAT
            </span>
            <h3 class="text-3xl sm:text-4xl font-black tracking-tight leading-tight">
              Eliminate Technical Rejections and Ambiguity.
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Most immigration applications fail not because the candidate lacks qualification, but due to incorrect NOC mapping, substandard employment reference letters, or miscalculated CRS points. With professional diligence and software precision, every document is audited prior to filing.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
              <div class="flex items-start gap-3">
                <span class="text-amber-400 font-bold text-lg">✓</span>
                <div>
                  <h5 class="text-sm font-bold text-white">NOC Alignment Guarantee</h5>
                  <p class="text-xs text-slate-400 mt-0.5">Custom drafted job duties matching IRCC's exact lead statements.</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-amber-400 font-bold text-lg">✓</span>
                <div>
                  <h5 class="text-sm font-bold text-white">Integrated Language Training</h5>
                  <p class="text-xs text-slate-400 mt-0.5">Direct coaching to secure CLB 9/10 (Band 8+ in IELTS/PTE).</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-amber-400 font-bold text-lg">✓</span>
                <div>
                  <h5 class="text-sm font-bold text-white">Transparent Case Management</h5>
                  <p class="text-xs text-slate-400 mt-0.5">Real-time access to your IRCC portal and GCKey credentials.</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-amber-400 font-bold text-lg">✓</span>
                <div>
                  <h5 class="text-sm font-bold text-white">Zero False Promises</h5>
                  <p class="text-xs text-slate-400 mt-0.5">We only accept files with realistic, legally viable pathways to PR.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="lg:col-span-5 flex flex-col gap-4 p-6 sm:p-8 rounded-2xl bg-slate-900/90 border border-slate-800">
            <div class="text-xs uppercase tracking-widest text-amber-400 font-bold">CALCULATE YOUR CHANCES</div>
            <div class="text-2xl font-black text-white">Free CRS & PNP Assessment</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Submit your age, degree, work experience, and language test results for an exhaustive points breakdown and PNP strategy.
            </p>
            <div class="pt-2 flex flex-col sm:flex-row gap-3">
              <a
                href="/contact"
                class="text-center px-6 py-3 rounded-full bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-bold text-xs transition-all shadow-md"
              >
                Request Assessment
              </a>
              <a
                href="https://wa.me/923280484399?text=Hello%20Moazzam,%20I%20would%20like%20a%20free%20Canada%20CRS%20points%20evaluation."
                target="_blank"
                rel="noopener noreferrer"
                class="text-center px-6 py-3 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-xs transition-all shadow-md"
              >
                WhatsApp Advisor
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ Accordion / Cards -->
      <div class="mb-24">
        <div class="max-w-2xl mb-12">
          <h2 class="text-xs uppercase tracking-widest font-black text-amber-700 dark:text-amber-400 mb-2">FREQUENTLY ASKED QUESTIONS</h2>
          <h3 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight">Canada PR Inquiries</h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm mt-3">Essential guidelines for Express Entry and Provincial Nominee candidates from Pakistan.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {faqs.map((faq, i) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs">
              <div class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">
                  {i + 1}
                </span>
                <div>
                  <h4 class="text-base font-bold text-[#0A1128] dark:text-white mb-2">{faq.q}</h4>
                  <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{faq.a}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Bottom Conversion Callout -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h3 class="text-2xl sm:text-3xl font-black text-[#0A1128] dark:text-white tracking-tight">
          Ready to Begin Your Canada Immigration Journey?
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">
          Let’s review your credentials, calculate your CRS score accurately, and chart your optimal provincial nomination roadmap today.
        </p>
        <div class="pt-2 flex justify-center gap-3">
          <a
            href="/contact"
            class="px-8 py-3.5 rounded-full font-bold text-xs bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 transition-colors shadow-md"
          >
            Start Profile Assessment &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
