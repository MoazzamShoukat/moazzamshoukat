---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';
---

<Layout
  title={`Selected Work & Projects | ${siteData.name}`}
  description="Explore featured work across software engineering, speech AI research, ETL pipelines, and immigration case optimization."
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Nova Style Minimalist Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-stone-200/70 dark:bg-zinc-800 text-stone-800 dark:text-stone-200 text-[11px] font-bold uppercase tracking-widest mb-4">
          PORTFOLIO / SELECTED CASES
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-stone-900 dark:text-white tracking-tight leading-[1.1]">
          Crafted Systems. <br />
          <span class="text-stone-500 dark:text-stone-400">Measurable Outcomes.</span>
        </h1>
        <p class="mt-4 text-base text-stone-600 dark:text-stone-300 max-w-xl">
          A curated selection of backend architectures, speech processing research surveys, data scraping engines, and immigration case breakthroughs.
        </p>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 pb-10 border-b border-stone-200/80 dark:border-zinc-800 mb-12">
        <button
          class="project-filter active px-4 py-2 rounded-full text-xs font-bold transition-all bg-stone-900 text-white dark:bg-white dark:text-stone-950 shadow-2xs"
          data-category="all"
        >
          All Projects ({siteData.selectedProjects.length})
        </button>
        <button
          class="project-filter px-4 py-2 rounded-full text-xs font-semibold text-stone-600 dark:text-stone-300 hover:bg-stone-200/70 dark:hover:bg-zinc-800 transition-all"
          data-category="Engineering & Data"
        >
          Engineering & Data
        </button>
        <button
          class="project-filter px-4 py-2 rounded-full text-xs font-semibold text-stone-600 dark:text-stone-300 hover:bg-stone-200/70 dark:hover:bg-zinc-800 transition-all"
          data-category="AI & Research"
        >
          AI & Research
        </button>
        <button
          class="project-filter px-4 py-2 rounded-full text-xs font-semibold text-stone-600 dark:text-stone-300 hover:bg-stone-200/70 dark:hover:bg-zinc-800 transition-all"
          data-category="Immigration & Tools"
        >
          Immigration & Tools
        </button>
      </div>

      <!-- Project Cards Grid (Bento / Modern Rounded Cards) -->
      <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {siteData.selectedProjects.map((project, idx) => (
          <div
            class="project-card group relative flex flex-col justify-between p-8 rounded-3xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 hover:border-stone-400 dark:hover:border-zinc-600 shadow-xs hover:shadow-lg transition-all duration-300 overflow-hidden"
            data-category={project.category}
          >
            <!-- Background Ambient Glow -->
            <div class={`absolute -top-12 -right-12 w-48 h-48 rounded-full bg-gradient-to-br ${project.gradient} blur-2xl pointer-events-none opacity-60 group-hover:opacity-100 transition-opacity`}></div>

            <div>
              <!-- Top Metadata Row -->
              <div class="flex items-center justify-between gap-4 mb-6">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] font-bold tracking-wider uppercase bg-stone-100 dark:bg-zinc-800/80 text-stone-700 dark:text-stone-300 border border-stone-200/60 dark:border-zinc-700/60">
                  {project.tag}
                </span>
                <span class="text-xs font-medium text-stone-400">
                  {project.period}
                </span>
              </div>

              <!-- Title & Role -->
              <h3 class="text-2xl font-extrabold text-stone-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors mb-2">
                {project.title}
              </h3>
              <p class="text-xs font-semibold text-stone-500 dark:text-stone-400 mb-4">
                Role: {project.role} • {project.category}
              </p>

              <!-- Short Description -->
              <p class="text-sm text-stone-600 dark:text-stone-300 leading-relaxed mb-6">
                {project.shortDesc}
              </p>

              <!-- Infographic Metrics Bar -->
              <div class="grid grid-cols-3 gap-2 p-3.5 rounded-2xl bg-stone-50 dark:bg-zinc-900/80 border border-stone-100 dark:border-zinc-800/80 mb-6">
                {project.impactMetrics.map((m) => (
                  <div class="text-center">
                    <span class="block text-xs sm:text-sm font-black text-stone-900 dark:text-white">
                      {m.value}
                    </span>
                    <span class="block text-[10px] text-stone-600 dark:text-stone-300 uppercase tracking-tight">
                      {m.label}
                    </span>
                  </div>
                ))}
              </div>

              <!-- Tech Stack Chips -->
              <div class="flex flex-wrap gap-1.5 mb-8">
                {project.stack.map((s) => (
                  <span class="px-2.5 py-1 rounded-lg text-[11px] font-medium bg-stone-100 dark:bg-zinc-800/60 text-stone-700 dark:text-stone-300">
                    {s}
                  </span>
                ))}
              </div>
            </div>

            <!-- Card Bottom Action Link -->
            <div class="pt-4 border-t border-stone-100 dark:border-zinc-800/80 flex items-center justify-between">
              <span class="text-xs text-stone-600 dark:text-stone-300">
                Case details available
              </span>
              <a
                href={project.link || "/contact"}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-stone-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors"
              >
                <span>View Details</span>
                <span class="transition-transform group-hover:translate-x-0.5">→</span>
              </a>
            </div>

          </div>
        ))}
      </div>

      <!-- Bottom Nova Style CTA -->
      <div class="mt-20 p-8 sm:p-12 rounded-3xl bg-stone-900 text-white dark:bg-zinc-900 border border-stone-800 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-[11px] font-bold text-amber-400 uppercase tracking-widest block mb-1">HAVE A SIMILAR INITIATIVE?</span>
          <h2 class="text-2xl sm:text-3xl font-bold">Let’s build scalable systems or design your immigration roadmap.</h2>
        </div>
        <a
          href="/contact"
          class="px-6 py-3.5 rounded-full text-xs font-bold bg-amber-400 hover:bg-amber-300 text-stone-950 transition-colors flex-shrink-0"
        >
          Start a Conversation →
        </a>
      </div>

    </div>
  </div>
</Layout>

<script>
  function setupProjectFilters() {
    const filterBtns = document.querySelectorAll('.project-filter');
    const cards = document.querySelectorAll('.project-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle active style
        filterBtns.forEach(b => {
          b.classList.remove('bg-stone-900', 'text-white', 'dark:bg-white', 'dark:text-stone-950', 'active');
          b.classList.add('text-stone-600', 'dark:text-stone-300');
        });
        btn.classList.add('bg-stone-900', 'text-white', 'dark:bg-white', 'dark:text-stone-950', 'active');
        btn.classList.remove('text-stone-600', 'dark:text-stone-300');

        const category = btn.getAttribute('data-category');

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (category === 'all' || cardCat === category) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  setupProjectFilters();
  document.addEventListener('astro:after-swap', setupProjectFilters);
</script>
