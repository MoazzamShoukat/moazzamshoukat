---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';
---

<Layout
  title={`Technical Skills & Matrix | Moazzam Shoukat`}
  description="Comprehensive technical and advisory skills matrix of Moazzam Shoukat: Python, PostgreSQL, Scrapy, Selenium, Django, AWS, Canada PR, and IELTS/PTE coaching."
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-[11px] font-bold uppercase tracking-widest mb-4">
          CAPABILITIES & COMPETENCY MATRIX
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0A1128] dark:text-white tracking-tight leading-[1.1]">
          Technical & Strategic <br />
          <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-200 bg-clip-text text-transparent">Core Proficiencies.</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
          Structured breakdown of software engineering frameworks, ETL pipelines, databases, cloud platforms, immigration regulations, and test pedagogy.
        </p>
      </div>

      <!-- Skills Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
        {siteData.skillCategories.map((cat, idx) => (
          <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 hover:border-amber-400/50 hover:shadow-lg transition-all duration-200 flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-black uppercase tracking-widest text-amber-700 dark:text-amber-400 block mb-1">
                Domain 0{idx + 1}
              </span>
              <h3 class="text-xl font-black text-[#0A1128] dark:text-white mb-2">{cat.title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 mb-6 leading-relaxed">{cat.description}</p>
              
              <div class="space-y-2">
                {cat.skills.map((s) => (
                  <div class="flex items-center justify-between text-xs p-2.5 rounded-xl bg-slate-50 dark:bg-[#0F172A] border border-slate-100 dark:border-slate-800">
                    <span class="font-bold text-[#0A1128] dark:text-white">{s.name}</span>
                    <span class="text-[10px] font-extrabold px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20">
                      {s.level}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Additional Competencies Strip -->
      <div class="p-8 sm:p-12 rounded-3xl bg-[#0A1128] text-white border border-amber-500/20">
        <span class="text-[11px] font-bold uppercase tracking-widest text-amber-400 block mb-2">SYSTEMIC ADVANTAGES</span>
        <h2 class="text-2xl sm:text-3xl font-black text-white mb-6">Execution & Leadership Strengths</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
          <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-1.5">
            <h4 class="font-bold text-white text-sm">Systems Troubleshooting</h4>
            <p class="text-slate-400 leading-relaxed">Fast root-cause analysis across distributed web architectures, scraping blocks, and query bottlenecks.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-1.5">
            <h4 class="font-bold text-white text-sm">Algorithmic Pedagogy</h4>
            <p class="text-slate-400 leading-relaxed">Translating AI speech scoring algorithms and exam rubrics into reproducible student scores.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-1.5">
            <h4 class="font-bold text-white text-sm">Agile & SDLC Execution</h4>
            <p class="text-slate-400 leading-relaxed">Disciplined software engineering lifecycle, automated tests, clean git workflows, and documentation.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-1.5">
            <h4 class="font-bold text-white text-sm">Statutory Due Diligence</h4>
            <p class="text-slate-400 leading-relaxed">Rigorous audit of reference letters, payslips, and statutory declarations to ensure zero refusal risk.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>
