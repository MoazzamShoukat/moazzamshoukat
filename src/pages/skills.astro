---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';
---

<Layout
  title={`Skills & Proficiencies | ${siteData.name}`}
  description="Technical proficiencies spanning backend architecture, data pipelines, cloud infrastructure, immigration law, and language coaching."
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Nova Minimalist Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-stone-200/70 dark:bg-zinc-800 text-stone-800 dark:text-stone-200 text-[11px] font-bold uppercase tracking-widest mb-4">
          CAPABILITIES / MATRIX
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-stone-900 dark:text-white tracking-tight leading-[1.1]">
          Technical & Legal <br />
          <span class="text-stone-500 dark:text-stone-400">Core Proficiencies.</span>
        </h1>
        <p class="mt-4 text-base text-stone-600 dark:text-stone-300 max-w-xl">
          Detailed breakdown of software frameworks, ETL data pipelines, migration legislation, and language scoring mechanics.
        </p>
      </div>

      <!-- Skills Bento Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
        {siteData.skillCategories.map((cat, idx) => (
          <div class="p-8 rounded-3xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 hover:border-stone-400 dark:hover:border-zinc-600 transition-all flex flex-col justify-between">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-stone-600 dark:text-stone-300 block mb-1">
                Category 0{idx + 1}
              </span>
              <h3 class="text-xl font-black text-stone-900 dark:text-white mb-2">{cat.title}</h3>
              <p class="text-xs text-stone-600 dark:text-stone-300 mb-6 leading-relaxed">{cat.description}</p>
              
              <div class="space-y-2">
                {cat.skills.map((s) => (
                  <div class="flex items-center justify-between text-xs p-2.5 rounded-xl bg-stone-50 dark:bg-zinc-900/80 border border-stone-100 dark:border-zinc-800">
                    <span class="font-bold text-stone-900 dark:text-white">{s.name}</span>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-stone-200/70 dark:bg-zinc-800 text-stone-800 dark:text-stone-200">
                      {s.level}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Soft Skills Callout -->
      <div class="p-8 sm:p-12 rounded-3xl bg-stone-100/70 dark:bg-zinc-900/60 border border-stone-200 dark:border-zinc-800">
        <span class="text-[11px] font-bold uppercase tracking-widest text-amber-700 dark:text-amber-400 block mb-2">ADDITIONAL COMPETENCIES</span>
        <h2 class="text-2xl sm:text-3xl font-black text-stone-900 dark:text-white mb-6">Execution & Leadership Strengths</h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
          <div class="p-5 rounded-2xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 space-y-1">
            <h4 class="font-bold text-stone-900 dark:text-white">Systems Troubleshooting</h4>
            <p class="text-stone-600 dark:text-stone-300">Debugging multi-layer web architectures and resolving critical API latency bottlenecks.</p>
          </div>
          <div class="p-5 rounded-2xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 space-y-1">
            <h4 class="font-bold text-stone-900 dark:text-white">Pedagogical Clarity</h4>
            <p class="text-stone-600 dark:text-stone-300">Deconstructing complex machine-learning algorithms and English exam rubrics for students.</p>
          </div>
          <div class="p-5 rounded-2xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 space-y-1">
            <h4 class="font-bold text-stone-900 dark:text-white">Agile & SDLC Execution</h4>
            <p class="text-stone-600 dark:text-stone-300">Sprint planning, PR reviews, automated CI/CD test runs, and continuous delivery.</p>
          </div>
          <div class="p-5 rounded-2xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 space-y-1">
            <h4 class="font-bold text-stone-900 dark:text-white">Immigration Due Diligence</h4>
            <p class="text-stone-600 dark:text-stone-300">Auditing reference letters and statutory declarations against official legal guidelines.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>
