---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';
---

<Layout
  title={`English Coaching & NAATI CCL Urdu | ${siteData.name}`}
  description="Master IELTS Band 8+, PTE Academic 79+ Superior, TOEFL, Duolingo, and secure +5 Australia PR points with NAATI CCL Urdu coaching."
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Nova Minimalist Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-stone-200/70 dark:bg-zinc-800 text-stone-800 dark:text-stone-200 text-[11px] font-bold uppercase tracking-widest mb-4">
          LANGUAGE PEDAGOGY / NAATI CCL
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-stone-900 dark:text-white tracking-tight leading-[1.1]">
          High Band Scores. <br />
          <span class="text-stone-500 dark:text-stone-400">+5 Australian PR Points.</span>
        </h1>
        <p class="mt-4 text-base text-stone-600 dark:text-stone-300 max-w-xl">
          Algorithm-tested strategies for IELTS 8+, PTE 79+ Superior English, and intensive bilingual dialogue training for NAATI CCL Urdu.
        </p>

        <!-- Social coaching badges -->
        <div class="mt-6 flex flex-wrap items-center gap-3 text-xs">
          <a
            href={siteData.socials.coachingInstagram}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 text-stone-800 dark:text-stone-200 font-semibold hover:border-pink-500 transition-colors shadow-2xs"
          >
            <span>📸</span> Follow @coachingbyms on Instagram
          </a>
          <a
            href={siteData.socials.coachingFacebook}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white dark:bg-zinc-900 border border-stone-200 dark:border-zinc-800 text-stone-800 dark:text-stone-200 font-semibold hover:border-blue-500 transition-colors shadow-2xs"
          >
            <span>📘</span> Follow @coachingbyms on Facebook
          </a>
        </div>
      </div>

      <!-- NAATI CCL Highlight Banner (Nova Bento Style) -->
      <div class="p-8 sm:p-12 rounded-3xl bg-amber-500/10 dark:bg-amber-500/5 border border-amber-300 dark:border-amber-500/30 mb-20 relative overflow-hidden">
        <div class="max-w-3xl space-y-4">
          <span class="px-3 py-1 rounded-full bg-amber-400 text-stone-950 text-[10px] font-black uppercase tracking-wider inline-block">
            +5 Bonus Points For Australia PR
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-stone-900 dark:text-white">
            NAATI CCL Urdu Masterclass
          </h2>
          <p class="text-xs sm:text-sm text-stone-700 dark:text-stone-300 leading-relaxed">
            The Credentialed Community Language (CCL) test awards an immediate 5 bonus points towards your Australia PR points test. In competitive invitation rounds, those 5 points make the crucial difference.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
            <div class="p-4 rounded-2xl bg-white dark:bg-[#18181B] border border-stone-200/60 dark:border-zinc-800 text-xs">
              <strong class="block text-stone-900 dark:text-white mb-1">Live Dialogues</strong>
              <span class="text-stone-600 dark:text-stone-300">100+ interpretation simulations with instant phonetic feedback.</span>
            </div>
            <div class="p-4 rounded-2xl bg-white dark:bg-[#18181B] border border-stone-200/60 dark:border-zinc-800 text-xs">
              <strong class="block text-stone-900 dark:text-white mb-1">Domain Glossaries</strong>
              <span class="text-stone-600 dark:text-stone-300">Medical, Legal, Social Security, and Housing terminology.</span>
            </div>
            <div class="p-4 rounded-2xl bg-white dark:bg-[#18181B] border border-stone-200/60 dark:border-zinc-800 text-xs">
              <strong class="block text-stone-900 dark:text-white mb-1">Memory Shortcuts</strong>
              <span class="text-stone-600 dark:text-stone-300">Note-taking symbols to eliminate omission and distortion errors.</span>
            </div>
          </div>
          <div class="pt-2">
            <a
              href="/contact?service=NAATI%20CCL%20Urdu%20Training"
              class="inline-block px-5 py-3 rounded-full font-bold text-xs bg-amber-400 hover:bg-amber-300 text-stone-950 transition-colors shadow-2xs"
            >
              Enroll in Upcoming NAATI CCL Batch →
            </a>
          </div>
        </div>
      </div>

      <!-- Test Breakdown Bento Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
        
        <!-- IELTS -->
        <div class="p-8 rounded-3xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 shadow-xs space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xl font-extrabold text-stone-900 dark:text-white">IELTS (Academic & General)</h3>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-stone-100 dark:bg-zinc-800 text-stone-800 dark:text-stone-200">Band 8+ Target</span>
          </div>
          <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
            Essential for Canada Express Entry (CLB 9/10) and Australian Skilled Visas. Master Cambridge test mechanics and high-yield Task 2 essay writing structures.
          </p>
          <div class="space-y-1.5 pt-3 border-t border-stone-100 dark:border-zinc-800 text-xs text-stone-700 dark:text-stone-300">
            <div>✓ Listening & Reading keyword tracking</div>
            <div>✓ Writing Task 1 & 2 Lexical Resource rubrics</div>
            <div>✓ 1-on-1 Speaking fluency and pronunciation drills</div>
          </div>
        </div>

        <!-- PTE Academic -->
        <div class="p-8 rounded-3xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 shadow-xs space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xl font-extrabold text-stone-900 dark:text-white">PTE Academic</h3>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-900 dark:text-amber-300">79+ Superior Target</span>
          </div>
          <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
            PTE Academic uses automated AI grading. Because of my software engineering and AI background, I teach you exactly how the algorithms evaluate your responses.
          </p>
          <div class="space-y-1.5 pt-3 border-t border-stone-100 dark:border-zinc-800 text-xs text-stone-700 dark:text-stone-300">
            <div>✓ Read Aloud acoustic stress & oral fluency</div>
            <div>✓ Tested Describe Image & Retell Lecture templates</div>
            <div>✓ Write From Dictation memory retention drills</div>
          </div>
        </div>

        <!-- TOEFL iBT -->
        <div class="p-8 rounded-3xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 shadow-xs space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xl font-extrabold text-stone-900 dark:text-white">TOEFL iBT</h3>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-stone-100 dark:bg-zinc-800 text-stone-800 dark:text-stone-200">100+ Target</span>
          </div>
          <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
            Essential for university graduate admissions across North America. Focus on academic lecture synthesis and integrated writing.
          </p>
        </div>

        <!-- Duolingo English Test -->
        <div class="p-8 rounded-3xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 shadow-xs space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="text-xl font-extrabold text-stone-900 dark:text-white">Duolingo English Test (DET)</h3>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-stone-100 dark:bg-zinc-800 text-stone-800 dark:text-stone-200">125+ Target</span>
          </div>
          <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
            Adaptive test format covering C-test reading fills, interactive listening, and camera-ready speaking production subscores.
          </p>
        </div>

      </div>

      <!-- Bottom Nova CTA -->
      <div class="p-8 sm:p-12 rounded-3xl bg-stone-900 text-white dark:bg-zinc-900 border border-stone-800 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-[11px] font-bold text-amber-400 uppercase tracking-widest block mb-1">DIAGNOSTIC SESSION</span>
          <h2 class="text-2xl sm:text-3xl font-bold">Unsure where your current band baseline stands?</h2>
        </div>
        <a
          href="/contact?service=English%20Test%20Training"
          class="px-6 py-3.5 rounded-full text-xs font-bold bg-amber-400 hover:bg-amber-300 text-stone-950 transition-colors flex-shrink-0"
        >
          Book 1-on-1 Diagnostic Call →
        </a>
      </div>

    </div>
  </div>
</Layout>
