---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';

const capabilities = [
  {
    icon: "🎙️",
    title: "Speech AI & Acoustic Modeling",
    desc: "End-to-end speech processing: automatic speech recognition (ASR), speech emotion recognition (SER), audio classification, and Whisper fine-tuning."
  },
  {
    icon: "🧠",
    title: "Custom LLM Fine-Tuning & Quantization",
    desc: "Domain-specific fine-tuning on open-source foundation models (Llama 3, Mistral, Gemma) using LoRA/QLoRA for private local deployment."
  },
  {
    icon: "💬",
    title: "Natural Language Processing (NLP)",
    desc: "Entity extraction (NER), semantic document parsing, sentiment analysis, multilingual translation, and text summarization pipelines."
  },
  {
    icon: "👁️",
    title: "Computer Vision & Medical Imaging",
    desc: "Object detection, image segmentation, biometric feature extraction, and non-invasive health diagnostic classifiers."
  },
  {
    icon: "⚡",
    title: "Low-Latency Model Serving & Inference",
    desc: "Model optimization using ONNX Runtime, TensorRT, vLLM, and quantization (INT8/FP16) to minimize cloud GPU hosting bills."
  },
  {
    icon: "🔬",
    title: "Research-Grade Peer Vetting & Benchmarking",
    desc: "Rigorous empirical evaluation against baseline academic benchmarks, backed by Moazzam's 7 peer-reviewed research publications."
  }
];

const researchHighlights = [
  "Lead author / co-author of 7 published papers in Speech AI and Transformers (Computer Science Review, IEEE OJCS, arXiv).",
  "Specialized in cross-lingual acoustic transfer, foundation audio models, and affective computing in the metaverse.",
  "Deep mathematical mastery of attention mechanisms, acoustic feature representations, and loss landscape optimization."
];

const faqs = [
  {
    q: "Why hire an AI researcher instead of a general developer for AI projects?",
    a: "Generic developers often just query external API wrappers (like OpenAI). As an active researcher with 7 published papers, Moazzam understands underlying neural architectures, embedding vector math, acoustic representations, and fine-tuning nuances, allowing you to train custom proprietary models securely on your own hardware."
  },
  {
    q: "Can you train or deploy AI models on our private, on-premise servers?",
    a: "Yes. For healthcare, legal, or proprietary enterprise clients with strict confidentiality requirements, we deploy open-source models completely air-gapped on private servers, ensuring zero data escapes to third parties."
  },
  {
    q: "What datasets are required for speech AI or fine-tuning projects?",
    a: "We work with existing audio/text corpora or build automated data extraction and synthetic augmentation pipelines to prepare high-quality training pairs."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title={`AI & Machine Learning Development Services | Speech AI & NLP | ${siteData.name}`}
  description="Custom AI development and applied machine learning by published Speech AI researcher Moazzam Shoukat (7 papers). LLM fine-tuning, speech processing, and computer vision."
  schema={faqSchema}
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-400">
          <li>
            <a href="/" class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">Home</a>
          </li>
          <li class="text-slate-400">/</li>
          <li>
            <a href="/services" class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">Services</a>
          </li>
          <li class="text-slate-400">/</li>
          <li class="text-amber-700 dark:text-amber-400 font-semibold">
            AI Development
          </li>
        </ol>
      </nav>

      <!-- Hero Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-[11px] font-bold uppercase tracking-widest mb-4">
          APPLIED AI & MACHINE LEARNING ENGINEERING
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0A1128] dark:text-white tracking-tight leading-[1.1]">
          AI Development. <br />
          <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-200 bg-clip-text text-transparent">Backed by Published Research.</span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Bridge theoretical deep learning with production deployment. Led by Moazzam Shoukat (published researcher with 7 papers in Elsevier Computer Science Review and IEEE on Speech AI, Audio Foundation Models, and Transformers).
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="px-8 py-4 rounded-full bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>Consult on AI Development</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a
            href="https://wa.me/923280484399?text=Hi%20Moazzam%2C%20I%20want%20to%20discuss%20an%20AI%20%2F%20Machine%20Learning%20project."
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>WhatsApp AI Researcher</span>
            <span class="text-xs opacity-90">+92-328-048-4399</span>
          </a>
        </div>
      </div>

      <!-- Trust Stats Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-20">
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 text-center shadow-xs">
          <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400">7 Papers</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-bold mt-1">Elsevier CSR & IEEE</div>
        </div>
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 text-center shadow-xs">
          <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400">PyTorch</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-bold mt-1">Deep Learning Framework</div>
        </div>
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 text-center shadow-xs">
          <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400">Whisper & LLMs</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-bold mt-1">Acoustic & NLP Specialization</div>
        </div>
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 text-center shadow-xs">
          <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400">100% Private</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-bold mt-1">On-Premise Deployment</div>
        </div>
      </div>

      <!-- Capabilities Grid -->
      <div class="mb-24">
        <div class="max-w-2xl mb-12">
          <span class="text-xs uppercase tracking-widest font-black text-amber-700 dark:text-amber-400 block mb-2">INTELLIGENT SYSTEMS</span>
          <h2 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight">AI & ML Capabilities</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {capabilities.map((cap) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs hover:border-amber-400/50 transition-all flex flex-col justify-between">
              <div>
                <div class="text-3xl mb-4">{cap.icon}</div>
                <h3 class="text-xl font-bold text-[#0A1128] dark:text-white mb-2">{cap.title}</h3>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{cap.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Research Foundation Box -->
      <div class="mb-24 p-8 sm:p-12 rounded-3xl bg-[#0A1128] text-white border border-amber-500/20">
        <div class="max-w-2xl mb-6">
          <span class="text-xs uppercase tracking-widest font-black text-amber-400 block mb-2">RESEARCH INTEGRATION</span>
          <h2 class="text-2xl sm:text-3xl font-black text-white">Why Research-Backed Engineering Matters</h2>
        </div>

        <ul class="space-y-3 mb-8 text-xs sm:text-sm text-slate-300">
          {researchHighlights.map((point) => (
            <li class="flex items-start gap-3">
              <span class="text-amber-400 font-bold text-base shrink-0 mt-0.5">✓</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>

        <div class="pt-2">
          <a
            href="/research"
            class="inline-block px-6 py-3 rounded-full bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-bold text-xs transition-all shadow-md"
          >
            Explore All 7 Published Papers &rarr;
          </a>
        </div>
      </div>

      <!-- FAQs -->
      <div class="mb-24">
        <div class="max-w-2xl mb-12">
          <span class="text-xs uppercase tracking-widest font-black text-amber-700 dark:text-amber-400 block mb-2">RESEARCH & ARCHITECTURE</span>
          <h2 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight">Frequently Asked Questions</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {faqs.map((faq) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs space-y-3">
              <h4 class="text-base font-bold text-[#0A1128] dark:text-white">{faq.q}</h4>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Bottom Callout -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h3 class="text-2xl sm:text-3xl font-black text-[#0A1128] dark:text-white tracking-tight">
          Ready to Deploy Custom Machine Learning?
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">
          Book an AI feasibility consultation to discuss dataset availability, model sizing, and latency requirements.
        </p>
        <div class="pt-2 flex justify-center gap-3">
          <a
            href="/contact"
            class="px-8 py-3.5 rounded-full font-bold text-xs bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 transition-colors shadow-md"
          >
            Start AI Discovery Session &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
