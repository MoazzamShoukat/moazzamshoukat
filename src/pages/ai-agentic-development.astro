---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';

const capabilities = [
  {
    icon: "🤖",
    title: "Autonomous Multi-Agent Orchestration",
    desc: "Collaborative agent systems built with LangGraph, CrewAI, and AutoGen where specialized agents communicate, delegate, and execute complex workflows."
  },
  {
    icon: "📚",
    title: "Production RAG & Vector Knowledge Bases",
    desc: "Retrieval-Augmented Generation utilizing vector stores (Pinecone, Qdrant, Chroma) and hybrid search to ground agents in proprietary enterprise docs."
  },
  {
    icon: "🛠️",
    title: "Function & Tool-Calling Workflows",
    desc: "Equipping LLM agents with deterministic API capabilities: querying SQL databases, sending emails, updating CRMs, and running code in sandboxes."
  },
  {
    icon: "🔄",
    title: "Self-Reflecting & Healing Agent Loops",
    desc: "Error detection, plan correction, and automated retry mechanisms that allow agents to inspect their own output and repair parsing failures autonomously."
  },
  {
    icon: "🛡️",
    title: "Human-in-the-Loop & Safety Guardrails",
    desc: "Interactive approval gates, toxic prompt filters, budget limits, and audit logs to ensure enterprise compliance and zero rogue actions."
  },
  {
    icon: "⚡",
    title: "Scalable Background Agent Workflows",
    desc: "Asynchronous task queues (Celery, Redis) and streaming WebSocket interfaces for real-time progress visualization and reactive wakeups."
  }
];

const useCases = [
  {
    title: "Autonomous Research & Market Synthesis",
    desc: "Multi-agent teams crawling competitor pricing, summarizing earnings reports, and generating formatted executive dossiers on autopilot."
  },
  {
    title: "Intelligent Customer Support & Action Takers",
    desc: "AI agents that don't just chat, but verify user identity, query order status in SQL databases, and issue refunds automatically."
  },
  {
    title: "Automated Data Extraction & CRM Syncing",
    desc: "Agents that monitor incoming emails and PDF invoices, extract key financial line items, and update Salesforce/HubSpot without human intervention."
  },
  {
    title: "Autonomous Code Generation & Test Verification",
    desc: "Agents that write API endpoints, generate unit tests, execute them in sandboxed Docker containers, and fix bugs until all tests pass."
  }
];

const faqs = [
  {
    q: "What is the difference between a traditional chatbot and an AI Agent?",
    a: "A traditional chatbot simply answers questions based on its training. An AI Agent possesses agency: it is given goals, evaluates tool choices, calls real-world APIs, queries databases, observes the results, and loops until the multi-step goal is successfully achieved."
  },
  {
    q: "Which agent frameworks do you use?",
    a: "We architect production agents using LangChain, LangGraph (for stateful graphs and multi-agent coordination), CrewAI, AutoGen, and native OpenAI/Anthropic/Gemini function calling with custom Python middleware."
  },
  {
    q: "How do you prevent agents from hallucinating or going into infinite loops?",
    a: "We implement deterministic state machines, strictly constrained JSON schema validation, maximum step counters, vector-backed RAG verification, and mandatory human-in-the-loop approval gates for sensitive actions."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title={`AI Agentic Development | Autonomous Multi-Agent Systems & RAG | ${siteData.name}`}
  description="Enterprise autonomous AI agents, multi-agent orchestration (LangGraph, CrewAI), tool-calling workflows, and RAG systems built by Moazzam Shoukat."
  schema={faqSchema}
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-400">
          <li>
            <a href="/" class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">Home</a>
          </li>
          <li class="text-slate-400">/</li>
          <li>
            <a href="/services" class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">Services</a>
          </li>
          <li class="text-slate-400">/</li>
          <li class="text-amber-700 dark:text-amber-400 font-semibold">
            AI Agentic Development
          </li>
        </ol>
      </nav>

      <!-- Hero Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-[11px] font-bold uppercase tracking-widest mb-4">
          AUTONOMOUS AI & WORKFLOW ORCHESTRATION
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0A1128] dark:text-white tracking-tight leading-[1.1]">
          AI Agentic Development. <br />
          <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-200 bg-clip-text text-transparent">Agents That Take Real Actions.</span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Move beyond static conversational bots. We build autonomous multi-agent systems, tool-calling automations, and enterprise RAG pipelines that execute complex business workflows with zero human micro-management.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="px-8 py-4 rounded-full bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>Discuss Agentic Architecture</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a
            href="https://wa.me/923280484399?text=Hi%20Moazzam%2C%20I%20want%20to%20build%20an%20autonomous%20AI%20agent%20system."
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>WhatsApp Agent Architect</span>
            <span class="text-xs opacity-90">+92-328-048-4399</span>
          </a>
        </div>
      </div>

      <!-- Trust Stats Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-20">
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 text-center shadow-xs">
          <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400">LangGraph</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-bold mt-1">Multi-Agent State Machine</div>
        </div>
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 text-center shadow-xs">
          <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400">Zero Hallucination</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-bold mt-1">Vector RAG Grounding</div>
        </div>
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 text-center shadow-xs">
          <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400">100% Audit</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-bold mt-1">Deterministic Tool Calls</div>
        </div>
        <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 text-center shadow-xs">
          <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400">Enterprise</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-bold mt-1">Human-in-the-Loop Safety</div>
        </div>
      </div>

      <!-- Capabilities Grid -->
      <div class="mb-24">
        <div class="max-w-2xl mb-12">
          <span class="text-xs uppercase tracking-widest font-black text-amber-700 dark:text-amber-400 block mb-2">AGENTIC ARCHITECTURE</span>
          <h2 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight">Core Agent Capabilities</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {capabilities.map((cap) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs hover:border-amber-400/50 transition-all flex flex-col justify-between">
              <div>
                <div class="text-3xl mb-4">{cap.icon}</div>
                <h3 class="text-xl font-bold text-[#0A1128] dark:text-white mb-2">{cap.title}</h3>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{cap.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Real-World Enterprise Use Cases -->
      <div class="mb-24 p-8 sm:p-12 rounded-3xl bg-[#0A1128] text-white border border-amber-500/20">
        <div class="max-w-2xl mb-10">
          <span class="text-xs uppercase tracking-widest font-black text-amber-400 block mb-2">HIGH-VALUE USE CASES</span>
          <h2 class="text-2xl sm:text-3xl font-black text-white">How Businesses Deploy Our AI Agents</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {useCases.map((uc) => (
            <div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2">
              <h4 class="text-base font-bold text-amber-300">{uc.title}</h4>
              <p class="text-xs text-slate-300 leading-relaxed">{uc.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- FAQs -->
      <div class="mb-24">
        <div class="max-w-2xl mb-12">
          <span class="text-xs uppercase tracking-widest font-black text-amber-700 dark:text-amber-400 block mb-2">CLARITY & FEASIBILITY</span>
          <h2 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight">Frequently Asked Questions</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {faqs.map((faq) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs space-y-3">
              <h4 class="text-base font-bold text-[#0A1128] dark:text-white">{faq.q}</h4>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Bottom Callout -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h3 class="text-2xl sm:text-3xl font-black text-[#0A1128] dark:text-white tracking-tight">
          Ready to Automate Complex Workflows with AI Agents?
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">
          Schedule an architectural planning session to explore autonomous multi-agent workflows tailored to your operational stack.
        </p>
        <div class="pt-2 flex justify-center gap-3">
          <a
            href="/contact"
            class="px-8 py-3.5 rounded-full font-bold text-xs bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 transition-colors shadow-md"
          >
            Start Agentic Consultation &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
