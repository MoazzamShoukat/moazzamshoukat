---

<Layout
  title={`Services & Practice Areas | PTE, IELTS, Australia PR & AI Engineering | ${siteData.name}`}
  description="Explore professional services by Moazzam Shoukat: PTE Coaching (Lahore & Online), IELTS 7.5+, NAATI CCL Urdu, Australian Skilled Migration (189/190/491), Data Engineering, and AI Research."
  keywords="PTE Trainer in Lahore, Online PTE Classes, IELTS Trainer Lahore, NAATI CCL Urdu Preparation, Australia Skilled Migration, Skills Assessment Australia, Data Engineering Services, AI Researcher"
  schema={breadcrumbSchema}
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Badge & Page Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-[11px] font-bold uppercase tracking-widest mb-4">
          SOLUTIONS & DEDICATED TRACKS
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0A1128] dark:text-white tracking-tight leading-[1.1]">
          Dual Mastery. <br />
          <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-200 bg-clip-text text-transparent">Immigration Advisory & Technical Engineering.</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
          High-yield global immigration and language test coaching for ambitious individuals, paired with enterprise-grade software engineering, data pipelines, and autonomous AI systems for forward-thinking organizations.
        </p>
      </div>

      <!-- SECTION 1: Immigration & Language Portals -->
      <div class="mb-24">
        <div class="flex items-center gap-3 mb-8">
          <span class="text-xs font-black uppercase tracking-widest text-amber-700 dark:text-amber-400">01 / IMMIGRATION & LANGUAGE PRACTICE AREAS</span>
          <div class="h-px flex-grow bg-slate-200 dark:bg-slate-800"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {immigrationPages.map((page) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 hover:border-amber-400/50 shadow-xs transition-all flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between mb-3 text-xs">
                  <span class="text-2xl">{page.icon}</span>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20">
                    {page.tag}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-[#0A1128] dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors mb-1">
                  {page.title}
                </h3>
                <div class="text-xs font-semibold text-amber-600 dark:text-amber-400 mb-3">
                  {page.subtitle}
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
                  {page.desc}
                </p>
              </div>

              <a
                href={page.href}
                class="inline-flex items-center gap-2 text-xs font-bold text-[#0A1128] dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors pt-4 border-t border-slate-100 dark:border-slate-800"
              >
                <span>Explore Track Details</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- SECTION 2: Technical & AI Engineering -->
      <div class="mb-24">
        <div class="flex items-center gap-3 mb-8">
          <span class="text-xs font-black uppercase tracking-widest text-amber-700 dark:text-amber-400">02 / TECHNOLOGY & AI ENGINEERING SERVICES</span>
          <div class="h-px flex-grow bg-slate-200 dark:bg-slate-800"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {technicalPages.map((page) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 hover:border-amber-400/50 shadow-xs transition-all flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between mb-3 text-xs">
                  <span class="text-2xl">{page.icon}</span>
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20">
                    {page.tag}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-[#0A1128] dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors mb-1">
                  {page.title}
                </h3>
                <div class="text-xs font-semibold text-amber-600 dark:text-amber-400 mb-3">
                  {page.subtitle}
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
                  {page.desc}
                </p>

                <div class="space-y-1.5 mb-6 pt-4 border-t border-slate-100 dark:border-slate-800">
                  {page.features.map((f) => (
                    <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
                      <span class="text-amber-500 text-[10px]">✔</span>
                      <span>{f}</span>
                    </div>
                  ))}
                </div>
              </div>

              <a
                href={page.href}
                class="inline-flex items-center gap-2 text-xs font-bold text-[#0A1128] dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors pt-4 border-t border-slate-100 dark:border-slate-800"
              >
                <span>View Engineering Specs</span>
                <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- Bottom Advisory Banner -->
      <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-[#0A1128] to-[#1E293B] text-white border border-amber-500/20 flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="max-w-xl">
          <h2 class="text-2xl sm:text-3xl font-black mb-2">
            Not Sure Which Pathway Fits Your Profile?
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Schedule an initial profile assessment to audit your points for Australia PR, choose between IELTS vs PTE Academic, or discuss custom software requirements.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a
            href="/contact/"
            class="px-8 py-4 rounded-full bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-xs uppercase tracking-wider transition-all shadow-lg"
          >
            Book Free Assessment &rarr;
          </a>
          <a
            href="/pricing/"
            class="px-8 py-4 rounded-full bg-white/10 hover:bg-white/20 text-white font-bold text-xs uppercase tracking-wider transition-all border border-white/20"
          >
            Transparent Pricing
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
