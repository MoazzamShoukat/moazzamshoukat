---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Preparation Portals | Moazzam Shoukat"
  description="Comprehensive preparation modules for NAATI CCL Urdu, PTE Academic, PTE Core, and IELTS. Access interactive vocabulary banks and practice portals."
>
  <div class="py-12 md:py-20 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-8 font-medium" aria-label="Breadcrumb">
      <a href="/" class="hover:text-amber-600 transition-colors">Home</a>
      <span>/</span>
      <span class="text-amber-600 dark:text-amber-400 font-bold">Preparation Portals</span>
    </nav>

    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black tracking-wider uppercase bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 mb-4">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        Exam Practice Suites
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight mb-4">
        Exam <span class="text-amber-600 dark:text-amber-400">Preparation Portals</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
        High-yield study tools, bilingual vocabulary banks, and exam-standard test simulators designed to secure maximum scores for Australian and Canadian PR points.
      </p>
    </div>

    <!-- Featured Live Card: NAATI CCL Vocabulary -->
    <div class="mb-12 rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-[#0A1128] via-[#0E1A3D] to-[#0A1128] text-white border-2 border-amber-500/30 shadow-2xl relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-400 text-slate-950">
            Featured &bull; Active Interactive Tool
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight">
            NAATI CCL Urdu Vocabulary Bank
          </h2>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-2xl">
            Explore 7,796+ high-frequency examination terms with accurate Urdu meanings (<span dir="rtl" class="font-bold text-amber-300">اردو ترجمہ</span>), community domain tags, and three real bilingual dialogue contexts per entry. Includes Levenshtein fuzzy matching and daily rate-limiting.
          </p>
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <span class="text-xs px-2.5 py-1 rounded-lg bg-white/10 text-slate-300 border border-white/15">
              7,796 Vocabulary Items
            </span>
            <span class="text-xs px-2.5 py-1 rounded-lg bg-white/10 text-slate-300 border border-white/15">
              Bilingual Dialogue Examples
            </span>
            <span class="text-xs px-2.5 py-1 rounded-lg bg-white/10 text-slate-300 border border-white/15">
              +5 Australia PR Points
            </span>
          </div>
        </div>

        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-center">
          <a
            href="/preparation/naati/vocabulary/"
            class="px-6 py-3.5 rounded-2xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-xs sm:text-sm text-center transition-all shadow-xl hover:shadow-amber-400/20 flex items-center justify-center gap-2"
          >
            <span>Launch Vocabulary Search</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a
            href="/naati-ccl-urdu-preparation/"
            class="px-6 py-3.5 rounded-2xl bg-white/10 hover:bg-white/15 text-white font-bold text-xs sm:text-sm text-center border border-white/20 transition-all"
          >
            View NAATI CCL Course Details
          </a>
        </div>
      </div>
    </div>

    <!-- Preparation Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- NAATI CCL Section -->
      <div class="p-6 rounded-3xl bg-white dark:bg-[#0C1324] border border-slate-200 dark:border-white/10 shadow-lg space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-black uppercase tracking-wider text-amber-600 dark:text-amber-400">
            Community Language
          </span>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-amber-500/10 text-amber-700 dark:text-amber-300">
            +5 Points
          </span>
        </div>
        <h3 class="text-lg font-black text-slate-900 dark:text-white">
          NAATI CCL Urdu
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Comprehensive preparation suite for Pakistani community language candidates targeting credentialed community language certification.
        </p>
        <div class="pt-2 space-y-2 border-t border-slate-100 dark:border-white/5">
          <a href="/preparation/naati/vocabulary/" class="flex items-center justify-between text-xs font-bold text-amber-700 dark:text-amber-400 hover:underline">
            <span>&bull; Vocabulary Bank (7,796 terms)</span>
            <span class="text-[9px] px-1.5 py-0.2 rounded bg-amber-500/20">Active</span>
          </a>
          <a href="/preparation/naati/dialogues/" class="flex items-center justify-between text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-800">
            <span>&bull; Dialogue Scenarios</span>
            <span class="text-[9px] px-1.5 py-0.2 rounded bg-slate-100 dark:bg-slate-800">Coming Soon</span>
          </a>
          <a href="/preparation/naati/practice-tests/" class="flex items-center justify-between text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-800">
            <span>&bull; Timed Mock Tests</span>
            <span class="text-[9px] px-1.5 py-0.2 rounded bg-slate-100 dark:bg-slate-800">Coming Soon</span>
          </a>
        </div>
      </div>

      <!-- PTE Academic Section -->
      <div class="p-6 rounded-3xl bg-white dark:bg-[#0C1324] border border-slate-200 dark:border-white/10 shadow-lg space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-black uppercase tracking-wider text-amber-600 dark:text-amber-400">
            Computer-Delivered
          </span>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
            79+ / Band 8
          </span>
        </div>
        <h3 class="text-lg font-black text-slate-900 dark:text-white">
          PTE Academic / UKVI
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Four communicative skill modules engineered with tested AI speech templates and predictive scoring algorithms.
        </p>
        <div class="pt-2 space-y-2 border-t border-slate-100 dark:border-white/5 text-xs text-slate-600 dark:text-slate-400 font-medium">
          <div>&bull; Speaking (Read Aloud, Repeat Sentence, Describe Image)</div>
          <div>&bull; Writing (Summarize Written Text & Essay)</div>
          <div>&bull; Reading (FIB & Re-order Paragraphs)</div>
          <div>&bull; Listening (SST & Write from Dictation)</div>
        </div>
      </div>

      <!-- Other Tests Section -->
      <div class="p-6 rounded-3xl bg-white dark:bg-[#0C1324] border border-slate-200 dark:border-white/10 shadow-lg space-y-4">
        <div class="flex items-center justify-between">
          <span class="text-xs font-black uppercase tracking-wider text-amber-600 dark:text-amber-400">
            Migration & Study
          </span>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
            Global
          </span>
        </div>
        <h3 class="text-lg font-black text-slate-900 dark:text-white">
          PTE Core, IELTS & DET
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Standardized English testing benchmarks for Canada Express Entry (CLB 9/10), Australia migration, and university admissions.
        </p>
        <div class="pt-2 space-y-2 border-t border-slate-100 dark:border-white/5 text-xs text-slate-600 dark:text-slate-400 font-medium">
          <div>&bull; PTE Core for Canadian PR</div>
          <div>&bull; IELTS Academic & General Training</div>
          <div>&bull; Duolingo English Test (DET)</div>
          <div>&bull; CELPIP General</div>
        </div>
      </div>

    </div>

  </div>
</Layout>