---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="NAATI CCL Urdu Mock Practice Tests | Moazzam Shoukat"
  description="Full-length timed NAATI CCL Urdu mock exams with realistic chime delays, segment interpreting, and deduction analysis. Simulation platform launching soon."
>
  <div class="py-16 md:py-24 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-8 font-medium" aria-label="Breadcrumb">
      <a href="/" class="hover:text-amber-600 transition-colors">Home</a>
      <span>/</span>
      <a href="/preparation/naati/vocabulary/" class="hover:text-amber-600 transition-colors">Preparation</a>
      <span>/</span>
      <span class="text-amber-600 dark:text-amber-400 font-bold">NAATI CCL Practice Tests</span>
    </nav>

    <!-- Header Card -->
    <div class="relative overflow-hidden rounded-3xl p-8 sm:p-12 bg-gradient-to-br from-[#0A1128] via-[#0E1B40] to-[#0A1128] text-white border border-amber-500/20 shadow-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-black tracking-wider uppercase bg-amber-400/10 text-amber-300 border border-amber-400/20 mb-6">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        Timed Exam Simulator Coming Soon
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white mb-4">
        NAATI CCL Urdu <span class="text-amber-400">Mock Tests</span>
      </h1>
      
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-2xl mb-8">
        Full 2-dialogue mock test simulations under strict NAATI timing rules. Practice taking notes, handling repeats/corrections under the allowable limit, and avoiding distortion or omission errors.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href="/preparation/naati/vocabulary/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs font-black bg-amber-400 hover:bg-amber-300 text-slate-950 transition-all shadow-lg hover:shadow-amber-400/20"
        >
          <span>Practice Vocabulary Bank</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>

        <a
          href="/contact/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs font-bold bg-white/10 hover:bg-white/15 text-white border border-white/20 transition-all"
        >
          <span>Schedule Live Mock Evaluation</span>
        </a>
      </div>
    </div>
  </div>
</Layout>