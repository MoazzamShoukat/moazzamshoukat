---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';
---

<Layout
  title={`Professional Experience | Moazzam Shoukat`}
  description="Career track of Moazzam Shoukat: Software Engineer at Emulation AI, Data Engineer at Ibtidah Solutions, and independent technical/immigration consultant."
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-[11px] font-bold uppercase tracking-widest mb-4">
          CAREER TRACK & INDUSTRY EXPERIENCE
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0A1128] dark:text-white tracking-tight leading-[1.1]">
          Professional <br />
          <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-200 bg-clip-text text-transparent">Experience.</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
          6+ years engineering enterprise data pipelines, distributed web scraping systems, and backend platforms, alongside high-impact independent immigration advisory.
        </p>
      </div>

      <!-- Experience Cards Timeline -->
      <div class="max-w-4xl space-y-10 mb-20">
        {siteData.experiences.map((exp, idx) => (
          <div class="p-8 sm:p-10 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-sm space-y-6 hover:border-amber-400/40 transition-all">
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-5">
              <div>
                <span class="text-[11px] font-black uppercase tracking-widest text-amber-700 dark:text-amber-400">
                  ROLE 0{idx + 1} &bull; {exp.type}
                </span>
                <h2 class="text-2xl sm:text-3xl font-black text-[#0A1128] dark:text-white mt-1">
                  {exp.role}
                </h2>
                <div class="text-xs sm:text-sm font-bold text-slate-700 dark:text-slate-300 mt-1">
                  {exp.company} &bull; {exp.location}
                </div>
              </div>
              <div class="text-xs font-bold px-3.5 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 self-start sm:self-auto border border-slate-200 dark:border-slate-700">
                {exp.period}
              </div>
            </div>

            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed font-medium">
              {exp.description}
            </p>

            <div class="space-y-3">
              <span class="text-xs font-black uppercase tracking-wider text-slate-400 block">Key Responsibilities & Deliverables:</span>
              <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
                {exp.responsibilities.map((resp) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-4 h-4 text-amber-600 dark:text-amber-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="leading-relaxed">{resp}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Tech Badges -->
            <div class="pt-5 border-t border-slate-100 dark:border-slate-800 flex flex-wrap gap-2">
              {exp.technologies.map((tech) => (
                <span class="px-3 py-1 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
                  {tech}
                </span>
              ))}
            </div>

          </div>
        ))}

        <!-- Independent Practice Card -->
        <div class="p-8 sm:p-10 rounded-3xl bg-amber-500/5 dark:bg-amber-500/10 border border-amber-500/30 space-y-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-amber-500/20 pb-5">
            <div>
              <span class="text-[11px] font-black uppercase tracking-widest text-amber-700 dark:text-amber-400">
                PRACTICE 03 &bull; INDEPENDENT ADVISORY
              </span>
              <h2 class="text-2xl sm:text-3xl font-black text-[#0A1128] dark:text-white mt-1">
                Canada & Australia PR Strategist & Language Mentor
              </h2>
              <div class="text-xs sm:text-sm font-bold text-slate-700 dark:text-slate-300 mt-1">
                Direct Global Consultations & 1-on-1 Coaching
              </div>
            </div>
            <div class="text-xs font-bold px-3.5 py-1.5 rounded-full bg-amber-500/20 text-amber-900 dark:text-amber-300 self-start sm:self-auto border border-amber-500/30">
              2018 – Present
            </div>
          </div>

          <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
            Strategic advisory managing Canada Express Entry (STEM Priority Draws, CRS optimization, Provincial Nominee Programs), Australian GSM (Subclass 189, 190, 491), Skills Assessment files (ACS, Engineers Australia CDR, VETASSESS), and intensive IELTS / PTE / NAATI CCL Urdu coaching.
          </p>

          <div class="pt-2 flex flex-wrap gap-4">
            <a href="/australia-skilled-migration/" class="text-xs font-bold text-amber-700 dark:text-amber-400 hover:underline">
              Australia Skilled Migration &rarr;
            </a>
            <a href="/online-pte-classes/" class="text-xs font-bold text-amber-700 dark:text-amber-400 hover:underline">
              Online PTE Classes &rarr;
            </a>
            <a href="/success-stories/" class="text-xs font-bold text-amber-700 dark:text-amber-400 hover:underline">
              Student Results & Grants &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom CTA Banner -->
      <div class="p-8 sm:p-12 rounded-3xl bg-[#0A1128] text-white border border-amber-500/20 flex flex-col md:flex-row items-center justify-between gap-6 max-w-4xl">
        <div>
          <span class="text-[11px] font-bold text-amber-400 uppercase tracking-widest block mb-1">ENGINEERING & CONSULTING</span>
          <h2 class="text-2xl sm:text-3xl font-bold">Have an engineering role or technical project?</h2>
          <p class="text-xs text-slate-300 mt-1">Available for distributed web crawling, PostgreSQL data warehousing, and API design.</p>
        </div>
        <a
          href="/contact/"
          class="px-6 py-3.5 rounded-full text-xs font-bold bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 transition-colors shadow-md shrink-0"
        >
          Discuss Opportunities &rarr;
        </a>
      </div>

    </div>
  </div>
</Layout>
