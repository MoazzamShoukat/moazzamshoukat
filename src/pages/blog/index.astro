---
import Layout from '../../layouts/Layout.astro';
import { blogPosts } from '../../data/blogData';

const categories = ["All", "AI & Research", "IELTS", "PTE", "Immigration", "Student Visa", "NAATI CCL", "Skills Assessment", "Study Abroad"];
---

<Layout
  title="Blog & Strategy Guides (35 Articles) | IELTS, PTE, Immigration & AI Research | Moazzam Shoukat"
  description="Explore 35 in-depth guides covering IELTS 7.5+, PTE 79+ Superior English, NAATI CCL Urdu, Canada Express Entry, Australia GSM Visas, and Speech AI Research by Moazzam Shoukat."
  keywords="IELTS trainer Lahore, PTE coaching Pakistan, Canada immigration consultant, Australia skills assessment, NAATI CCL Urdu trainer, Student visa consultant Pakistan, AI speech research"
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Badge & Page Header -->
      <div class="max-w-3xl mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-[11px] font-bold uppercase tracking-widest mb-4">
          AUTHORITATIVE GUIDES & RESEARCH ARTICLES ({blogPosts.length} POSTS)
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0A1128] dark:text-white tracking-tight leading-[1.1]">
          Articles & Insights. <br />
          <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-200 bg-clip-text text-transparent">AI Technology & Global Mobility.</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Deep dives into speech transformers, large audio foundation models, acoustic healthcare biomarkers, language test scoring rubrics (IELTS & PTE), and international immigration frameworks for Canada and Australia.
        </p>
      </div>

      <!-- Category Filter Buttons -->
      <div class="mb-12 flex flex-wrap gap-2">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-filter={cat}
            class={`blog-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all cursor-pointer ${
              idx === 0
                ? "bg-[#0A1128] text-white dark:bg-amber-400 dark:text-slate-950 shadow-sm active-blog-filter"
                : "bg-white dark:bg-[#111827] text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:border-amber-400"
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Blog Grid (Showing All 35 Posts) -->
      <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-24">
        {blogPosts.map((post) => (
          <article
            data-category={post.category}
            class="blog-card p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs flex flex-col justify-between hover:border-amber-400/60 hover:shadow-lg transition-all group"
          >
            <div>
              <div class="flex items-center justify-between text-xs text-slate-400 mb-4">
                <span class="px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20">
                  {post.category}
                </span>
                <span>{post.readTime}</span>
              </div>

              <h2 class="text-xl font-bold text-[#0A1128] dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors leading-snug">
                <a href={`/blog/${post.slug}`}>
                  {post.title}
                </a>
              </h2>

              <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 line-clamp-3 leading-relaxed">
                {post.excerpt}
              </p>
            </div>

            <div class="pt-6 mt-6 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
              <span class="text-xs text-slate-400">{post.publishDate}</span>
              <a
                href={`/blog/${post.slug}`}
                class="inline-flex items-center gap-1 text-xs font-bold text-amber-700 dark:text-amber-400 group-hover:translate-x-1 transition-transform"
              >
                <span>Read Full Guide</span>
                <span>&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Newsletter & Consultation CTA Card -->
      <div class="rounded-3xl bg-gradient-to-r from-[#0A1128] to-[#1E293B] text-white p-8 sm:p-12 border border-amber-500/20 text-center space-y-4">
        <h3 class="text-2xl sm:text-3xl font-black">
          Looking for Personalized Diagnostic Guidance?
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 max-w-xl mx-auto leading-relaxed">
          Whether you need a full evaluation for Canada Express Entry, Australian GSM points calculation, or 1-on-1 diagnostic coaching for IELTS / PTE / NAATI CCL, schedule your consultation today.
        </p>
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/contact"
            class="px-8 py-3.5 rounded-full font-bold text-xs bg-amber-400 hover:bg-amber-300 text-slate-950 transition-colors shadow-md"
          >
            Book Free Diagnostic Call &rarr;
          </a>
          <a
            href="https://wa.me/923280484399?text=Hi%20Moazzam%2C%20I%20read%20your%20blog%20and%20would%20like%20guidance"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 rounded-full font-bold text-xs border border-white/20 hover:bg-white/10 text-white transition-colors"
          >
            WhatsApp +92-328-048-4399
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>

<script>
  function setupFilters() {
    const buttons = document.querySelectorAll('.blog-filter-btn');
    const cards = document.querySelectorAll('.blog-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Toggle active button styles
        buttons.forEach((b) => {
          b.classList.remove('bg-[#0A1128]', 'text-white', 'dark:bg-amber-400', 'dark:text-slate-950', 'shadow-sm', 'active-blog-filter');
          b.classList.add('bg-white', 'dark:bg-[#111827]', 'text-slate-700', 'dark:text-slate-300', 'border', 'border-slate-200', 'dark:border-slate-800');
        });
        btn.classList.remove('bg-white', 'dark:bg-[#111827]', 'text-slate-700', 'dark:text-slate-300', 'border', 'border-slate-200', 'dark:border-slate-800');
        btn.classList.add('bg-[#0A1128]', 'text-white', 'dark:bg-amber-400', 'dark:text-slate-950', 'shadow-sm', 'active-blog-filter');

        // Filter cards
        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'All' || category === filter) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  setupFilters();
  document.addEventListener('astro:after-swap', setupFilters);
</script>
