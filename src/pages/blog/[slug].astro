---
import Layout from '../../layouts/Layout.astro';
import { blogPosts, type BlogPost } from '../../data/blogData';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// Compute related posts from same category or complementary guides
const relatedPosts = blogPosts
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => (a.category === post.category ? -1 : 1))
  .slice(0, 3);

// Structured Data for Google Article / BlogPosting
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.metaDescription,
  "datePublished": post.publishDate,
  "author": {
    "@type": "Person",
    "name": post.author,
    "url": "https://moazzamshoukat.com/about"
  },
  "publisher": {
    "@type": "Person",
    "name": "Moazzam Shoukat",
    "url": "https://moazzamshoukat.com"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://moazzamshoukat.com/blog/${post.slug}`
  }
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://moazzamshoukat.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Knowledge Hub",
      "item": "https://moazzamshoukat.com/blog"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.title,
      "item": `https://moazzamshoukat.com/blog/${post.slug}`
    }
  ]
};
---

<Layout
  title={post.metaTitle}
  description={post.metaDescription}
  schema={[articleSchema, breadcrumbSchema]}
>
  <div class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-400">
          <li>
            <a href="/" class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">Home</a>
          </li>
          <li class="text-slate-400">/</li>
          <li>
            <a href="/blog" class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">Guides & Articles</a>
          </li>
          <li class="text-slate-400">/</li>
          <li class="text-amber-700 dark:text-amber-400 font-semibold truncate max-w-xs sm:max-w-md">
            {post.category}
          </li>
        </ol>
      </nav>

      <!-- Category & Read Time -->
      <div class="flex items-center justify-between mb-6 text-xs">
        <div class="flex items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20 text-[10px]">
            {post.category}
          </span>
          <span class="text-slate-400">&bull;</span>
          <span class="text-slate-500 dark:text-slate-400">{post.readTime}</span>
        </div>
        <a
          href="/blog"
          class="font-bold text-slate-500 hover:text-amber-700 dark:hover:text-amber-400 transition-colors"
        >
          &larr; All Guides
        </a>
      </div>

      <!-- Article Header -->
      <header class="mb-10">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#0A1128] dark:text-white tracking-tight leading-[1.15]">
          {post.title}
        </h1>
        <div class="mt-4 flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
          <span>By <strong class="text-slate-800 dark:text-slate-200">{post.author}</strong></span>
          <span>&bull;</span>
          <span>Published on {post.publishDate}</span>
          <span>&bull;</span>
          <span>Verified Strategy</span>
        </div>
      </header>

      <!-- Key Takeaways Box (Deep Navy & Champagne Gold) -->
      <div class="p-6 sm:p-8 rounded-3xl bg-amber-500/5 dark:bg-amber-500/10 border border-amber-500/30 mb-12">
        <div class="text-xs font-black uppercase tracking-widest text-amber-700 dark:text-amber-400 mb-3 flex items-center gap-2">
          <span>📌</span> Key Strategic Takeaways
        </div>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
          {post.keyTakeaways.map((item) => (
            <li class="flex items-start gap-2.5">
              <span class="text-amber-600 dark:text-amber-400 font-bold shrink-0 mt-0.5">&bull;</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Article Sections -->
      <article class="space-y-10 text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
        {post.sections.map((section) => (
          <div class="space-y-4">
            <h2 class="text-2xl sm:text-3xl font-black text-[#0A1128] dark:text-white tracking-tight pt-2">
              {section.heading}
            </h2>
            {section.paragraphs.map((p) => (
              <p class="text-slate-600 dark:text-slate-300 leading-relaxed" set:html={p} />
            ))}
          </div>
        ))}

        <!-- Optional Comparative Table -->
        {post.table && (
          <div class="my-8 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111827] shadow-xs">
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse text-xs sm:text-sm">
                <thead>
                  <tr class="bg-slate-100 dark:bg-slate-800/80 border-b border-slate-200 dark:border-slate-700 text-[#0A1128] dark:text-white font-bold">
                    {post.table.headers.map((h) => (
                      <th class="p-3.5 sm:p-4">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
                  {post.table.rows.map((row) => (
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
                      {row.map((cell, idx) => (
                        <td class={`p-3.5 sm:p-4 ${idx === 0 ? "font-bold text-[#0A1128] dark:text-white" : ""}`} set:html={cell} />
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        <!-- Optional Strategy Checklist -->
        {post.checklist && post.checklist.length > 0 && (
          <div class="my-8 p-6 sm:p-8 rounded-3xl bg-slate-50 dark:bg-[#111827] border border-slate-200 dark:border-slate-800">
            <h3 class="text-base sm:text-lg font-bold text-[#0A1128] dark:text-white mb-4 flex items-center gap-2">
              <span class="text-amber-600 dark:text-amber-400">✓</span> Step-by-Step Execution Checklist
            </h3>
            <ul class="space-y-3 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
              {post.checklist.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Optional Structured FAQs Section -->
        {post.faqs && post.faqs.length > 0 && (
          <div class="my-10 space-y-4">
            <h3 class="text-2xl font-black text-[#0A1128] dark:text-white tracking-tight">
              Frequently Asked Questions
            </h3>
            <div class="space-y-3">
              {post.faqs.map((faq) => (
                <div class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs space-y-2">
                  <h4 class="text-sm sm:text-base font-bold text-[#0A1128] dark:text-white">
                    {faq.question}
                  </h4>
                  <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed" set:html={faq.answer} />
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Conclusion Callout -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs space-y-3 mt-12">
          <h3 class="text-lg font-black text-[#0A1128] dark:text-white">
            Conclusion & Next Steps
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            {post.conclusion}
          </p>
        </div>
      </article>

      <!-- Author Bio & Consultation Callout -->
      <div class="mt-16 p-8 sm:p-10 rounded-3xl bg-[#0A1128] text-white border border-amber-500/20 flex flex-col sm:flex-row items-center gap-6">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#0A1128] to-[#1E293B] text-amber-400 flex items-center justify-center text-2xl font-black shrink-0 border border-amber-500/40">
          MS
        </div>
        <div class="space-y-2 flex-1 text-center sm:text-left">
          <h4 class="text-lg font-bold text-white">About the Author: Moazzam Shoukat</h4>
          <p class="text-xs text-slate-300 leading-relaxed">
            AI Researcher, Senior Software Engineer, and Canada & Australia immigration strategist based in Lahore. Mentoring professionals and students worldwide to achieve top language scores and secure permanent residency.
          </p>
          <div class="pt-2 flex flex-wrap justify-center sm:justify-start gap-3">
            <a
              href="/contact"
              class="px-5 py-2.5 rounded-full bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-bold text-xs transition-all shadow-md"
            >
              Book Free Consultation
            </a>
            <a
              href={"https://wa.me/923280484399?text=" + encodeURIComponent("Hello Moazzam, I just read your article: " + post.title)}
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-2.5 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-xs transition-all shadow-md"
            >
              WhatsApp Moazzam
            </a>
          </div>
        </div>
      </div>

      <!-- Related Guides & Roadmaps Section -->
      <div class="mt-16 pt-12 border-t border-slate-200 dark:border-slate-800">
        <div class="flex items-center justify-between mb-8">
          <div>
            <span class="text-[11px] font-extrabold uppercase tracking-widest text-amber-700 dark:text-amber-400">
              RELATED KNOWLEDGE GUIDES
            </span>
            <h3 class="text-2xl font-black text-[#0A1128] dark:text-white mt-1">
              Continue Reading & Planning
            </h3>
          </div>
          <a href="/blog" class="text-xs font-bold text-amber-700 dark:text-amber-400 hover:underline">
            All 35 Articles &rarr;
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedPosts.map((rel) => (
            <article class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 flex flex-col justify-between hover:border-amber-400/60 shadow-xs transition-all group">
              <div>
                <div class="flex items-center justify-between text-[11px] text-slate-400 mb-3">
                  <span class="px-2 py-0.5 rounded-full font-bold uppercase bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20 text-[9px]">
                    {rel.category}
                  </span>
                  <span>{rel.readTime}</span>
                </div>
                <h4 class="text-sm font-bold text-[#0A1128] dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors leading-snug line-clamp-2">
                  <a href={`/blog/${rel.slug}`}>{rel.title}</a>
                </h4>
                <p class="mt-2 text-xs text-slate-500 dark:text-slate-400 line-clamp-2">
                  {rel.excerpt}
                </p>
              </div>

              <div class="pt-4 mt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
                <span class="text-[11px] text-slate-400">{rel.publishDate}</span>
                <a
                  href={`/blog/${rel.slug}`}
                  class="font-bold text-amber-700 dark:text-amber-400 inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
                >
                  <span>Read</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>

    </div>
  </div>
</Layout>
