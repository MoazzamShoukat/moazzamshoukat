---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';

const subpages = [
  {
    href: '/canada-immigration',
    flag: '🍁',
    title: 'Canada Immigration / PR',
    subtitle: 'Express Entry & Provincial Nominee Programs',
    desc: 'Targeted category draws prioritizing STEM talent, Comprehensive Ranking System (CRS) optimization, and Provincial Nominee (PNP) strategies.',
    stat: '95+ PR Visas'
  },
  {
    href: '/australia-immigration',
    flag: '🦘',
    title: 'Australia Immigration / PR',
    subtitle: 'GSM Subclass 189, 190 & 491',
    desc: 'SkillSelect Expression of Interest (EOI) ranking, state nomination selection across VIC/NSW/SA/WA, and points test engineering.',
    stat: '85+ PR Grants'
  },
  {
    href: '/student-visa',
    flag: '🎓',
    title: 'Student Visa & Admissions',
    subtitle: 'Genuine Student (GS) Statements',
    desc: 'Strategic university selection aligned with future post-study work and PR opportunities in Canada & Australia.',
    stat: '97% Approval'
  },
  {
    href: '/skills-assessment-australia',
    flag: '📊',
    title: 'Skills Assessment Australia',
    subtitle: 'ACS, Engineers Australia CDR & VETASSESS',
    desc: 'Technical reference letter drafting, ANZSCO duty alignment, and 100% plagiarism-free CDR episodes to avoid deductions.',
    stat: '100% Success'
  }
];
---

<Layout
  title={`Immigration Strategy (Canada & Australia) | ${siteData.name}`}
  description="Expert guidance for Canada Express Entry, Provincial Nominees, Australian GSM (189/190/491), Skills Assessments, and Student Visas by Moazzam Shoukat."
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-[11px] font-bold uppercase tracking-widest mb-4">
          IMMIGRATION & PERMANENT RESIDENCY
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0A1128] dark:text-white tracking-tight leading-[1.1]">
          Canada & Australia. <br />
          <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-200 bg-clip-text text-transparent">Clear Pathways to PR.</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-xl leading-relaxed">
          Data-driven points evaluation, precise skills assessment alignment, and airtight visa petitioning for skilled professionals and students.
        </p>
      </div>

      <!-- 4 Core Subpages Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
        {subpages.map((sp) => (
          <div class="p-8 sm:p-10 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 hover:border-amber-400/50 hover:shadow-xl transition-all flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl">{sp.flag}</span>
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20">
                  {sp.stat}
                </span>
              </div>
              <h2 class="text-2xl font-black text-[#0A1128] dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                <a href={sp.href}>{sp.title}</a>
              </h2>
              <p class="text-xs font-bold text-amber-700 dark:text-amber-400 mt-1 mb-3">
                {sp.subtitle}
              </p>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                {sp.desc}
              </p>
            </div>

            <div class="pt-5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
              <a
                href={sp.href}
                class="text-xs font-bold text-[#0A1128] dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors inline-flex items-center gap-1"
              >
                <span>Explore Dedicated Guide</span>
                <span>&rarr;</span>
              </a>
              <a
                href={`https://wa.me/923280484399?text=Hi%20Moazzam%2C%20I%20want%20to%20inquire%20about%20${encodeURIComponent(sp.title)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-bold text-amber-700 dark:text-amber-400 hover:underline"
              >
                Inquire on WhatsApp &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Skills Assessment Authorities Section -->
      <div class="p-8 sm:p-12 rounded-3xl bg-[#0A1128] text-white border border-amber-500/20 mb-20 space-y-8">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-widest text-amber-400 block mb-1">MANDATORY STEP</span>
          <h2 class="text-2xl sm:text-3xl font-black text-white">
            Australia Skills Assessment Strategy
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 max-w-2xl mt-2 leading-relaxed">
            A positive skills assessment is legally required before lodging an Australian Expression of Interest (EOI). Avoid experience deductions and costly assessment rejections.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2">
            <span class="text-xs font-bold text-amber-400">ACS (IT & Software)</span>
            <p class="text-xs text-slate-300 leading-relaxed">
              Software Engineers, Data Engineers, and Developers. Detailed reference letter vetting and RPL reports.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2">
            <span class="text-xs font-bold text-amber-400">Engineers Australia (EA)</span>
            <p class="text-xs text-slate-300 leading-relaxed">
              CDR pathway with 3 Career Episodes, Summary Statement, and CPD formatting for engineering credentials.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 space-y-2">
            <span class="text-xs font-bold text-amber-400">VETASSESS</span>
            <p class="text-xs text-slate-300 leading-relaxed">
              Management and general technical occupations. Rigorous employment evidence and organization chart mapping.
            </p>
          </div>
        </div>

        <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-800">
          <span class="text-xs text-slate-300">Read our complete step-by-step assessment breakdown:</span>
          <a
            href="/skills-assessment-australia"
            class="px-5 py-2.5 rounded-full text-xs font-bold bg-amber-400 text-slate-950 hover:bg-amber-300 transition-colors"
          >
            Skills Assessment Deep Dive &rarr;
          </a>
        </div>
      </div>

      <!-- Bottom Consultation Banner -->
      <div class="p-10 rounded-3xl bg-slate-100 dark:bg-[#111827] border border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h4 class="text-2xl font-black text-[#0A1128] dark:text-white">Need a comprehensive Points Diagnostic?</h4>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1">Book your free 20-minute diagnostic session with Moazzam Shoukat.</p>
        </div>
        <a
          href="/contact"
          class="px-6 py-3.5 rounded-full text-xs font-black bg-[#0A1128] text-white hover:bg-slate-800 dark:bg-amber-400 dark:text-slate-950 transition-colors shadow-md shrink-0"
        >
          Book Assessment &rarr;
        </a>
      </div>

    </div>
  </div>
</Layout>
