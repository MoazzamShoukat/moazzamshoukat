---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';
---

<Layout
  title={`Immigration Strategy (Canada & Australia) | ${siteData.name}`}
  description="Expert guidance for Canada Express Entry, Provincial Nominees, Australian GSM (189/190/491), Skills Assessments, and Student Visas."
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Nova Minimalist Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-900 dark:text-amber-300 text-[11px] font-bold uppercase tracking-widest mb-4">
          IMMIGRATION & PERMANENT RESIDENCY
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-stone-900 dark:text-white tracking-tight leading-[1.1]">
          Canada & Australia. <br />
          <span class="text-stone-500 dark:text-stone-400">Clear Pathways to PR.</span>
        </h1>
        <p class="mt-4 text-base text-stone-600 dark:text-stone-300 max-w-xl">
          Data-driven points evaluation, precise skills assessment alignment, and authentic visa petitioning.
        </p>
      </div>

      <!-- Overview Bento Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
        
        <!-- Canada Pillar -->
        <div class="p-8 sm:p-10 rounded-3xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 shadow-xs space-y-6">
          <div class="flex items-center justify-between">
            <span class="text-3xl">🍁</span>
            <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase bg-stone-100 dark:bg-zinc-800 text-stone-700 dark:text-stone-300">
              Express Entry & PNP
            </span>
          </div>
          <div>
            <h2 class="text-2xl font-black text-stone-900 dark:text-white">Canada Immigration</h2>
            <p class="text-xs text-stone-500 dark:text-stone-400 mt-1">Federal Skilled Worker (FSW) • CEC • Provincial Nominees</p>
          </div>
          <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
            Targeted category draws prioritizing STEM, healthcare, and trades talent alongside provincial nominations (OINP, BC PNP, SINP, AAIP).
          </p>
          <div class="space-y-2.5 border-t border-stone-100 dark:border-zinc-800 pt-4 text-xs text-stone-700 dark:text-stone-300">
            <div class="flex items-center gap-2">✓ Comprehensive CRS points diagnostic</div>
            <div class="flex items-center gap-2">✓ Provincial Nominee Program (PNP) stream selection</div>
            <div class="flex items-center gap-2">✓ Educational Credential Assessment (ECA: WES/ICAS)</div>
          </div>
        </div>

        <!-- Australia Pillar -->
        <div class="p-8 sm:p-10 rounded-3xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 shadow-xs space-y-6">
          <div class="flex items-center justify-between">
            <span class="text-3xl">🦘</span>
            <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase bg-amber-100 dark:bg-amber-950/60 text-amber-900 dark:text-amber-300">
              GSM 189 • 190 • 491
            </span>
          </div>
          <div>
            <h2 class="text-2xl font-black text-stone-900 dark:text-white">Australia Skilled Migration</h2>
            <p class="text-xs text-stone-500 dark:text-stone-400 mt-1">SkillSelect • State Invitations • Points Grid</p>
          </div>
          <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 leading-relaxed">
            Every point counts. We combine age, education, and experience points with Superior English (20 pts) and NAATI CCL Urdu (5 pts).
          </p>
          <div class="space-y-2.5 border-t border-stone-100 dark:border-zinc-800 pt-4 text-xs text-stone-700 dark:text-stone-300">
            <div class="flex items-center gap-2">✓ SkillSelect EOI lodgement & strategy</div>
            <div class="flex items-center gap-2">✓ State Nominated (190) & Regional (491) roadmaps</div>
            <div class="flex items-center gap-2">✓ +5 Bonus Points via NAATI CCL Urdu</div>
          </div>
        </div>

      </div>

      <!-- Skills Assessment Infographic Section -->
      <div class="p-8 sm:p-12 rounded-3xl bg-stone-100/70 dark:bg-zinc-900/60 border border-stone-200 dark:border-zinc-800 mb-20 space-y-8">
        <div>
          <span class="text-[11px] font-bold uppercase tracking-widest text-amber-700 dark:text-amber-400 block mb-1">MANDATORY STEP</span>
          <h2 class="text-2xl sm:text-3xl font-black text-stone-900 dark:text-white">
            Australia Skills Assessment Mastery
          </h2>
          <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-300 max-w-2xl mt-2">
            A positive skills assessment is legally required before lodging an Australian EOI. Rejections happen when roles do not match ANZSCO guidelines.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 space-y-2">
            <span class="text-xs font-bold text-stone-900 dark:text-white">ACS (IT & Software)</span>
            <p class="text-xs text-stone-600 dark:text-stone-300 leading-relaxed">
              Software Engineers, Data Engineers, and Developers. Detailed reference letter vetting and RPL reports.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 space-y-2">
            <span class="text-xs font-bold text-stone-900 dark:text-white">Engineers Australia (EA)</span>
            <p class="text-xs text-stone-600 dark:text-stone-300 leading-relaxed">
              CDR pathway with 3 Career Episodes, Summary Statement, and CPD formatting for engineering credentials.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-white dark:bg-[#18181B] border border-stone-200/80 dark:border-zinc-800 space-y-2">
            <span class="text-xs font-bold text-stone-900 dark:text-white">VETASSESS & TRA</span>
            <p class="text-xs text-stone-600 dark:text-stone-300 leading-relaxed">
              Management, business, and trade occupations. Detailed salary evidence and employment verification.
            </p>
          </div>
        </div>
      </div>

      <!-- Bottom Nova CTA -->
      <div class="p-8 sm:p-12 rounded-3xl bg-stone-900 text-white dark:bg-zinc-900 border border-stone-800 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-[11px] font-bold text-amber-400 uppercase tracking-widest block mb-1">FREE PROFILE EVALUATION</span>
          <h2 class="text-2xl sm:text-3xl font-bold">Calculate your exact CRS & GSM points today.</h2>
        </div>
        <a
          href="/contact?service=Immigration%20Consultation"
          class="px-6 py-3.5 rounded-full text-xs font-bold bg-amber-400 hover:bg-amber-300 text-stone-950 transition-colors flex-shrink-0"
        >
          Book Evaluation →
        </a>
      </div>

    </div>
  </div>
</Layout>
