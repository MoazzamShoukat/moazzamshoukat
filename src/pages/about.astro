---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';
---

<Layout
  title={`About Moazzam Shoukat | AI Researcher & Immigration Strategist`}
  description="Learn about Moazzam Shoukat: Senior Software Engineer, published AI researcher in speech processing, and accredited Canada & Australia immigration advisor."
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Badge & Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-[11px] font-bold uppercase tracking-widest mb-4">
          ABOUT MOAZZAM SHOUKAT
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0A1128] dark:text-white tracking-tight leading-[1.1]">
          Bridging Artificial Intelligence <br />
          <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-200 bg-clip-text text-transparent">with Global Opportunity.</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
          Based in Lahore, Punjab, Pakistan. Senior Software Engineer with a rich academic foundation in speech transformers, alongside an accredited immigration and English training practice for Canada and Australia.
        </p>
      </div>

      <!-- Bento Grid About Section -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-20">
        
        <!-- Profile Card (4 cols) -->
        <div class="lg:col-span-4 p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs space-y-6">
          <div class="aspect-square rounded-2xl overflow-hidden bg-[#0A1128] border border-amber-500/20 flex items-center justify-center">
            <img
              src="/images/moazzam.png"
              alt="Moazzam Shoukat"
              class="w-full h-full object-cover object-top"
              onerror="this.src='/favicon.svg'"
            />
          </div>
          <div>
            <h2 class="text-2xl font-black text-[#0A1128] dark:text-white">{siteData.name}</h2>
            <p class="text-xs font-bold text-amber-700 dark:text-amber-400 mt-1">{siteData.contact.location}</p>
          </div>

          <div class="space-y-2 pt-2 border-t border-slate-100 dark:border-slate-800 text-xs">
            <div class="flex justify-between py-1.5 border-b border-slate-100 dark:border-slate-800">
              <span class="text-slate-500">Academic Background:</span>
              <span class="font-bold text-slate-800 dark:text-slate-200">BS CS (ITU Lahore)</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-slate-100 dark:border-slate-800">
              <span class="text-slate-500">Research Focus:</span>
              <span class="font-bold text-amber-700 dark:text-amber-400">7 Papers (Speech AI)</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-slate-100 dark:border-slate-800">
              <span class="text-slate-500">Engineering:</span>
              <span class="font-bold text-slate-800 dark:text-slate-200">Emulation AI (Software Eng.)</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-slate-100 dark:border-slate-800">
              <span class="text-slate-500">Immigration Focus:</span>
              <span class="font-bold text-slate-800 dark:text-slate-200">Canada & Australia PR</span>
            </div>
            <div class="flex justify-between py-1.5">
              <span class="text-slate-500">Language Expertise:</span>
              <span class="font-bold text-amber-700 dark:text-amber-400">IELTS 8.5 • 96% NAATI Success</span>
            </div>
          </div>

          <a
            href="/contact"
            class="block w-full text-center py-3.5 px-4 rounded-full text-xs font-black bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 transition-colors shadow-md"
          >
            Connect with Moazzam &rarr;
          </a>
        </div>

        <!-- Story & Philosophy (8 cols) -->
        <div class="lg:col-span-8 space-y-8">
          
          <div class="p-8 sm:p-10 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs space-y-5">
            <span class="text-xs font-black uppercase tracking-wider text-amber-700 dark:text-amber-400">PHILOSOPHY & DUAL MASTERY</span>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-[#0A1128] dark:text-white leading-tight">
              Where Engineering Rigor Meets Strategic Global Mobility
            </h3>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
              With a formal education in Computer Science from the <strong>Information Technology University (ITU), Lahore</strong> and hands-on experience developing enterprise backend systems and data scraping architectures at <strong>Emulation AI</strong> and <strong>Ibtidah Solutions</strong>, I approach both software systems and immigration applications with strict mathematical and architectural precision.
            </p>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
              In academic research, I have authored 7 comprehensive papers spanning <em>Transformers in speech processing</em>, <em>Large Audio Models</em>, and <em>Internet of Audio Things for Healthcare</em>. In professional advisory, I view immigration points matrices and automated exam grading rubrics (such as PTE Pearson algorithms and Cambridge IELTS criteria) as <strong>systems that can be systematically mastered</strong>.
            </p>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
              Whether building an enterprise ETL scraper or engineering an Australian Expression of Interest (EOI) with maximum points, my goal is always the same: <strong>delivering high-impact, transparent, and flawless execution</strong>.
            </p>
          </div>

          <!-- 3 Visual Principles -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs">
              <span class="text-xs font-black text-amber-700 dark:text-amber-400 uppercase tracking-widest block mb-2">01 / INTEGRITY</span>
              <h4 class="font-extrabold text-[#0A1128] dark:text-white text-base mb-1">Evidence-Based</h4>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">Every claim, paper citation, and visa strategy is backed by official published evidence.</p>
            </div>

            <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs">
              <span class="text-xs font-black text-amber-700 dark:text-amber-400 uppercase tracking-widest block mb-2">02 / DEPTH</span>
              <h4 class="font-extrabold text-[#0A1128] dark:text-white text-base mb-1">Deep Technical Skill</h4>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">Active in modern Python, ETL pipelines, PostgreSQL, and transformer audio models.</p>
            </div>

            <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs">
              <span class="text-xs font-black text-amber-700 dark:text-amber-400 uppercase tracking-widest block mb-2">03 / DIRECTNESS</span>
              <h4 class="font-extrabold text-[#0A1128] dark:text-white text-base mb-1">Personal Mentorship</h4>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">Clients and collaborators work directly with Moazzam, never delegated to junior staff.</p>
            </div>
          </div>

        </div>

      </div>

      <!-- Quick Links Strip -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-16">
        <a href="/research" class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 hover:border-amber-400/50 transition-all">
          <div class="text-xl mb-1">🔬</div>
          <div class="font-bold text-sm text-[#0A1128] dark:text-white">Research & Publications</div>
          <div class="text-xs text-slate-500 mt-1">Explore all 7 papers & citations &rarr;</div>
        </a>
        <a href="/experience" class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 hover:border-amber-400/50 transition-all">
          <div class="text-xl mb-1">💼</div>
          <div class="font-bold text-sm text-[#0A1128] dark:text-white">Professional Experience</div>
          <div class="text-xs text-slate-500 mt-1">Emulation AI & Ibtidah Solutions &rarr;</div>
        </a>
        <a href="/education" class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 hover:border-amber-400/50 transition-all">
          <div class="text-xl mb-1">🎓</div>
          <div class="font-bold text-sm text-[#0A1128] dark:text-white">Education & Projects</div>
          <div class="text-xs text-slate-500 mt-1">ITU BS CS, Anemia AI, DAE &rarr;</div>
        </a>
        <a href="/skills" class="p-5 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 hover:border-amber-400/50 transition-all">
          <div class="text-xl mb-1">⚡</div>
          <div class="font-bold text-sm text-[#0A1128] dark:text-white">Technical Skills</div>
          <div class="text-xs text-slate-500 mt-1">Languages, Databases, Scraping &rarr;</div>
        </a>
      </div>

      <!-- Bottom Consultation Banner -->
      <div class="p-10 rounded-3xl bg-[#0A1128] text-white border border-amber-500/20 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h4 class="text-2xl font-black">Ready to discuss your profile or collaborate?</h4>
          <p class="text-xs sm:text-sm text-slate-300 mt-1">Schedule a conversation with Moazzam Shoukat.</p>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <a
            href="/contact"
            class="px-6 py-3 rounded-full text-xs font-black bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 transition-colors shadow-md"
          >
            Get in Touch &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
