---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';

const faqs = [
  {
    q: "What Australian immigration guidance services does Moazzam Shoukat provide?",
    a: "Moazzam Shoukat offers strategic, end-to-end guidance for General Skilled Migration (GSM). This includes comprehensive profile evaluation, points optimization strategy (+20 points for PTE Superior English and +5 points for NAATI CCL Urdu), skills assessment document vetting (ACS, Engineers Australia CDR, VETASSESS), Expression of Interest (EOI) drafting, and State Nomination criteria analysis."
  },
  {
    q: "What is the difference between Subclass 189, 190, and 491 visas?",
    a: "Subclass 189 (Skilled Independent) is a permanent visa requiring no state sponsor or employer, granting unconditional residency anywhere in Australia. Subclass 190 (Skilled Nominated) is also a permanent visa that awards 5 bonus nomination points from an Australian state/territory in exchange for a commitment to live and work there for two years. Subclass 491 (Skilled Work Regional) is a 5-year provisional visa providing 15 bonus nomination points for designated regional areas, with a direct pathway to permanent residency via Subclass 191 after meeting income/residence thresholds."
  },
  {
    q: "How many points do I need in 2026 to receive an invitation from Pakistan?",
    a: "While the statutory minimum to lodge an Expression of Interest (EOI) is 65 points, actual invitation cutoffs vary significantly by occupation. IT professionals and Software Engineers typically need 85 to 95+ points for Subclass 189, or 80 to 90 points for Subclass 190/491. Maximizing English (PTE 79+ for 20 points) and NAATI CCL (+5 points) is nearly mandatory for offshore applicants from Pakistan."
  },
  {
    q: "What assessing authorities are relevant for Pakistani applicants?",
    a: "For IT & Software professionals, the Australian Computer Society (ACS) assesses qualifications and closely scrutinizes employment reference letters. For Engineers, Engineers Australia (EA) requires a Washington Accord accredited degree or a Competency Demonstration Report (CDR) with 3 Career Episodes. VETASSESS assesses over 360 general professional occupations, including Marketing, Management Consultants, and Financial Analysts."
  },
  {
    q: "How does Moazzam help with skills assessment reference letters?",
    a: "A major cause of skills assessment rejection from Pakistan is submitting generic HR letters. Moazzam reviews and guides the drafting of comprehensive reference letters ensuring that at least 65% of the core duties defined by ANZSCO for your nominated occupation are clearly documented with verified organizational charts and salary evidence."
  },
  {
    q: "Is this service official migration advice or strategic case preparation?",
    a: "This service provides educational guidance, strategic planning, points auditing, document vetting, and exam preparation assistance based on official Australian Department of Home Affairs regulations. We do not provide statutory legal migration representation and advise clients to consult official assessing authorities or registered migration agents (OMARA) where formal legal representation is required."
  }
];

const pillars = [
  {
    icon: "🎯",
    title: "Points Audit & Strategy Blueprint",
    desc: "Rigorous assessment of your age, qualifications, overseas experience, partner skills, and targeted language scores to construct your highest possible SkillSelect points tally."
  },
  {
    icon: "📑",
    title: "Skills Assessment Pre-Vetting",
    desc: "Meticulous documentation audits for ACS, Engineers Australia (CDR), and VETASSESS to eliminate duties mismatches, deduction years, and assessment delays."
  },
  {
    icon: "⚡",
    title: "The 25-Point English & NAATI Boost",
    desc: "Integrated coaching for PTE Academic (79+ Superior = 20 points) and NAATI CCL Urdu (+5 points), directly adding 25 decisive points to your EOI."
  },
  {
    icon: "🗺️",
    title: "State Nomination Target Mapping",
    desc: "In-depth analysis of nomination allocations and invitation criteria across Victoria, NSW, South Australia, Western Australia, Queensland, Tasmania, ACT, and NT."
  },
  {
    icon: "💼",
    title: "EOI & ROI Lodgement Strategy",
    desc: "Guidance on structuring multiple SkillSelect EOIs and state Registrations of Interest (ROIs) without triggering duplicate claim penalties."
  },
  {
    icon: "🤝",
    title: "Transparent & Ethical Mentorship",
    desc: "Honest, realistic feasibility evaluations without inflated promises, false rankings, or unverified claims. We prioritize your hard-earned time and capital."
  }
];

const visaComparison = [
  { subclass: "Subclass 189", type: "Skilled Independent (Permanent)", pointsBonus: "0 Points", location: "Live & work anywhere in Australia", targetGroup: "High-point MLTSSL occupations (85-95+ pts)" },
  { subclass: "Subclass 190", type: "Skilled Nominated (Permanent)", pointsBonus: "+5 Points", location: "Nominated state for 2 years, then anywhere", targetGroup: "State-priority occupations (80-90 pts)" },
  { subclass: "Subclass 491", type: "Skilled Work Regional (5-Year Provisional)", pointsBonus: "+15 Points", location: "Designated regional areas", targetGroup: "Regional occupations with Subclass 191 PR pathway" }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://moazzamshoukat.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://moazzamshoukat.com/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Australian Immigration Consultant",
      "item": "https://moazzamshoukat.com/australian-immigration-consultant/"
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Australian Immigration & Skilled Migration Guidance in Lahore",
  "description": "Expert Australian skilled migration guidance, points optimization, skills assessment review, and Subclass 189, 190, 491 EOI roadmaps by Moazzam Shoukat.",
  "provider": {
    "@type": "Person",
    "name": "Moazzam Shoukat",
    "url": "https://moazzamshoukat.com/"
  },
  "areaServed": [
    { "@type": "City", "name": "Lahore" },
    { "@type": "Country", "name": "Pakistan" },
    { "@type": "Country", "name": "Australia" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title="Australian Immigration Consultant in Lahore | Skilled Migration Advisor | Moazzam Shoukat"
  description="Navigate Australian Skilled Migration (189, 190, 491) with Moazzam Shoukat in Lahore. Strategic points calculation, skills assessment documentation & EOI guidance."
  keywords="Australian Immigration Consultant in Lahore, Best Australian Immigration Advisor Pakistan, Australia Skilled Migration Guidance, Australia PR Pathway Guidance, Australian Skill Assessment Assistance, Subclass 189 190 491 Guidance"
  schema={[breadcrumbSchema, serviceSchema, faqSchema]}
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-400">
          <li>
            <a href="/" class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">Home</a>
          </li>
          <li class="text-slate-400">/</li>
          <li>
            <a href="/services/" class="hover:text-amber-700 dark:hover:text-amber-400 transition-colors">Services</a>
          </li>
          <li class="text-slate-400">/</li>
          <li class="text-amber-700 dark:text-amber-400 font-semibold">Australian Immigration Consultant</li>
        </ol>
      </nav>

      <!-- Hero Header -->
      <div class="max-w-4xl mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-xs font-bold uppercase tracking-widest mb-6">
          <span>🇦🇺 General Skilled Migration Advisory &bull; Subclass 189, 190 & 491</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0A1128] dark:text-white tracking-tight leading-tight mb-6">
          Trusted <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-200 bg-clip-text text-transparent">Australian Immigration Guidance</span> in Lahore
        </h1>

        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl mb-8">
          Strategic, transparent migration documentation and points optimization for Pakistani professionals. Maximize your SkillSelect ranking, navigate ACS / Engineers Australia skills assessments, and chart an authoritative roadmap to Australian Permanent Residency.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap items-center gap-4">
          <a
            href={siteData.contact.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-full text-xs sm:text-sm font-black bg-amber-400 hover:bg-amber-300 text-slate-950 transition-all shadow-lg hover:shadow-xl hover:scale-105 duration-200 flex items-center gap-2"
          >
            <span>Book Strategic Profile Assessment</span>
            <span>&rarr;</span>
          </a>
          <a
            href="/australia-skilled-migration/"
            class="px-7 py-4 rounded-full text-xs sm:text-sm font-bold bg-white dark:bg-slate-800 text-slate-900 dark:text-white border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700/60 transition-all"
          >
            Points Calculator Guide &rarr;
          </a>
        </div>
      </div>

      <!-- Compliance & E-E-A-T Disclaimer Banner -->
      <div class="mb-16 p-6 rounded-2xl bg-amber-500/10 dark:bg-amber-400/5 border border-amber-500/20">
        <div class="flex items-start gap-4">
          <span class="text-2xl mt-0.5">ℹ️</span>
          <div class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
            <strong class="font-bold text-slate-900 dark:text-white block mb-1">Scope of Service & Regulatory Transparency:</strong>
            Moazzam Shoukat provides strategic educational guidance, points score planning, English/NAATI coaching, and skills assessment document vetting based on publicly available Australian Department of Home Affairs standards. We do not claim to be a registered Australian migration agent (MARA) or Australian legal practitioner. Where formal statutory legal representation is required, clients are directed to registered migration authorities.
          </div>
        </div>
      </div>

      <!-- Pillars Section -->
      <section class="mb-20">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white mb-4">
            How We Optimize Your Australian Skilled Migration Journey
          </h2>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300">
            A comprehensive, rigorous approach that eliminates documentation errors and maximizes your invitation viability.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {pillars.map((p) => (
            <div class="p-6 rounded-2xl bg-white dark:bg-slate-900/50 border border-slate-200/80 dark:border-slate-800 hover:border-amber-500/50 transition-all shadow-sm">
              <div class="text-3xl mb-4">{p.icon}</div>
              <h3 class="text-base font-black text-slate-900 dark:text-white mb-2">{p.title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{p.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Visa Comparison Table -->
      <section class="mb-20 p-8 rounded-3xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 shadow-xl">
        <div class="max-w-3xl mb-6">
          <span class="text-amber-600 dark:text-amber-400 text-xs font-black uppercase tracking-widest">Visa Pathway Comparison</span>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white mt-1">
            Understanding Australian Skilled Visa Subclasses (189 vs 190 vs 491)
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2">
            Choosing the right subclass depends on your points tally, nominated occupation list, and state sponsorship eligibility.
          </p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead>
              <tr class="border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400">
                <th class="py-3 px-4 font-bold">Subclass</th>
                <th class="py-3 px-4 font-bold">Visa Status</th>
                <th class="py-3 px-4 font-bold text-amber-600 dark:text-amber-400">Bonus Points</th>
                <th class="py-3 px-4 font-bold">Residency Condition</th>
                <th class="py-3 px-4 font-bold">Ideal Applicant Profile</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60 text-slate-700 dark:text-slate-300">
              {visaComparison.map((row) => (
                <tr>
                  <td class="py-3 px-4 font-black text-slate-900 dark:text-white">{row.subclass}</td>
                  <td class="py-3 px-4">{row.type}</td>
                  <td class="py-3 px-4 font-black text-amber-700 dark:text-amber-400">{row.pointsBonus}</td>
                  <td class="py-3 px-4">{row.location}</td>
                  <td class="py-3 px-4 text-slate-500 dark:text-slate-400">{row.targetGroup}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- FAQs -->
      <section class="mb-20">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <h2 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white mb-4">
            Frequently Asked Questions: Australian Migration Guidance
          </h2>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300">
            Honest, verified insights on invitation rounds, costs, and documentation requirements.
          </p>
        </div>

        <div class="space-y-4 max-w-4xl mx-auto">
          {faqs.map((faq) => (
            <div class="p-6 rounded-2xl bg-white dark:bg-slate-900/50 border border-slate-200/80 dark:border-slate-800">
              <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">{faq.q}</h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Related Navigation Links -->
      <section class="p-8 rounded-3xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-center">
        <h3 class="text-lg font-black text-slate-900 dark:text-white mb-3">Explore Related Skilled Migration Pillars</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mb-6 max-w-xl mx-auto">
          Streamline your case with skills assessment guidance and language coaching specifically tuned to Australian PR.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3 text-xs font-bold">
          <a href="/australia-skilled-migration/" class="px-4 py-2 rounded-xl bg-white dark:bg-slate-800 text-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 hover:text-amber-600 transition-colors">Australia Skilled Migration Overview</a>
          <a href="/skill-assessment-guidance/" class="px-4 py-2 rounded-xl bg-white dark:bg-slate-800 text-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 hover:text-amber-600 transition-colors">Skill Assessment Guidance (ACS/EA)</a>
          <a href="/pte-trainer-lahore/" class="px-4 py-2 rounded-xl bg-white dark:bg-slate-800 text-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 hover:text-amber-600 transition-colors">PTE 79+ (+20 English Points)</a>
          <a href="/naati-ccl-urdu-preparation/" class="px-4 py-2 rounded-xl bg-white dark:bg-slate-800 text-slate-800 dark:text-white border border-slate-200 dark:border-slate-700 hover:text-amber-600 transition-colors">NAATI CCL Urdu (+5 Points)</a>
          <a href="/contact/" class="px-4 py-2 rounded-xl bg-amber-400 text-slate-950 hover:bg-amber-300 transition-colors">Book Profile Consultation</a>
        </div>
      </section>

    </div>
  </div>
</Layout>
