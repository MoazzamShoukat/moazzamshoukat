---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';

const faqs = [
  {
    q: "What is NAATI CCL and why is it crucial for Australian PR?",
    a: "NAATI CCL (Credentialed Community Language) is an official interpreting assessment conducted by the National Accreditation Authority for Translators and Interpreters in Australia. Passing the CCL test grants an immediate 5 bonus points on your Australian GSM points test (Subclass 189, 190, and 491), often making the difference between receiving an invitation or missing out."
  },
  {
    q: "How is the NAATI CCL Urdu test structured and scored?",
    a: "The test consists of two recorded dialogues (approx. 300 words each), alternating between an English speaker and an Urdu speaker. Each dialogue is worth 45 marks (total 90 marks). To pass, you must score at least 29 out of 45 in each dialogue, and achieve an overall aggregate score of at least 63 out of 90."
  },
  {
    q: "Can I take the NAATI CCL exam online from Pakistan?",
    a: "Yes. NAATI CCL is delivered 100% online via proctored Microsoft Teams video call. You can take the exam from the comfort of your home in Lahore, Karachi, Islamabad, or anywhere in the world with a reliable computer, webcam, and headset."
  },
  {
    q: "What is the official repeat policy during the test?",
    a: "You are allowed one free repeat per dialogue without penalty. Any additional repeat in the same dialogue incurs a deduction of 1 mark. We train you in tactical repeat usage to clarify dense sentences without penalty."
  },
  {
    q: "Do I need formal interpretation experience to pass?",
    a: "No professional interpreting license is required. NAATI CCL evaluates your ability to convey the meaning of colloquial and community dialogue accurately without major omissions, distortions, or unwarranted additions. Our systematic shorthand note-taking eliminates memory lapses."
  },
  {
    q: "How long does it take to prepare for NAATI CCL Urdu?",
    a: "Most candidates who are comfortable speaking conversational Urdu and English pass comfortably with 3 to 4 weeks of dedicated practice covering our 50 topic-based dialogue banks and vocabulary glossaries."
  }
];

const offerings = [
  {
    icon: "🎧",
    title: "50+ Authentic Exam Dialogues",
    desc: "Complete coverage of essential NAATI topics: Centrelink, Healthcare, Legal aid, Rental tenancies, Insurance, and Education in Australia."
  },
  {
    icon: "📚",
    title: "Specialized Bilingual Glossary",
    desc: "Over 1,200 curated English-Urdu terminology pairs covering medical diagnoses, court terminology, and Australian government terms."
  },
  {
    icon: "✍️",
    title: "Shorthand Note-Taking System",
    desc: "A proven symbol and abbreviation method allowing you to transcribe 35-word dialogue segments without losing key facts or numbers."
  },
  {
    icon: "🎙️",
    title: "Live Proctored Mock Tests",
    desc: "1-on-1 simulated exams on Microsoft Teams mirroring actual NAATI conditions with real-time scoring rubrics and feedback."
  },
  {
    icon: "⏱️",
    title: "Pause & Correction Tactics",
    desc: "Learn official NAATI guidelines for self-corrections without penalty and strategic pause allocation."
  },
  {
    icon: "🇦🇺",
    title: "+5 PR Points Strategy Alignment",
    desc: "We coordinate your CCL exam timeline directly with your SkillSelect EOI submission and state nomination windows."
  }
];

const stats = [
  { label: "First-Attempt Pass Rate", value: "96%" },
  { label: "Average Test Score", value: "74/90" },
  { label: "PR Bonus Points Granted", value: "5 Pts" },
  { label: "Successful Candidates", value: "110+" }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title="NAATI CCL Urdu Trainer Lahore | Claim +5 Australia PR Points | Moazzam Shoukat"
  description="Leading NAATI CCL Urdu trainer in Lahore and online worldwide. 50+ recorded exam dialogues, specialized shorthand note-taking, and vocabulary banks for a 96% first-attempt pass rate."
  keywords="NAATI CCL Urdu Trainer, NAATI CCL Urdu Pakistan, NAATI CCL 5 Australia PR Points, NAATI CCL coaching Lahore, NAATI CCL Urdu dialogues, NAATI online test Pakistan"
  schema={faqSchema}
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Top Badge & SEO Heading -->
      <div class="max-w-3xl mb-14">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-[11px] font-bold uppercase tracking-widest mb-4">
          CREDENTIALED COMMUNITY LANGUAGE (CCL) • ONLINE & LAHORE
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0A1128] dark:text-white tracking-tight leading-[1.1]">
          NAATI CCL Urdu Trainer. <br />
          <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-200 bg-clip-text text-transparent">Claim 5 Australia PR Points Fast.</span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          The fastest and most reliable way to boost your Australian Skilled Migration (189, 190, 491) points. Master dialogue interpretation, note-taking shorthand, and domain-specific vocabulary with a 96% first-attempt pass rate under Moazzam Shoukat's coaching.
        </p>

        <!-- CTA Action Row -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="px-8 py-4 rounded-full bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>Book Free Diagnostic Dialogue</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a
            href="https://wa.me/923280484399?text=Hi%20Moazzam%2C%20I%20want%20to%20prepare%20for%20NAATI%20CCL%20Urdu."
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>WhatsApp Now</span>
            <span class="text-xs opacity-90">+92-328-048-4399</span>
          </a>
        </div>
      </div>

      <!-- Trust Stat Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-20">
        {stats.map((s) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs text-center">
            <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400 tracking-tight">{s.value}</div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-1 font-bold">{s.label}</div>
          </div>
        ))}
      </div>

      <!-- Offerings Grid -->
      <div class="mb-24">
        <div class="max-w-2xl mb-12">
          <h2 class="text-xs uppercase tracking-widest font-black text-amber-700 dark:text-amber-400 mb-2">DIALOGUE MASTERY CURRICULUM</h2>
          <h3 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight">Structured Interpretation Training</h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm mt-3">From specialized terminology banks to mock tests under actual Microsoft Teams test conditions.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {offerings.map((item) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs hover:border-amber-400/50 transition-all flex flex-col justify-between">
              <div>
                <div class="text-3xl mb-4">{item.icon}</div>
                <h4 class="text-xl font-bold text-[#0A1128] dark:text-white mb-2">{item.title}</h4>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- FAQ Accordion / Cards -->
      <div class="mb-24">
        <div class="max-w-2xl mb-12">
          <h2 class="text-xs uppercase tracking-widest font-black text-amber-700 dark:text-amber-400 mb-2">FREQUENTLY ASKED QUESTIONS</h2>
          <h3 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight">NAATI CCL Urdu Queries</h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm mt-3">Essential details regarding exam structure, scoring rubrics, and online test logistics.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {faqs.map((faq, i) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs">
              <div class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">
                  {i + 1}
                </span>
                <div>
                  <h4 class="text-base font-bold text-[#0A1128] dark:text-white mb-2">{faq.q}</h4>
                  <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{faq.a}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Bottom Conversion Callout -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h3 class="text-2xl sm:text-3xl font-black text-[#0A1128] dark:text-white tracking-tight">
          Ready to Claim Your 5 Australian PR Points?
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">
          Book a free diagnostic dialogue session to evaluate your current interpretation speed and receive our complete Urdu glossary.
        </p>
        <div class="pt-2 flex justify-center gap-3">
          <a
            href="/contact"
            class="px-8 py-3.5 rounded-full font-bold text-xs bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 transition-colors shadow-md"
          >
            Start NAATI CCL Training &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
