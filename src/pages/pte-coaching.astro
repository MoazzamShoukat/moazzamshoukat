---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';
import PteScoreComparison from '../components/infographics/PteScoreComparison.astro';

const faqs = [
  {
    q: "Is PTE Academic easier than IELTS for Pakistani students?",
    a: "PTE Academic is 100% computer-marked by an automated AI scoring algorithm, eliminating human examiner subjectivity. For students who struggle with handwriting, strict human essay grading, or face-to-face interview anxiety, PTE is usually much easier to master using structural templates and vocal rhythm techniques."
  },
  {
    q: "How do you train students to beat the Pearson Speaking AI engine?",
    a: "Pearson's speech algorithm evaluates oral fluency and pronunciation over accent. We train candidates in steady volume modulation, chunking pauses at punctuation, avoiding hesitation fillers (uh, umm), and continuous acoustic cadence that satisfies the neural speech recognizer."
  },
  {
    q: "Which specific tasks contribute the most points across multiple sections?",
    a: "PTE is integrated. Just 4 tasks contribute over 50% of the entire exam's score: Repeat Sentence (Speaking & Listening), Write From Dictation (Listening & Writing), Read Aloud (Reading & Speaking), and Reading & Writing Fill in the Blanks. We prioritize these high-weight sections relentlessly."
  },
  {
    q: "What PTE score equals IELTS Band 8.0 for 20 points in Australia PR?",
    a: "A score of 79+ in each of the four communicative skills (Listening, Reading, Speaking, Writing) represents 'Superior English' under Australia's Department of Home Affairs, granting the maximum 20 immigration points."
  },
  {
    q: "Do you provide real exam simulation software and prediction banks?",
    a: "Yes. All enrolled candidates receive access to full-length AI-scored mock exam engines and updated monthly prediction question banks covering active repeat sentences and exam dictations."
  },
  {
    q: "How many weeks of preparation are required for a 79+ target?",
    a: "Candidates with intermediate English proficiency typically achieve 79+ in 3 to 4 weeks using our high-yield templates, daily dictation drills, and continuous voice diagnostics."
  }
];

const offerings = [
  {
    icon: "🎙️",
    title: "Speaking AI Algorithm Coaching",
    desc: "Master Read Aloud, Repeat Sentence, and Describe Image templates with vocal calibration tuned to Pearson's acoustic models in Pakistan."
  },
  {
    icon: "⚡",
    title: "High-Yield Dictation & Vocab Banks",
    desc: "Targeted mastery of 500+ recurrent Write From Dictation phrases and high-frequency academic collocations."
  },
  {
    icon: "📝",
    title: "One-Template Essay Framework",
    desc: "A foolproof, syntactically error-free essay skeleton that achieves 90/90 in Written Discourse and Grammar every time."
  },
  {
    icon: "🔄",
    title: "Integrated Reading Tactics",
    desc: "Advanced collocation patterns and grammar clues for Reading & Writing Fill in the Blanks (R&W FIB)."
  },
  {
    icon: "💻",
    title: "Full-Length AI Mock Portals",
    desc: "Experience realistic test center environments with section timers, background noise simulation, and AI scorecards."
  },
  {
    icon: "🚀",
    title: "Australia PR 79+ (Superior) Fast-Track",
    desc: "Intensive 30-day bootcamps specifically targeted at claiming the maximum 20 migration points on SkillSelect."
  }
];

const stats = [
  { value: "79+", label: "Average Student Target" },
  { value: "+20 Pts", label: "Australia PR Points Gained" },
  { value: "90/90", label: "Speaking Fluency Record" },
  { value: "3-4 Wks", label: "Average Preparation Cycle" }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout
  title="Best PTE Coaching Pakistan | 79+ Superior English Strategy | Moazzam Shoukat"
  description="Achieve PTE 79+ (Superior English) for Australia PR and university admissions with Pakistan's top PTE trainer Moazzam Shoukat. AI algorithm speech calibration, templates, and mock test banks."
  keywords="Best PTE Coaching Pakistan, PTE Academic Lahore, PTE 79+ Strategy, Pearson PTE Training Pakistan, PTE Speaking AI hacks, Australia PR 20 points English"
  schema={faqSchema}
>
  <div class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Service Page Hero Header -->
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 text-[11px] font-bold uppercase tracking-widest mb-4">
          PEARSON TEST OF ENGLISH (ACADEMIC & CORE)
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-[#0A1128] dark:text-white tracking-tight leading-[1.1]">
          Best PTE Coaching Pakistan. <br />
          <span class="bg-gradient-to-r from-amber-600 via-amber-500 to-amber-600 dark:from-amber-400 dark:to-amber-200 bg-clip-text text-transparent">79+ Superior English Secrets.</span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          Master Pearson's automated scoring algorithms. Taught by AI Researcher Moazzam Shoukat, learn how to calibrate your microphone pitch, maintain unbroken oral fluency, and secure the maximum 20 Australian PR points.
        </p>

        <!-- CTA Action Row -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="px-8 py-4 rounded-full bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>Book Free Mock Diagnostic</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a
            href="https://wa.me/923280484399?text=Hi%20Moazzam%2C%20I%20want%20to%20enroll%20in%20PTE%20coaching."
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-xs sm:text-sm transition-all shadow-md flex items-center gap-2"
          >
            <span>WhatsApp Coach</span>
            <span class="text-xs opacity-90">+92-328-048-4399</span>
          </a>
        </div>
      </div>

      <!-- Trust Stat Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-20">
        {stats.map((s) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs text-center">
            <div class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-amber-400 tracking-tight">{s.value}</div>
            <div class="text-xs text-slate-500 dark:text-slate-400 mt-1 font-bold">{s.label}</div>
          </div>
        ))}
      </div>

      <!-- Offerings Grid -->
      <div class="mb-24">
        <div class="max-w-2xl mb-12">
          <h2 class="text-xs uppercase tracking-widest font-black text-amber-700 dark:text-amber-400 mb-2">INTEGRATED MODULE TRAINING</h2>
          <h3 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight">The 80/20 High-Yield Approach</h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm mt-3">Focus on the 4 high-scoring question types that determine 50%+ of your overall scorecard.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {offerings.map((item) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs hover:border-amber-400/50 transition-all flex flex-col justify-between">
              <div>
                <div class="text-3xl mb-4">{item.icon}</div>
                <h4 class="text-xl font-bold text-[#0A1128] dark:text-white mb-2">{item.title}</h4>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- NEW EMBEDDED INFOGRAPHIC: PTE Score Comparison -->
      <div class="mb-24">
        <PteScoreComparison />
      </div>

      <!-- Why Choose Moazzam Shoukat Section -->
      <div class="p-8 sm:p-12 lg:p-16 rounded-3xl bg-[#0A1128] text-white border border-amber-500/20 mb-24">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-7 space-y-6">
            <span class="inline-block px-3 py-1 rounded-full bg-slate-900 border border-amber-500/30 text-amber-400 text-[11px] font-bold uppercase tracking-widest">
              WHY CHOOSE MOAZZAM SHOUKAT
            </span>
            <h3 class="text-3xl sm:text-4xl font-black tracking-tight leading-tight">
              Trained by an AI Speech Specialist.
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Pearson uses acoustic speech recognition models that analyze oral fluency and pronunciation tokens. As an AI researcher who has published in speech transformer models, Moazzam understands the underlying algorithms and calibrates your speaking cadence to achieve 90/90 oral fluency.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
              <div class="flex items-start gap-3">
                <span class="text-amber-400 font-bold text-lg">✓</span>
                <div>
                  <h5 class="text-sm font-bold text-white">Vocal Pitch & Cadence Alignment</h5>
                  <p class="text-xs text-slate-400 mt-0.5">Eliminate hesitation, unnatural pitch drops, and microphone clipping.</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-amber-400 font-bold text-lg">✓</span>
                <div>
                  <h5 class="text-sm font-bold text-white">Repeat Sentence Memory Techniques</h5>
                  <p class="text-xs text-slate-400 mt-0.5">Short-term auditory retention tricks to capture 80%+ keywords every time.</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-amber-400 font-bold text-lg">✓</span>
                <div>
                  <h5 class="text-sm font-bold text-white">Real-Time AI Diagnostic Scorecards</h5>
                  <p class="text-xs text-slate-400 mt-0.5">Detailed breakdown of enabling skills (Grammar, Oral Fluency, Pronunciation).</p>
                </div>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-amber-400 font-bold text-lg">✓</span>
                <div>
                  <h5 class="text-sm font-bold text-white">Monthly Active Prediction Bank</h5>
                  <p class="text-xs text-slate-400 mt-0.5">Practice exclusively from recurrent exam questions appearing in test centers.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="lg:col-span-5 flex flex-col gap-4 p-6 sm:p-8 rounded-2xl bg-slate-900/90 border border-slate-800">
            <div class="text-xs uppercase tracking-widest text-amber-400 font-bold">FAST-TRACK TO 79+</div>
            <div class="text-2xl font-black text-white">Check Your Speaking Score</div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Send a 30-second Read Aloud recording on WhatsApp and receive an immediate evaluation of your oral fluency and acoustic score.
            </p>
            <div class="pt-2 flex flex-col sm:flex-row gap-3">
              <a
                href="/contact"
                class="text-center px-6 py-3 rounded-full bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-bold text-xs transition-all shadow-md"
              >
                Enroll in PTE Batch
              </a>
              <a
                href="https://wa.me/923280484399?text=Hello%20Moazzam,%20I%20want%20to%20send%20my%20PTE%20speaking%20recording%20for%20feedback."
                target="_blank"
                rel="noopener noreferrer"
                class="text-center px-6 py-3 rounded-full bg-[#25D366] hover:bg-[#20ba59] text-white font-bold text-xs transition-all shadow-md"
              >
                WhatsApp Advisor
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQ Accordion / Cards -->
      <div class="mb-24">
        <div class="max-w-2xl mb-12">
          <h2 class="text-xs uppercase tracking-widest font-black text-amber-700 dark:text-amber-400 mb-2">FREQUENTLY ASKED QUESTIONS</h2>
          <h3 class="text-3xl sm:text-4xl font-black text-[#0A1128] dark:text-white tracking-tight">PTE Academic Inquiries</h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm mt-3">Essential answers regarding automated scoring, test formats, and preparation timelines across Pakistan.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {faqs.map((faq, i) => (
            <div class="p-8 rounded-3xl bg-white dark:bg-[#111827] border border-slate-200 dark:border-slate-800 shadow-xs">
              <div class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-amber-500/10 text-amber-800 dark:text-amber-300 border border-amber-500/20 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">
                  {i + 1}
                </span>
                <div>
                  <h4 class="text-base font-bold text-[#0A1128] dark:text-white mb-2">{faq.q}</h4>
                  <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{faq.a}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Bottom Conversion Callout -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <h3 class="text-2xl sm:text-3xl font-black text-[#0A1128] dark:text-white tracking-tight">
          Ready to Crack PTE 79+ on Your First Try?
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">
          Book your 1-on-1 diagnostic consultation to evaluate your speaking cadence and receive a targeted 30-day preparation strategy.
        </p>
        <div class="pt-2 flex justify-center gap-3">
          <a
            href="/contact"
            class="px-8 py-3.5 rounded-full font-bold text-xs bg-[#0A1128] hover:bg-slate-800 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 transition-colors shadow-md"
          >
            Start Your Preparation &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
