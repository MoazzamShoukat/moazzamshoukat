---
import { siteData } from '../data/siteData';
---

<section id="faqs" class="py-20 bg-white dark:bg-slate-950 relative">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs font-semibold uppercase tracking-wider mb-3">
        Common Questions
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Frequently Asked Questions
      </h2>
      <p class="mt-4 text-base text-slate-600 dark:text-slate-300">
        Got questions regarding immigration policies, language score cutoffs, or NAATI CCL? Here are quick answers.
      </p>
    </div>

    <!-- Accordion Items -->
    <div class="space-y-4">
      {siteData.faqs.map((faq, index) => (
        <details
          class="group rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800 p-5 sm:p-6 [&_summary::-webkit-details-marker]:hidden transition-all duration-200"
          open={index === 0}
        >
          <summary class="flex items-center justify-between cursor-pointer font-bold text-slate-900 dark:text-white text-base sm:text-lg select-none group-hover:text-blue-600 dark:group-hover:text-amber-400 transition-colors">
            <span>{faq.question}</span>
            <span class="ml-4 flex-shrink-0 transition-transform duration-200 group-open:rotate-180 text-slate-500 dark:text-slate-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-3 border-t border-slate-200/60 dark:border-slate-800 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>

    <div class="mt-12 text-center">
      <p class="text-sm text-slate-500 dark:text-slate-400">
        Have a specific question about your individual case?{' '}
        <a href="#contact" class="font-semibold text-blue-600 dark:text-amber-400 underline hover:no-underline">
          Send a direct message
        </a>
      </p>
    </div>

  </div>
</section>
