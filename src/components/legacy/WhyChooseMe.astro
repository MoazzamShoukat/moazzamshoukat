---
import { siteData } from '../data/siteData';
import Icon from './Icon.astro';

const steps = [
  {
    step: "01",
    title: "Eligibility & Points Diagnostic",
    description: "Detailed calculation of your Canada CRS or Australia Points Grid, assessing age, education, English level, and employment background."
  },
  {
    step: "02",
    title: "Test Preparation & Skills Assessment",
    description: "Targeted coaching for IELTS 8+ / PTE 79+ / NAATI CCL alongside meticulous CDR or RPL compilation for ACS, VETASSESS, or EA."
  },
  {
    step: "03",
    title: "EOI & State Nomination Strategy",
    description: "Optimized SkillSelect profiles and Express Entry pools, targeting state nomination streams with the highest draw probability."
  },
  {
    step: "04",
    title: "Invitation to Apply (ITA) & Lodgement",
    description: "Flawless compilation of police certificates, medicals, financial proof, and official forms to ensure swift visa approval."
  }
];
---

<section id="why-me" class="py-20 bg-slate-50 dark:bg-slate-900/40 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-950/70 text-blue-800 dark:text-blue-300 text-xs font-semibold uppercase tracking-wider mb-3">
        Credentials & Trust
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Why Clients Trust Moazzam Shoukat
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300">
        In an industry crowded with generic agencies and exaggerated promises, here is why students and migration candidates choose my practice.
      </p>
    </div>

    <!-- Credentials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
      {siteData.credentials.map((item) => (
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 shadow-xs hover:shadow-md transition-shadow space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/60 border border-amber-200/50 dark:border-amber-800/50 text-amber-600 dark:text-amber-400 flex items-center justify-center">
            <Icon name={item.icon} class="w-5 h-5" />
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">
            {item.title}
          </h3>
          <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>

    <!-- The 4-Step Road to Approval -->
    <div class="p-8 sm:p-12 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-bold text-amber-600 dark:text-amber-400 uppercase tracking-widest block mb-2">
          Structured Execution
        </span>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          Our 4-Step Roadmap to Visa Success
        </h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
          Clear, structured milestones so you always know exactly where your application stands.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {steps.map((st) => (
          <div class="relative p-5 rounded-2xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800 flex flex-col justify-between">
            <div>
              <span class="inline-block text-2xl font-black text-blue-600 dark:text-amber-400 mb-3">
                {st.step}
              </span>
              <h4 class="font-bold text-slate-900 dark:text-white text-base mb-2">
                {st.title}
              </h4>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                {st.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-200/60 dark:border-slate-800/60 flex items-center gap-1.5 text-xs text-blue-600 dark:text-amber-400 font-medium">
              <span>Phase milestone</span>
              <Icon name="arrow-right" class="w-3 h-3" />
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
