---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`p-6 sm:p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center sm:items-start gap-5 shadow-xs ${className}`}>
  <img
    src="/images/moazzam-opt.png"
    alt="Moazzam Shoukat - PTE, NAATI CCL & IELTS Trainer"
    width="100"
    height="100"
    class="w-20 h-20 rounded-2xl object-cover border border-amber-400/30 flex-shrink-0"
    loading="lazy"
  />
  <div class="space-y-2 text-center sm:text-left">
    <div class="flex flex-col sm:flex-row sm:items-center gap-2 justify-between">
      <div>
        <h4 class="text-base font-black text-[#0A1128] dark:text-white">
          <a href="/about/" class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors">
            Moazzam Shoukat
          </a>
        </h4>
        <p class="text-xs text-amber-700 dark:text-amber-400 font-semibold">
          PTE, NAATI CCL & IELTS Master Trainer &bull; Speech AI Researcher
        </p>
      </div>
      <a
        href="/about/"
        class="text-xs font-bold text-amber-700 dark:text-amber-400 hover:underline inline-flex items-center gap-1 self-center sm:self-auto"
      >
        <span>Full Profile</span>
        <span>&rarr;</span>
      </a>
    </div>
    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
      BS Computer Science graduate from Information Technology University (ITU) Lahore and published researcher with 7 papers in speech AI and acoustic processing. Specialized in 1-on-1 coaching for PTE 79+ Superior English, NAATI CCL Urdu, and Australian skills assessment documentation.
    </p>
  </div>
</div>
