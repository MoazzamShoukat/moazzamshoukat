---
interface Props {
  videoId?: string;
  title: string;
  description: string;
  uploadDate?: string;
  thumbnailUrl?: string;
}

const {
  videoId = "",
  title,
  description,
  uploadDate = "2026-10-15",
  thumbnailUrl = "https://moazzamshoukat.com/images/moazzam.png"
} = Astro.props;

const isConfigured = videoId && !videoId.includes("TODO");

const videoSchema = isConfigured ? {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": title,
  "description": description,
  "thumbnailUrl": [thumbnailUrl],
  "uploadDate": uploadDate,
  "embedUrl": `https://www.youtube-nocookie.com/embed/${videoId}`
} : null;
---

<div class="my-8 rounded-3xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-900 text-white shadow-xl">
  {isConfigured ? (
    <div class="aspect-video w-full">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${videoId}`}
        title={title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
        class="w-full h-full border-0"
      ></iframe>
      {videoSchema && (
        <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />
      )}
    </div>
  ) : (
    <!-- TODO: Video URL pending owner input. Supply YouTube video ID to activate VideoObject embed. -->
    <div class="p-8 sm:p-12 text-center space-y-4 bg-gradient-to-br from-slate-900 via-slate-800 to-[#0A1128]">
      <div class="w-14 h-14 rounded-2xl bg-amber-400/10 text-amber-400 border border-amber-400/20 flex items-center justify-center mx-auto text-2xl">
        ▶
      </div>
      <h4 class="text-lg font-bold text-white">{title}</h4>
      <p class="text-xs text-slate-300 max-w-md mx-auto leading-relaxed">{description}</p>
      <div class="inline-block px-3 py-1 rounded-full bg-amber-400/10 border border-amber-400/20 text-amber-300 text-[11px] font-mono">
        Video placeholder — awaiting owner video URL
      </div>
    </div>
  )}
</div>
