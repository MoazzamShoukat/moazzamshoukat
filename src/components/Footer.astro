---
import { siteData } from '../data/siteData';
import SiteLogo from './SiteLogo.astro';
---

<footer class="bg-[#0A1128] text-slate-300 dark:bg-[#070B14] border-t border-amber-500/20 pt-16 pb-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Grid Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 pb-14 border-b border-slate-800">
      
      <!-- Brand & Summary (4 cols) -->
      <div class="lg:col-span-3 space-y-5">
        <SiteLogo variant="footer" />

        <p class="text-xs text-slate-300/80 leading-relaxed max-w-sm">
          Bridging advanced speech AI research and software engineering with accredited, high-success immigration strategies for Canada and Australia, alongside master coaching for IELTS, PTE, and NAATI CCL Urdu.
        </p>

        <!-- Direct Contact Details -->
        <div class="pt-2 text-xs text-slate-300 space-y-2.5">
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span>{siteData.contact.location}</span>
          </div>

          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <a href={`mailto:${siteData.contact.email}`} class="hover:text-amber-300 transition-colors">
              {siteData.contact.email}
            </a>
          </div>

          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 012.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 01-1.26-4.36c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.98-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.12-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.12.17 1.78 2.71 4.31 3.8 2.53 1.09 2.53.73 2.99.69.45-.04 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
            </svg>
            <a href="https://wa.me/923280484399" target="_blank" rel="noopener noreferrer" class="hover:text-amber-300 font-bold transition-colors">
              +92-328-048-4399 (WhatsApp)
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Navigation (2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <h4 class="text-xs font-black text-amber-400 uppercase tracking-widest">Navigation</h4>
        <ul class="space-y-1.5 text-xs">
          <li><a href="/" class="hover:text-amber-300 transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-amber-300 transition-colors">About Moazzam</a></li>
          <li><a href="/research" class="hover:text-amber-300 transition-colors font-bold text-white">Research (7 Papers)</a></li>
          <li><a href="/experience" class="hover:text-amber-300 transition-colors">Experience</a></li>
          <li><a href="/education" class="hover:text-amber-300 transition-colors">Education</a></li>
          <li><a href="/skills" class="hover:text-amber-300 transition-colors">Skills Matrix</a></li>
          <li><a href="/success-stories" class="hover:text-amber-300 transition-colors font-bold text-amber-300">Success Stories</a></li>
          <li><a href="/pricing" class="hover:text-amber-300 transition-colors">Pricing & Fees</a></li>
          <li><a href="/blog" class="hover:text-amber-300 transition-colors">35 Guides</a></li>
        </ul>
      </div>

      <!-- Immigration & Language (2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <h4 class="text-xs font-black text-amber-400 uppercase tracking-widest">Immigration & English</h4>
        <ul class="space-y-1.5 text-xs">
          <li><a href="/canada-immigration" class="hover:text-amber-300 transition-colors flex items-center gap-1.5"><span>🍁</span> Canada PR</a></li>
          <li><a href="/australia-immigration" class="hover:text-amber-300 transition-colors flex items-center gap-1.5"><span>🦘</span> Australia GSM</a></li>
          <li><a href="/skills-assessment-australia" class="hover:text-amber-300 transition-colors flex items-center gap-1.5"><span>📊</span> Skills Audit</a></li>
          <li><a href="/student-visa" class="hover:text-amber-300 transition-colors flex items-center gap-1.5"><span>🎓</span> Student Visa</a></li>
          <li><a href="/ielts-coaching" class="hover:text-amber-300 transition-colors flex items-center gap-1.5"><span>🎯</span> IELTS 7.5+</a></li>
          <li><a href="/pte-coaching" class="hover:text-amber-300 transition-colors flex items-center gap-1.5"><span>⚡</span> PTE 79+</a></li>
          <li><a href="/naati-ccl-urdu" class="hover:text-amber-300 transition-colors flex items-center gap-1.5"><span>🗣️</span> NAATI CCL</a></li>
        </ul>
      </div>

      <!-- Technology & AI Services (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="text-xs font-black text-amber-400 uppercase tracking-widest">Technology & AI</h4>
        <ul class="space-y-1.5 text-xs">
          <li><a href="/application-development" class="hover:text-amber-300 transition-colors flex items-center gap-1.5"><span>💻</span> App Development</a></li>
          <li><a href="/web-development" class="hover:text-amber-300 transition-colors flex items-center gap-1.5"><span>🌐</span> Web Development</a></li>
          <li><a href="/data-engineering" class="hover:text-amber-300 transition-colors flex items-center gap-1.5"><span>🔀</span> Data Engineering</a></li>
          <li><a href="/data-scraping" class="hover:text-amber-300 transition-colors flex items-center gap-1.5"><span>🕷️</span> Web Scraping</a></li>
          <li><a href="/ai-development" class="hover:text-amber-300 transition-colors flex items-center gap-1.5"><span>🧠</span> AI & Speech AI</a></li>
          <li><a href="/ai-agentic-development" class="hover:text-amber-300 transition-colors flex items-center gap-1.5"><span>🤖</span> AI Agentic Systems</a></li>
        </ul>
      </div>

      <!-- Social & Consultation CTA (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <h4 class="text-xs font-black text-amber-400 uppercase tracking-widest">Connect & Consult</h4>
        <p class="text-xs text-slate-300/80">
          Schedule your profile assessment or discuss research collaborations.
        </p>

        <a
          href="/contact"
          class="inline-block w-full text-center py-2.5 px-4 rounded-full text-xs font-black bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 transition-colors shadow-md"
        >
          Book Consultation &rarr;
        </a>

        <!-- Social Icons Row -->
        <div class="flex flex-wrap gap-2 pt-2">
          <!-- LinkedIn -->
          <a
            href={siteData.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn Profile"
            class="w-8 h-8 rounded-lg flex items-center justify-center bg-slate-800 hover:bg-amber-500 hover:text-slate-950 text-white transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.738-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
          <!-- Google Scholar -->
          <a
            href={siteData.socials.scholar}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Google Scholar Profile"
            class="w-8 h-8 rounded-lg flex items-center justify-center bg-slate-800 hover:bg-amber-500 hover:text-slate-950 text-white transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/></svg>
          </a>
          <!-- Upwork -->
          <a
            href={siteData.socials.upwork}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Upwork Profile"
            class="w-8 h-8 rounded-lg flex items-center justify-center bg-slate-800 hover:bg-amber-500 hover:text-slate-950 text-white transition-colors text-xs font-black"
          >
            Up
          </a>
          <!-- Instagram -->
          <a
            href={siteData.socials.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram Profile"
            class="w-8 h-8 rounded-lg flex items-center justify-center bg-slate-800 hover:bg-amber-500 hover:text-slate-950 text-white transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <!-- Facebook -->
          <a
            href={siteData.socials.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook Profile"
            class="w-8 h-8 rounded-lg flex items-center justify-center bg-slate-800 hover:bg-amber-500 hover:text-slate-950 text-white transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Professional Disclaimer Section -->
    <div class="mt-10 pt-8 border-t border-slate-800/80">
      <div class="p-4 sm:p-5 rounded-2xl bg-slate-900/60 border border-slate-800/90 backdrop-blur-md">
        <div class="flex items-start gap-3.5">
          <div class="w-6 h-6 rounded-lg bg-amber-400/10 text-amber-400 flex items-center justify-center flex-shrink-0 mt-0.5 border border-amber-400/20">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
          <p class="text-xs leading-relaxed text-slate-400">
            <strong class="text-slate-200 font-bold uppercase tracking-wider text-[11px] block sm:inline mb-1 sm:mb-0 mr-1.5">Disclaimer:</strong>
            Moazzam Shoukat provides guidance and coaching for IELTS, PTE, NAATI CCL, and immigration-related information for Canada and Australia. This website does not provide legal immigration advice. Results may vary based on candidate background, official points changes, and government quotas. Always verify information with official government sources and registered migration authorities where required.
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Trust Line -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <div>
        &copy; {new Date().getFullYear()} {siteData.name}. All rights reserved.
      </div>
      <div class="flex items-center gap-6 text-[11px]">
        <span>Lahore, Pakistan</span>
        <span>&bull;</span>
        <span class="text-amber-400/90 font-medium">Empowering Global Careers & AI Breakthroughs</span>
        <span>&bull;</span>
        <a href="/privacy-policy" class="hover:text-amber-300 transition-colors">Privacy Policy & Ethics</a>
      </div>
    </div>

  </div>
</footer>
