---
import { siteData } from '../data/siteData';
---

<footer class="bg-stone-900 text-stone-300 dark:bg-[#0A0A0C] border-t border-stone-800 pt-16 pb-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Grid Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 pb-14 border-b border-stone-800">
      
      <!-- Brand & Summary (4 cols) -->
      <div class="lg:col-span-4 space-y-5">
        <a href="/" class="group flex items-center gap-3 select-none">
          <div class="w-10 h-10 rounded-2xl bg-white text-stone-950 flex items-center justify-center font-black text-sm tracking-widest shadow-xs group-hover:scale-105 transition-transform duration-200">
            MS
          </div>
          <div>
            <span class="block text-base font-extrabold text-white tracking-tight leading-tight group-hover:text-amber-400 transition-colors">
              {siteData.name}
            </span>
            <span class="block text-[11px] uppercase tracking-widest font-semibold text-stone-400">
              Senior Engineer • Immigration Advisor
            </span>
          </div>
        </a>

        <p class="text-xs text-stone-400 leading-relaxed max-w-sm">
          {siteData.tagline}
        </p>

        <!-- Direct Contact Details -->
        <div class="pt-2 text-xs text-stone-400 space-y-2">
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span>{siteData.contact.location}</span>
          </div>

          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-amber-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <a href={`mailto:${siteData.contact.email}`} class="hover:text-amber-400 transition-colors">
              {siteData.contact.email}
            </a>
          </div>

          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-emerald-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 012.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 01-1.26-4.36c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.98-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.12-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.12.17 1.78 2.71 4.31 3.8 2.53 1.09 2.53.73 2.99.69.45-.04 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
            </svg>
            <a href={siteData.contact.whatsapp} class="hover:text-emerald-400 transition-colors">
              {siteData.contact.phone}
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Page Links (2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <h4 class="text-xs font-bold text-white uppercase tracking-widest">Navigation</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-amber-400 transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-amber-400 transition-colors">About</a></li>
          <li><a href="/services" class="hover:text-amber-400 transition-colors">Services</a></li>
          <li><a href="/selected-work" class="hover:text-amber-400 transition-colors">Selected Work</a></li>
          <li><a href="/experience" class="hover:text-amber-400 transition-colors">Experience</a></li>
          <li><a href="/education-research" class="hover:text-amber-400 transition-colors">Research & Papers</a></li>
          <li><a href="/skills" class="hover:text-amber-400 transition-colors">Skills</a></li>
          <li><a href="/contact" class="hover:text-amber-400 transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Practice Areas (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="text-xs font-bold text-white uppercase tracking-widest">Practice Areas</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/immigration" class="hover:text-amber-400 transition-colors">Canada Express Entry & PNP</a></li>
          <li><a href="/immigration" class="hover:text-amber-400 transition-colors">Australia GSM (189/190/491)</a></li>
          <li><a href="/immigration" class="hover:text-amber-400 transition-colors">Skills Assessment (ACS, EA, VETASSESS)</a></li>
          <li><a href="/immigration" class="hover:text-amber-400 transition-colors">Student Visa & SOP Drafting</a></li>
          <li><a href="/english-training" class="hover:text-amber-400 transition-colors">IELTS 8+ & PTE 79+ Masterclasses</a></li>
          <li><a href="/english-training" class="hover:text-amber-400 transition-colors">NAATI CCL Urdu (+5 PR Points)</a></li>
        </ul>
      </div>

      <!-- Verified Social Icons & Channels (3 cols) -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="text-xs font-bold text-white uppercase tracking-widest">Connect & Follow</h4>
        <p class="text-xs text-stone-400">
          Reach out directly across professional and coaching platforms.
        </p>

        <!-- Premium Modern Social Media Icons Row -->
        <div class="flex flex-wrap gap-2.5 pt-1">
          
          <!-- LinkedIn -->
          <a
            href={siteData.socials.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="w-10 h-10 rounded-full flex items-center justify-center bg-stone-800 text-stone-300 hover:bg-blue-600 hover:text-white transition-all duration-300 transform hover:-translate-y-1 hover:shadow-md"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.738-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>

          <!-- Google Scholar -->
          <a
            href={siteData.socials.scholar}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Google Scholar"
            class="w-10 h-10 rounded-full flex items-center justify-center bg-stone-800 text-stone-300 hover:bg-amber-400 hover:text-stone-950 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-md"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.87a7.006 7.006 0 0 1 14.324 0L24 9.5 12 0z"/>
            </svg>
          </a>

          <!-- Upwork -->
          <a
            href={siteData.socials.upwork}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Upwork"
            class="w-10 h-10 rounded-full flex items-center justify-center bg-stone-800 text-stone-300 hover:bg-emerald-500 hover:text-white transition-all duration-300 transform hover:-translate-y-1 hover:shadow-md"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M18.561 13.158c-1.102 0-2.135-.467-3.074-1.227l.228-1.076.008-.042c.207-1.143.849-3.06 2.839-3.06 1.492 0 2.703 1.212 2.703 2.703-.001 1.489-1.212 2.702-2.704 2.702zm0-8.14c-3.239 0-5.32 2.213-5.836 4.332-1.394-2.079-2.458-4.502-3.042-6.505h-3.418v8.694c0 1.764-1.435 3.199-3.199 3.199s-3.199-1.435-3.199-3.199v-8.694h-3.418v8.694c0 3.649 2.969 6.618 6.617 6.618 3.649 0 6.618-2.969 6.618-6.618v-.812c.571 1.411 1.401 2.943 2.458 4.259l-2.078 9.771h3.488l1.497-7.039c1.234.789 2.656 1.258 4.116 1.258 3.649 0 6.617-2.969 6.617-6.618 0-3.648-2.968-6.618-6.617-6.618z"/>
            </svg>
          </a>

          <!-- Instagram (Personal) -->
          <a
            href={siteData.socials.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="w-10 h-10 rounded-full flex items-center justify-center bg-stone-800 text-stone-300 hover:bg-gradient-to-tr hover:from-amber-500 hover:via-pink-500 hover:to-purple-600 hover:text-white transition-all duration-300 transform hover:-translate-y-1 hover:shadow-md"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>

          <!-- Coaching Instagram (@coachingbyms) -->
          <a
            href={siteData.socials.coachingInstagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Coaching by MS Instagram"
            class="w-10 h-10 rounded-full flex items-center justify-center bg-stone-800 text-pink-400 hover:bg-pink-600 hover:text-white transition-all duration-300 transform hover:-translate-y-1 hover:shadow-md"
            title="Coaching by MS"
          >
            <span class="text-[10px] font-black tracking-tighter">CMS</span>
          </a>

          <!-- Facebook -->
          <a
            href={siteData.socials.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="w-10 h-10 rounded-full flex items-center justify-center bg-stone-800 text-stone-300 hover:bg-blue-600 hover:text-white transition-all duration-300 transform hover:-translate-y-1 hover:shadow-md"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.7 5H18V0h-3.808C10.596 0 9 1.583 9 4.615V8z"/>
            </svg>
          </a>

          <!-- WhatsApp -->
          <a
            href={siteData.contact.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="w-10 h-10 rounded-full flex items-center justify-center bg-stone-800 text-stone-300 hover:bg-emerald-500 hover:text-white transition-all duration-300 transform hover:-translate-y-1 hover:shadow-md"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 012.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 01-1.26-4.36c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.98-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.75-.67-1.26-1.5-1.41-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.12-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.12.17 1.78 2.71 4.31 3.8 2.53 1.09 2.53.73 2.99.69.45-.04 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/>
            </svg>
          </a>

          <!-- Email -->
          <a
            href={`mailto:${siteData.contact.email}`}
            aria-label="Email"
            class="w-10 h-10 rounded-full flex items-center justify-center bg-stone-800 text-stone-300 hover:bg-amber-400 hover:text-stone-950 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-md"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </a>

        </div>

      </div>

    </div>

    <!-- Regulatory Notice & Bottom Copyright Bar -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-stone-400">
      <div class="text-center md:text-left max-w-2xl leading-relaxed">
        <strong class="text-stone-300">Disclaimer:</strong> Information and advisory are provided for educational and strategic guidance. Formal visa grants remain subject to sovereign migration departments (IRCC Canada & Dept of Home Affairs Australia).
      </div>
      <div class="text-center md:text-right flex-shrink-0 text-stone-400">
        © {new Date().getFullYear()} {siteData.name}. All rights reserved.
      </div>
    </div>

  </div>
</footer>
