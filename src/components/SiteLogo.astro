---
interface Props {
  variant?: 'header' | 'footer';
  className?: string;
}

const { variant = 'header', className = '' } = Astro.props;
---

<a href="/" class={`group inline-flex items-center gap-3 select-none flex-shrink-0 ${className}`}>
  <!-- Precision Architectural Tech Monogram Mark (MS with Neural Circuit & Orbital Spark) -->
  <div class="relative flex items-center justify-center w-11 h-11 sm:w-12 sm:h-12 rounded-2xl bg-gradient-to-br from-[#0A1128] via-[#0F172A] to-[#1A2644] dark:from-[#070C18] dark:to-[#131D33] p-[1.5px] shadow-md ring-1 ring-amber-400/30 group-hover:ring-amber-400/80 transition-all duration-300 group-hover:shadow-xl group-hover:shadow-amber-500/20 group-hover:scale-[1.04]">
    <div class="w-full h-full rounded-[14px] bg-gradient-to-br from-white/10 via-transparent to-amber-500/5 flex items-center justify-center backdrop-blur-md overflow-hidden p-1">
      <svg
        class="w-full h-full"
        viewBox="0 0 120 120"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-label="Moazzam Shoukat MS Monogram"
      >
        <defs>
          <!-- Luxury Champagne / Metallic Gold Gradient -->
          <linearGradient id="ms-gold-primary" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#FFF8DB" />
            <stop offset="25%" stop-color="#F5D77F" />
            <stop offset="60%" stop-color="#D4AF37" />
            <stop offset="100%" stop-color="#9E7820" />
          </linearGradient>

          <!-- Specular Bright Highlight Gradient -->
          <linearGradient id="ms-gold-highlight" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#C59A27" />
            <stop offset="45%" stop-color="#FFF2B2" />
            <stop offset="100%" stop-color="#FFFFFF" />
          </linearGradient>

          <!-- Dynamic Glowing Orbital Ring Gradient -->
          <linearGradient id="ms-orbit-glow" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#9E7820" stop-opacity="0.2" />
            <stop offset="35%" stop-color="#D4AF37" stop-opacity="0.75" />
            <stop offset="75%" stop-color="#F5D77F" stop-opacity="0.95" />
            <stop offset="100%" stop-color="#FFFFFF" stop-opacity="1" />
          </linearGradient>

          <!-- Subtle Star Spark Glow Filter -->
          <filter id="ms-star-glow" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="1.5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        <!-- Back Orbital Arc (passes subtly behind the letters) -->
        <path
          d="M 106 24 C 102 12, 84 16, 60 32 C 36 48, 18 70, 12 92"
          fill="none"
          stroke="url(#ms-orbit-glow)"
          stroke-width="1.2"
          stroke-dasharray="3.5 2.5"
          opacity="0.38"
        />

        <!-- Left Circuit Board / Neural Network Pattern of M -->
        <!-- Circuit Traces branching out from left stem -->
        <path
          d="M 34 38 L 22 38 L 16 32"
          fill="none"
          stroke="url(#ms-gold-primary)"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M 22 38 L 18 44"
          fill="none"
          stroke="url(#ms-gold-primary)"
          stroke-width="1.4"
          stroke-linecap="round"
        />
        <path
          d="M 34 50 L 16 50"
          fill="none"
          stroke="url(#ms-gold-primary)"
          stroke-width="1.8"
          stroke-linecap="round"
        />
        <path
          d="M 24 50 L 18 56"
          fill="none"
          stroke="url(#ms-gold-primary)"
          stroke-width="1.4"
          stroke-linecap="round"
        />
        <path
          d="M 34 66 L 24 76 L 15 76"
          fill="none"
          stroke="url(#ms-gold-primary)"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M 34 82 L 26 90 L 18 90"
          fill="none"
          stroke="url(#ms-gold-primary)"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />

        <!-- Neural Circuit Glowing Nodes / Pads -->
        <circle cx="16" cy="32" r="2.6" fill="url(#ms-gold-primary)" />
        <circle cx="16" cy="32" r="1.3" fill="#FFFDF0" />

        <circle cx="18" cy="44" r="1.8" fill="url(#ms-gold-primary)" />
        <circle cx="18" cy="44" r="0.9" fill="#FFFDF0" />

        <circle cx="16" cy="50" r="2.8" fill="url(#ms-gold-primary)" />
        <circle cx="16" cy="50" r="1.4" fill="#FFFDF0" />

        <circle cx="18" cy="56" r="2.0" fill="url(#ms-gold-primary)" />
        <circle cx="18" cy="56" r="1.0" fill="#FFFDF0" />

        <circle cx="15" cy="76" r="2.6" fill="url(#ms-gold-primary)" />
        <circle cx="15" cy="76" r="1.3" fill="#FFFDF0" />

        <circle cx="18" cy="90" r="2.4" fill="url(#ms-gold-primary)" />
        <circle cx="18" cy="90" r="1.1" fill="#FFFDF0" />

        <!-- Solder Junction Dots along the M Stem -->
        <circle cx="34" cy="38" r="1.8" fill="url(#ms-gold-highlight)" />
        <circle cx="34" cy="50" r="1.8" fill="url(#ms-gold-highlight)" />
        <circle cx="34" cy="66" r="1.8" fill="url(#ms-gold-highlight)" />

        <!-- Monogram Letter M (Geometric Architecture) -->
        <path
          d="M 34 84 L 34 36 L 50 62 L 66 36 L 66 84"
          fill="none"
          stroke="url(#ms-gold-primary)"
          stroke-width="5.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />

        <!-- Monogram Letter S (Smooth Executive Curve) -->
        <path
          d="M 96 44 C 96 38, 89 35, 83 35 C 75 35, 71 40, 71 47 C 71 58, 97 60, 97 73 C 97 81, 91 85, 83 85 C 75 85, 70 81, 70 75"
          fill="none"
          stroke="url(#ms-gold-primary)"
          stroke-width="5.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />

        <!-- Front Dynamic Orbital Ring (curves from bottom-left to top-right) -->
        <path
          d="M 12 92 C 14 103, 34 104, 58 90 C 82 76, 98 52, 106 24"
          fill="none"
          stroke="url(#ms-orbit-glow)"
          stroke-width="2.2"
          stroke-linecap="round"
        />

        <!-- Radiant Star / Spark at the Top-Right End of Orbit -->
        <g filter="url(#ms-star-glow)">
          <!-- 4-point Diamond Star Flare -->
          <path
            d="M 106 14 Q 106 24, 116 24 Q 106 24, 106 34 Q 106 24, 96 24 Q 106 24, 106 14 Z"
            fill="url(#ms-gold-highlight)"
          />
          <!-- Diagonal micro rays -->
          <line x1="100" y1="18" x2="112" y2="30" stroke="#FFF5C0" stroke-width="0.8" opacity="0.8" />
          <line x1="112" y1="18" x2="100" y2="30" stroke="#FFF5C0" stroke-width="0.8" opacity="0.8" />
          <!-- Brilliant Core Dot -->
          <circle cx="106" cy="24" r="2.0" fill="#FFFFFF" />
        </g>
      </svg>
    </div>
  </div>

  <!-- Refined Executive Typography Beside Monogram -->
  <div class="flex flex-col">
    <div class="flex items-center gap-1.5">
      <span class="text-[17px] sm:text-[18px] font-black tracking-tight text-[#0A1128] dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors leading-tight">
        Moazzam Shoukat
      </span>
      <span class="w-1.5 h-1.5 rounded-full bg-gradient-to-tr from-amber-500 to-amber-300 shadow-xs flex-shrink-0"></span>
    </div>
    <span class="text-[9.5px] sm:text-[10px] uppercase tracking-[0.16em] font-bold text-slate-500 dark:text-amber-400/80 group-hover:text-amber-700 dark:group-hover:text-amber-300 transition-colors">
      AI Researcher &bull; Immigration Expert
    </span>
  </div>
</a>
