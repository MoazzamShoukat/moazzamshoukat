---
import { siteData } from '../data/siteData';
---

<section class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-28">
  <!-- Subtle decorative ambient lights -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gradient-to-tr from-blue-600/15 via-indigo-600/10 to-amber-500/15 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute -top-10 right-0 w-80 h-80 bg-blue-500/10 rounded-full blur-2xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Content Column -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-6">
        
        <!-- Trust Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800 text-blue-700 dark:text-blue-300 text-xs sm:text-sm font-medium shadow-xs">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Canada & Australia Immigration Specialist • Certified Language Trainer</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.15]">
          Turn Your Global Dreams Into <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-amber-500 dark:from-blue-400 dark:via-indigo-300 dark:to-amber-400 bg-clip-text text-transparent">Approved Reality</span>
        </h1>

        <!-- Subheading -->
        <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto lg:mx-0 font-normal leading-relaxed">
          I am <strong class="text-slate-900 dark:text-white font-semibold">{siteData.name}</strong>. I guide ambitious students, skilled professionals, and families through Canadian & Australian permanent residency, visas, skills assessments, and high-scoring IELTS, PTE & NAATI CCL preparation.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href="#contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 text-base font-semibold text-slate-950 bg-amber-400 hover:bg-amber-300 rounded-xl shadow-lg shadow-amber-500/20 hover:shadow-amber-500/30 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
          >
            <span>Book Consultation</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="#services"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 text-base font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm hover:shadow transition-all"
          >
            <span>Explore Services</span>
          </a>
        </div>

        <!-- Quick Highlight Badges -->
        <div class="pt-4 flex flex-wrap items-center justify-center lg:justify-start gap-2.5 text-xs font-medium text-slate-600 dark:text-slate-400">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/70 border border-slate-200/60 dark:border-slate-700/60">
            🍁 Canada Express Entry & PNP
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/70 border border-slate-200/60 dark:border-slate-700/60">
            🦘 Australia Subclass 189, 190, 491
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/70 border border-slate-200/60 dark:border-slate-700/60">
            🎯 IELTS Band 8+ & PTE 79+
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/70 border border-slate-200/60 dark:border-slate-700/60">
            🇵🇰 NAATI CCL Urdu (5 Points)
          </span>
        </div>

      </div>

      <!-- Right Visual Card / Profile Overview -->
      <div class="lg:col-span-5 relative flex justify-center">
        <div class="w-full max-w-md bg-gradient-to-b from-white to-slate-50/80 dark:from-slate-900 dark:to-slate-950 p-6 sm:p-8 rounded-3xl border border-slate-200/90 dark:border-slate-800 shadow-2xl relative overflow-hidden">
          
          <div class="absolute top-0 right-0 w-36 h-36 bg-amber-400/10 rounded-full blur-2xl"></div>

          <!-- Header badge of card -->
          <div class="flex items-center justify-between pb-6 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-3">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-blue-700 via-indigo-600 to-amber-500 p-0.5 shadow-md flex-shrink-0">
                <div class="w-full h-full bg-slate-900 rounded-[14px] flex items-center justify-center text-white font-bold text-xl">
                  MS
                </div>
              </div>
              <div>
                <h3 class="font-bold text-slate-900 dark:text-white text-base">Moazzam Shoukat</h3>
                <p class="text-xs text-amber-600 dark:text-amber-400 font-medium">Licensed & Verified Advisory</p>
              </div>
            </div>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300">
              Active Intake 2026
            </span>
          </div>

          <!-- Service Focus Checklist -->
          <div class="py-6 space-y-3.5">
            <div class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300">
              <div class="w-5 h-5 rounded-full bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0 mt-0.5">✓</div>
              <div>
                <strong class="font-semibold text-slate-900 dark:text-white">Immigration Strategy:</strong> Express Entry, PNP & Australia GSM Points Maxima
              </div>
            </div>
            <div class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300">
              <div class="w-5 h-5 rounded-full bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0 mt-0.5">✓</div>
              <div>
                <strong class="font-semibold text-slate-900 dark:text-white">Australia Skills Assessment:</strong> ACS, VETASSESS, Engineers Australia (CDR)
              </div>
            </div>
            <div class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300">
              <div class="w-5 h-5 rounded-full bg-blue-100 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center flex-shrink-0 mt-0.5">✓</div>
              <div>
                <strong class="font-semibold text-slate-900 dark:text-white">English Exams:</strong> IELTS 8+, PTE 79+, TOEFL iBT, Duolingo
              </div>
            </div>
            <div class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300">
              <div class="w-5 h-5 rounded-full bg-amber-100 dark:bg-amber-950 text-amber-600 dark:text-amber-400 flex items-center justify-center flex-shrink-0 mt-0.5">✓</div>
              <div>
                <strong class="font-semibold text-slate-900 dark:text-white">NAATI CCL Urdu:</strong> First-Attempt Pass Methodology for +5 PR Points
              </div>
            </div>
          </div>

          <!-- Quick Consultation Card Foot -->
          <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <div>
              <p class="text-xs text-slate-500 dark:text-slate-400">Direct Case Inquiries</p>
              <p class="text-sm font-semibold text-slate-900 dark:text-white">{siteData.email}</p>
            </div>
            <a
              href="#contact"
              class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-blue-50 hover:bg-blue-100 dark:bg-blue-950 dark:hover:bg-blue-900 text-blue-700 dark:text-blue-300 transition-colors"
            >
              Get Free Evaluation →
            </a>
          </div>

        </div>
      </div>

    </div>

    <!-- Stats Bar -->
    <div class="mt-16 sm:mt-20 pt-10 border-t border-slate-200/80 dark:border-slate-800/80">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8">
        {siteData.stats.map((stat) => (
          <div class="p-4 rounded-2xl bg-white/60 dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-800/60 text-center sm:text-left transition-all hover:border-amber-400/40">
            <div class="text-3xl sm:text-4xl font-extrabold text-blue-600 dark:text-amber-400 tracking-tight">
              {stat.value}
            </div>
            <div class="text-sm font-semibold text-slate-900 dark:text-white mt-1">
              {stat.label}
            </div>
            {stat.sublabel && (
              <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                {stat.sublabel}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
