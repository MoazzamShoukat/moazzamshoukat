---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

const bands = [
  {
    band: "9.0",
    title: "Expert User",
    clb: "CLB 10+",
    pointsAus: "20 Points",
    desc: "Complete operational command of the language. Fluent, accurate, and completely articulate across all professional registers.",
    tag: "Native Mastery",
    accent: "border-amber-400 bg-amber-400/10 text-amber-500"
  },
  {
    band: "8.0 - 8.5",
    title: "Very Good User",
    clb: "CLB 10",
    pointsAus: "20 Points (Superior)",
    desc: "Fully operational command with occasional unsystematic inaccuracies. Maximum human capital points for Canada Express Entry & Australia PR.",
    tag: "Target for PR Maximums",
    accent: "border-amber-500 bg-amber-500/10 text-amber-400"
  },
  {
    band: "7.0 - 7.5",
    title: "Good User",
    clb: "CLB 9 / 10",
    pointsAus: "10 Points (Proficient)",
    desc: "Operational command with occasional inaccuracies and misunderstandings in some situations. Unlocks Canada CLB 9 skill transferability bonus.",
    tag: "The Golden PR Benchmark",
    accent: "border-sky-500 bg-sky-500/10 text-sky-400"
  },
  {
    band: "6.0 - 6.5",
    title: "Competent User",
    clb: "CLB 7 / 8",
    pointsAus: "0 Points (Competent)",
    desc: "Generally effective command with some inaccuracies. Standard university admission baseline, but zero points in Australian GSM.",
    tag: "Admission Baseline",
    accent: "border-slate-500 bg-slate-500/10 text-slate-400"
  }
];
---

<div class={`rounded-3xl bg-white dark:bg-[#0F172A] border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm ${className}`}>
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-6 border-b border-slate-100 dark:border-slate-800 gap-4">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-widest bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20 mb-2">
        INFOGRAPHIC &bull; IELTS SCORING MATRIX
      </div>
      <h3 class="text-2xl font-black text-[#0A1128] dark:text-white tracking-tight">
        IELTS Band Score & Immigration Equivalency Guide
      </h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">
        Direct correlation between official Cambridge IELTS Bands, Canadian CLB, and Australian PR Points.
      </p>
    </div>
    <div class="flex items-center gap-2 text-xs font-bold px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-amber-300 flex-shrink-0">
      <span>🎯 Goal: Band 7.5+ (CLB 9/10)</span>
    </div>
  </div>

  <!-- Interactive Grid Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    {bands.map((b) => (
      <div class="rounded-2xl p-5 bg-slate-50 dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800/80 flex flex-col justify-between hover:border-amber-400/50 transition-all group">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-2xl font-black text-[#0A1128] dark:text-amber-400 tracking-tight group-hover:scale-105 transition-transform">
              {b.band}
            </span>
            <span class={`text-[9px] font-extrabold px-2 py-0.5 rounded-full border ${b.accent}`}>
              {b.tag}
            </span>
          </div>
          <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-1">
            {b.title}
          </h4>
          <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-relaxed">
            {b.desc}
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-slate-200/70 dark:border-slate-800 text-[11px] space-y-1">
          <div class="flex justify-between">
            <span class="text-slate-500 dark:text-slate-400">Canada CLB:</span>
            <strong class="text-slate-900 dark:text-amber-300">{b.clb}</strong>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500 dark:text-slate-400">Australia PR:</span>
            <strong class="text-slate-900 dark:text-white">{b.pointsAus}</strong>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
