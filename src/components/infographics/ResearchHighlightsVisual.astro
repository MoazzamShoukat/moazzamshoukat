---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

const pillars = [
  {
    icon: "🔬",
    title: "Transformers in Speech",
    badge: "Computer Science Review (2025)",
    papers: "2 Landmark Surveys",
    desc: "Overcoming self-attention quadratic complexity O(T^2) in high-sample audio through conformers, subsampling, and chunked inference.",
    tags: ["Conformers", "Self-Attention", "wav2vec 2.0"]
  },
  {
    icon: "🔊",
    title: "Large Audio Models (LAMs)",
    badge: "Multimodal Foundation AI (2023)",
    papers: "Survey & Outlook",
    desc: "Tokenizing continuous soundscapes via neural audio codecs (EnCodec) to power real-time, low-latency generative speech agents.",
    tags: ["Neural Codecs", "Zero-Shot Synthesis", "Audio LLMs"]
  },
  {
    icon: "🩺",
    title: "Internet of Audio Things (IoAuT)",
    badge: "Acoustic Healthcare Sensing (2024)",
    papers: "Medical Acoustic Systems",
    desc: "Extracting non-invasive biometric telemetry from respiratory and cardiac acoustics using edge spectrogram neural classifiers.",
    tags: ["Biomarkers", "Edge Audio", "Preventative Care"]
  },
  {
    icon: "🧠",
    title: "Affective Computing & Metaverse",
    badge: "Emotion AI Frontiers (2024 - 2026)",
    papers: "2 Affective Computing Papers",
    desc: "Multimodal cross-lingual speech emotion recognition enabling empathetic conversational avatars and synthetic voice defense.",
    tags: ["Cross-Lingual SER", "Virtual Avatars", "GenAI Safety"]
  }
];
---

<div class={`rounded-3xl bg-white dark:bg-[#0F172A] border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm ${className}`}>
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-8 border-b border-slate-100 dark:border-slate-800 gap-4">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-widest bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20 mb-2">
        INFOGRAPHIC &bull; RESEARCH ARCHITECTURE
      </div>
      <h3 class="text-2xl font-black text-[#0A1128] dark:text-white tracking-tight">
        Moazzam Shoukat's AI & Speech Research Taxonomy
      </h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">
        Mapping 7 peer-reviewed publications across foundation audio architectures, healthcare acoustic sensing, and affective computing.
      </p>
    </div>
    <a
      href="https://scholar.google.com/citations?user=uU550yYAAAAJ"
      target="_blank"
      rel="noopener noreferrer"
      class="px-3.5 py-2 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-500/30 font-bold text-xs flex items-center gap-1.5 transition-colors flex-shrink-0"
    >
      <span>Google Scholar Profile</span>
      <span>&rarr;</span>
    </a>
  </div>

  <!-- 4 Taxonomy Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {pillars.map((p) => (
      <div class="p-5 rounded-2xl bg-slate-50 dark:bg-[#111827] border border-slate-200/80 dark:border-slate-800/80 flex flex-col justify-between hover:border-amber-400/50 transition-all group">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-2xl">{p.icon}</span>
            <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-slate-200/70 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
              {p.papers}
            </span>
          </div>

          <h4 class="text-sm font-black text-[#0A1128] dark:text-white mb-1">
            {p.title}
          </h4>
          <div class="text-[10px] font-bold text-amber-700 dark:text-amber-400 mb-2">
            {p.badge}
          </div>
          <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-relaxed">
            {p.desc}
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-slate-200/70 dark:border-slate-800 flex flex-wrap gap-1">
          {p.tags.map((t) => (
            <span class="text-[9px] px-1.5 py-0.5 rounded bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-medium">
              {t}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
