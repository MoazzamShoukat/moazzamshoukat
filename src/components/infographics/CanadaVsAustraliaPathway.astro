---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`rounded-3xl bg-white dark:bg-[#0F172A] border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm ${className}`}>
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-8 border-b border-slate-100 dark:border-slate-800 gap-4">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-widest bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20 mb-2">
        STRATEGIC PATHWAY COMPARISON
      </div>
      <h3 class="text-2xl font-black text-[#0A1128] dark:text-white tracking-tight">
        Canada Express Entry vs. Australia Skilled Migration
      </h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">
        Side-by-side architectural breakdown of immigration points, processing times, and English requirements.
      </p>
    </div>
  </div>

  <!-- Dual Comparison Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    
    <!-- Canada Card -->
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="text-2xl">🍁</span>
            <h4 class="text-lg font-black text-[#0A1128] dark:text-white">Canada Express Entry</h4>
          </div>
          <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20">
            CRS System
          </span>
        </div>

        <ul class="space-y-3 text-xs text-slate-700 dark:text-slate-300 mb-6">
          <li class="flex items-start gap-2.5">
            <span class="text-amber-500 font-bold">✓</span>
            <div><strong>Language Benchmark:</strong> CLB 9/10 (IELTS 8777 or PTE Core equivalent) unlocks maximum Skill Transferability CRS points.</div>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-amber-500 font-bold">✓</span>
            <div><strong>Target Draws:</strong> Category-based selection prioritizing STEM talent, healthcare professionals, and Francophones.</div>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-amber-500 font-bold">✓</span>
            <div><strong>PNP Booster:</strong> Provincial nomination adds +600 CRS points, guaranteeing an Invitation to Apply (ITA).</div>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-amber-500 font-bold">✓</span>
            <div><strong>Processing Velocity:</strong> Standard Express Entry processing aims for approximately 6 months post-ITA.</div>
          </li>
        </ul>
      </div>

      <a href="/canada-immigration/" class="block w-full text-center py-2.5 rounded-xl font-bold text-xs bg-[#0A1128] dark:bg-amber-400 text-white dark:text-slate-950 hover:opacity-90 transition-opacity">
        Explore Canada PR Pathways &rarr;
      </a>
    </div>

    <!-- Australia Card -->
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="text-2xl">🦘</span>
            <h4 class="text-lg font-black text-[#0A1128] dark:text-white">Australia Skilled Migration</h4>
          </div>
          <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
            SkillSelect GSM
          </span>
        </div>

        <ul class="space-y-3 text-xs text-slate-700 dark:text-slate-300 mb-6">
          <li class="flex items-start gap-2.5">
            <span class="text-amber-500 font-bold">✓</span>
            <div><strong>Language & NAATI:</strong> Superior PTE 79+ (+20 pts) combined with NAATI CCL Urdu (+5 pts) provides a critical 25-point surge.</div>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-amber-500 font-bold">✓</span>
            <div><strong>Visa Subclasses:</strong> Subclass 189 (Independent), Subclass 190 (+5 state points), and Subclass 491 (+15 regional points).</div>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-amber-500 font-bold">✓</span>
            <div><strong>Skills Assessment:</strong> Formal positive assessment required from ACS (IT), Engineers Australia (CDR), or VETASSESS before EOI.</div>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-amber-500 font-bold">✓</span>
            <div><strong>Citizenship Path:</strong> Eligible for Australian citizenship after 4 years of lawful residence (including at least 1 year as PR).</div>
          </li>
        </ul>
      </div>

      <a href="/australia-skilled-migration/" class="block w-full text-center py-2.5 rounded-xl font-bold text-xs bg-[#0A1128] dark:bg-amber-400 text-white dark:text-slate-950 hover:opacity-90 transition-opacity">
        Explore Australia PR Pathways &rarr;
      </a>
    </div>

  </div>
</div>
