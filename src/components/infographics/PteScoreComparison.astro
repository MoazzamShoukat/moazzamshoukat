---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

const scales = [
  {
    pte: "84 - 90",
    ielts: "Band 8.5 - 9.0",
    cefr: "C2 Mastery",
    ausPoints: "20 Points (Superior)",
    canClb: "CLB 10+",
    highlight: true,
    desc: "Flawless AI speech recognition score. Maximum possible immigration points across Australia GSM & Canada."
  },
  {
    pte: "79 - 83",
    ielts: "Band 8.0",
    cefr: "C1 Advanced",
    ausPoints: "20 Points (Superior)",
    canClb: "CLB 9 / 10",
    highlight: true,
    desc: "The critical Superior English threshold. Immediately awards 20 points for Subclasses 189, 190, and 491."
  },
  {
    pte: "65 - 78",
    ielts: "Band 7.0 - 7.5",
    cefr: "B2 / C1",
    ausPoints: "10 Points (Proficient)",
    canClb: "CLB 8 / 9",
    highlight: false,
    desc: "Proficient English level. Solid for state sponsorships and postgraduate university admissions."
  },
  {
    pte: "58 - 64",
    ielts: "Band 6.5",
    cefr: "B2 Vantage",
    ausPoints: "0 Points (Competent)",
    canClb: "CLB 7",
    highlight: false,
    desc: "Standard Bachelor/Master direct entry baseline for Australia and Canada universities."
  },
  {
    pte: "50 - 57",
    ielts: "Band 6.0",
    cefr: "B2 Baseline",
    ausPoints: "0 Points (Competent)",
    canClb: "CLB 6",
    highlight: false,
    desc: "Minimum threshold to fulfill basic Australian Subclass 500 student visa requirements."
  }
];
---

<div class={`rounded-3xl bg-white dark:bg-[#0F172A] border border-slate-200 dark:border-slate-800 p-6 sm:p-8 shadow-sm ${className}`}>
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-6 border-b border-slate-100 dark:border-slate-800 gap-4">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-widest bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20 mb-2">
        INFOGRAPHIC &bull; PTE VS IELTS CALIBRATION
      </div>
      <h3 class="text-2xl font-black text-[#0A1128] dark:text-white tracking-tight">
        PTE Academic Score Conversion & PR Points Matrix
      </h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">
        Official concordance between Pearson PTE Academic, IELTS Bands, and immigration allocation rules.
      </p>
    </div>
    <div class="px-3.5 py-2 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-700 dark:text-amber-300 font-bold text-xs flex-shrink-0">
      ⚡ 79+ = +20 Australia Points
    </div>
  </div>

  <!-- Comparison Table Grid -->
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse text-xs">
      <thead>
        <tr class="border-b border-slate-200 dark:border-slate-800 text-[11px] font-black uppercase text-slate-400">
          <th class="py-3 px-4">PTE Academic</th>
          <th class="py-3 px-4">IELTS Equivalent</th>
          <th class="py-3 px-4">CEFR Level</th>
          <th class="py-3 px-4">Australia PR Points</th>
          <th class="py-3 px-4">Canada CLB</th>
          <th class="py-3 px-4">Strategic Impact</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 dark:divide-slate-800/60">
        {scales.map((row) => (
          <tr class={`transition-colors ${row.highlight ? 'bg-amber-500/5 dark:bg-amber-400/5 font-semibold' : 'hover:bg-slate-50 dark:hover:bg-slate-800/40'}`}>
            <td class="py-3.5 px-4 font-black text-[#0A1128] dark:text-amber-400 text-sm">
              {row.pte}
            </td>
            <td class="py-3.5 px-4 font-bold text-slate-800 dark:text-white">
              {row.ielts}
            </td>
            <td class="py-3.5 px-4 text-slate-500 dark:text-slate-400">
              {row.cefr}
            </td>
            <td class="py-3.5 px-4">
              <span class={`inline-block px-2.5 py-1 rounded-full text-[10px] font-extrabold ${row.highlight ? 'bg-amber-500/20 text-amber-800 dark:text-amber-300 border border-amber-500/30' : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400'}`}>
                {row.ausPoints}
              </span>
            </td>
            <td class="py-3.5 px-4 font-semibold text-slate-700 dark:text-slate-300">
              {row.canClb}
            </td>
            <td class="py-3.5 px-4 text-[11px] text-slate-500 dark:text-slate-400 max-w-xs">
              {row.desc}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
