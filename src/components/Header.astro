---
import ThemeToggle from './ThemeToggle.astro';
import SiteLogo from './SiteLogo.astro';
import { headerNav } from '../data/navData';

const currentPath = Astro.url.pathname.replace(/\/$/, "");

function isActive(path: string) {
  const clean = path.replace(/\/$/, "");
  if (clean === "" && currentPath === "") return true;
  if (clean !== "" && currentPath === clean) return true;
  if (clean !== "" && currentPath.startsWith(clean)) return true;
  return false;
}
---

<!-- Top Contact & Advisory Bar: Minimal & Elegant -->
<div class="bg-[#0A1128]/95 backdrop-blur-md text-slate-300 text-xs py-2 px-4 border-b border-amber-500/15 hidden md:block">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <div class="flex items-center gap-6">
      <div class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span>Lahore, Pakistan &bull; Online Classes for Pakistan, Australia & Worldwide</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        <a href="mailto:moazzamshoukat1@gmail.com" class="hover:text-amber-300 transition-colors">
          moazzamshoukat1@gmail.com
        </a>
      </div>
    </div>
    <div class="flex items-center gap-4 text-[11px]">
      <span class="inline-flex items-center gap-1.5 text-amber-300/90 font-medium">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        PTE &bull; NAATI CCL Urdu &bull; IELTS &bull; Australia PR Points & Skills Guidance
      </span>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header
  id="main-header"
  class="sticky top-0 z-50 w-full crystal-glass-header transition-all duration-300 ease-out"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo -->
      <SiteLogo variant="header" />

      <!-- Desktop Navigation (5-7 top-level items + short dropdowns) -->
      <nav class="hidden lg:flex items-center gap-1 text-[13px] font-semibold" aria-label="Main Navigation">
        {headerNav.map((item) => {
          if (item.children && item.children.length > 0) {
            return (
              <div class="relative group">
                <a
                  href={item.href}
                  class={`px-3 py-2 rounded-lg inline-flex items-center gap-1.5 transition-all cursor-pointer ${
                    isActive(item.href)
                      ? 'text-amber-700 dark:text-amber-400 bg-amber-500/10 dark:bg-amber-400/10 font-bold'
                      : 'text-slate-700 dark:text-slate-300 hover:text-amber-700 dark:hover:text-amber-400 hover:bg-slate-100/60 dark:hover:bg-white/5'
                  }`}
                >
                  <span>{item.label}</span>
                  <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-amber-600 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>
                
                <div class="absolute left-0 top-full pt-2 w-80 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 z-50">
                  <div class="p-3 rounded-2xl bg-white/95 dark:bg-[#0C1324]/95 backdrop-blur-2xl border border-slate-200/80 dark:border-white/10 shadow-2xl shadow-slate-900/15 space-y-1">
                    {item.children.map((sub) => (
                      <a
                        href={sub.href}
                        class="block p-2.5 rounded-xl hover:bg-amber-500/10 dark:hover:bg-amber-400/10 transition-colors group/sub"
                      >
                        <div class="font-bold text-slate-900 dark:text-white text-xs group-hover/sub:text-amber-700 dark:group-hover/sub:text-amber-400">
                          {sub.label}
                        </div>
                        {sub.description && (
                          <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
                            {sub.description}
                          </div>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={item.href}
              class={`px-3 py-2 rounded-lg transition-all ${
                isActive(item.href)
                  ? 'text-amber-700 dark:text-amber-400 bg-amber-500/10 dark:bg-amber-400/10 font-bold'
                  : 'text-slate-700 dark:text-slate-300 hover:text-amber-700 dark:hover:text-amber-400 hover:bg-slate-100/60 dark:hover:bg-white/5'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right Header Actions (Phone, Theme Toggle & Consultation CTA) -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        <a
          href="tel:+923280484399"
          class="w-10 h-10 rounded-full flex items-center justify-center bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:text-amber-600 dark:hover:text-amber-400 hover:bg-amber-500/10 dark:hover:bg-amber-400/10 transition-colors"
          aria-label="Direct Phone Call to +92-328-048-4399"
          title="Direct Call: +92-328-048-4399"
          data-track-phone="header_top"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z"/>
          </svg>
        </a>

        <ThemeToggle />

        <a
          href="/contact/"
          class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs font-black bg-[#0A1128] hover:bg-slate-900 text-white dark:bg-amber-400 dark:hover:bg-amber-300 dark:text-slate-950 transition-all shadow-md group cursor-pointer border border-amber-500/20"
        >
          <svg class="w-3.5 h-3.5 text-amber-400 dark:text-slate-950 shrink-0 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <span class="tracking-wide">Book Consultation</span>
          <svg class="w-3 h-3 text-amber-400/80 dark:text-slate-950/70 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>

        <!-- Mobile Hamburger Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          class="w-10 h-10 flex flex-col justify-center items-center gap-1.5 text-slate-700 dark:text-slate-300 hover:text-amber-600 dark:hover:text-amber-400 focus:outline-none cursor-pointer p-2 lg:hidden"
        >
          <span id="bar-1" class="w-5 h-[2px] bg-current rounded-full transition-all duration-300 transform origin-center"></span>
          <span id="bar-2" class="w-5 h-[2px] bg-current rounded-full transition-all duration-300"></span>
          <span id="bar-3" class="w-5 h-[2px] bg-current rounded-full transition-all duration-300 transform origin-center"></span>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu (Reuses headerNav data source) -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-slate-200/50 dark:border-white/10 bg-white/95 dark:bg-[#070D1D]/95 backdrop-blur-2xl px-5 pt-4 pb-8 space-y-4 transition-all duration-300 max-h-[85vh] overflow-y-auto"
  >
    <div class="space-y-2">
      {headerNav.map((item) => (
        <div>
          <a
            href={item.href}
            class={`block p-3 rounded-xl font-bold text-xs ${
              isActive(item.href)
                ? 'bg-amber-500/10 text-amber-700 dark:text-amber-400 font-extrabold'
                : 'bg-slate-50 dark:bg-slate-800/60 text-slate-900 dark:text-white'
            }`}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="pl-3 pt-1 space-y-1">
              {item.children.map((sub) => (
                <a
                  href={sub.href}
                  class="block p-2 rounded-lg text-[11px] font-semibold text-slate-600 dark:text-slate-300 hover:text-amber-700 dark:hover:text-amber-400 hover:bg-slate-100 dark:hover:bg-slate-800/40"
                >
                  &rarr; {sub.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <a
        href="/contact/"
        class="block p-3 rounded-xl bg-amber-500/10 text-amber-700 dark:text-amber-300 font-extrabold text-xs text-center"
      >
        Book Consultation
      </a>
    </div>

    <!-- Mobile Quick Call Button -->
    <div class="pt-4 border-t border-slate-200/50 dark:border-slate-800">
      <a
        href="tel:+923280484399"
        class="w-full py-3 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white text-center font-bold text-xs flex items-center justify-center gap-2"
        data-track-phone="mobile_drawer"
      >
        <span>Direct Phone Call (+92-328-048-4399)</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const bar1 = document.getElementById('bar-1');
  const bar2 = document.getElementById('bar-2');
  const bar3 = document.getElementById('bar-3');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', !isExpanded);
      menu.classList.toggle('hidden');
      if (!isExpanded) {
        bar1.classList.add('rotate-45', 'translate-y-2');
        bar2.classList.add('opacity-0');
        bar3.classList.add('-rotate-45', '-translate-y-2');
      } else {
        bar1.classList.remove('rotate-45', 'translate-y-2');
        bar2.classList.remove('opacity-0');
        bar3.classList.remove('-rotate-45', '-translate-y-2');
      }
    });
  }
</script>
