---
import ThemeToggle from './ThemeToggle.astro';
import { siteData } from '../data/siteData';

const currentPath = Astro.url.pathname.replace(/\/$/, "");

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/selected-work', label: 'Selected Work' },
  { href: '/immigration', label: 'Immigration' },
  { href: '/english-training', label: 'English & NAATI' },
  { href: '/experience', label: 'Experience' },
  { href: '/education-research', label: 'Research' },
  { href: '/skills', label: 'Skills' },
  { href: '/contact', label: 'Contact' },
];

function isActive(path: string) {
  const clean = path.replace(/\/$/, "");
  if (clean === "" && currentPath === "") return true;
  if (clean !== "" && currentPath === clean) return true;
  return false;
}
---

<header
  id="main-header"
  class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#FBFBFA]/85 dark:bg-[#121214]/85 border-b border-stone-200/60 dark:border-zinc-800/60 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo & Identity on Left -->
      <a href="/" class="group flex items-center gap-3 select-none flex-shrink-0">
        <div class="w-10 h-10 rounded-2xl bg-stone-900 text-white dark:bg-stone-100 dark:text-stone-950 flex items-center justify-center font-black text-sm tracking-widest shadow-2xs group-hover:scale-105 group-hover:shadow-xs transition-all duration-300">
          MS
        </div>
        <div class="flex flex-col">
          <span class="text-sm sm:text-base font-extrabold text-stone-900 dark:text-stone-100 tracking-tight leading-tight group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors duration-200">
            {siteData.name}
          </span>
          <span class="text-[10px] uppercase tracking-widest font-semibold text-stone-500 dark:text-stone-400">
            Tech • Research • Immigration
          </span>
        </div>
      </a>

      <!-- Desktop Navigation in Center / Right (xl screens show full set) -->
      <nav class="hidden xl:flex items-center gap-1 bg-stone-200/40 dark:bg-zinc-900/40 p-1.5 rounded-full border border-stone-200/60 dark:border-zinc-800/60 shadow-2xs">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class={`px-3 py-1.5 text-[12px] font-semibold rounded-full transition-all duration-200 ${
                active
                  ? 'text-stone-950 dark:text-white bg-white dark:bg-zinc-800 shadow-xs'
                  : 'text-stone-600 dark:text-stone-400 hover:text-stone-950 dark:hover:text-white hover:bg-white/70 dark:hover:bg-zinc-800/60'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Navigation for Large (lg to xl) screens (compact primary links) -->
      <nav class="hidden lg:flex xl:hidden items-center gap-1 text-xs">
        <a href="/" class={`px-2.5 py-1.5 rounded-full font-semibold transition-colors ${isActive('/') ? 'text-stone-950 dark:text-white bg-stone-200/60 dark:bg-zinc-800' : 'text-stone-600 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white'}`}>Home</a>
        <a href="/about" class={`px-2.5 py-1.5 rounded-full font-semibold transition-colors ${isActive('/about') ? 'text-stone-950 dark:text-white bg-stone-200/60 dark:bg-zinc-800' : 'text-stone-600 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white'}`}>About</a>
        <a href="/services" class={`px-2.5 py-1.5 rounded-full font-semibold transition-colors ${isActive('/services') ? 'text-stone-950 dark:text-white bg-stone-200/60 dark:bg-zinc-800' : 'text-stone-600 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white'}`}>Services</a>
        <a href="/selected-work" class={`px-2.5 py-1.5 rounded-full font-bold transition-colors ${isActive('/selected-work') ? 'text-amber-700 dark:text-amber-400 bg-amber-100/60 dark:bg-amber-950/40' : 'text-amber-600 dark:text-amber-400 hover:underline'}`}>Work</a>
        <a href="/immigration" class={`px-2.5 py-1.5 rounded-full font-semibold transition-colors ${isActive('/immigration') ? 'text-stone-950 dark:text-white bg-stone-200/60 dark:bg-zinc-800' : 'text-stone-600 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white'}`}>Immigration</a>
        <a href="/experience" class={`px-2.5 py-1.5 rounded-full font-semibold transition-colors ${isActive('/experience') ? 'text-stone-950 dark:text-white bg-stone-200/60 dark:bg-zinc-800' : 'text-stone-600 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white'}`}>Experience</a>
        <a href="/contact" class={`px-2.5 py-1.5 rounded-full font-semibold transition-colors ${isActive('/contact') ? 'text-stone-950 dark:text-white bg-stone-200/60 dark:bg-zinc-800' : 'text-stone-600 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white'}`}>Contact</a>
      </nav>

      <!-- Right Header Actions (Clean Icon-Only Toggle & CTA) -->
      <div class="hidden sm:flex items-center gap-3">
        <!-- Sun/Moon Icon-Only Toggle -->
        <ThemeToggle />

        <!-- Nova-Style Minimal CTA -->
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-4 py-2 text-xs font-bold text-stone-950 bg-amber-400 hover:bg-amber-300 dark:bg-amber-400 dark:hover:bg-amber-300 rounded-full shadow-2xs hover:shadow-xs transition-all duration-200 active:scale-95"
        >
          Let’s Talk →
        </a>
      </div>

      <!-- Mobile Right Controls (Toggle & Animated Hamburger) -->
      <div class="flex items-center gap-2 sm:gap-3 lg:hidden">
        <!-- Sun/Moon Icon-Only Toggle for Mobile -->
        <ThemeToggle />

        <!-- Modern Hamburger Button with Animated 3-Bar to X Transition -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          class="w-10 h-10 flex flex-col justify-center items-center gap-1.5 text-stone-700 dark:text-stone-300 hover:text-stone-950 dark:hover:text-white focus:outline-none cursor-pointer p-2"
        >
          <span
            id="bar-1"
            class="w-5 h-[2px] bg-current rounded-full transition-all duration-300 transform origin-center"
          ></span>
          <span
            id="bar-2"
            class="w-5 h-[2px] bg-current rounded-full transition-all duration-300"
          ></span>
          <span
            id="bar-3"
            class="w-5 h-[2px] bg-current rounded-full transition-all duration-300 transform origin-center"
          ></span>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu with Smooth Slide Down & Backdrop Blur -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-stone-200/70 dark:border-zinc-800/80 bg-[#FBFBFA]/95 dark:bg-[#121214]/95 backdrop-blur-xl px-5 pt-4 pb-8 space-y-1 transition-all duration-300"
  >
    <div class="grid grid-cols-2 gap-1.5 pb-3">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            class={`mobile-nav-link block px-3.5 py-2.5 text-xs font-bold rounded-xl transition-colors ${
              active
                ? 'text-stone-950 dark:text-white bg-stone-200/80 dark:bg-zinc-800 shadow-2xs'
                : 'text-stone-600 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-zinc-800/60'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </div>

    <div class="pt-2 border-t border-stone-200/60 dark:border-zinc-800/60">
      <a
        href="/contact"
        class="mobile-nav-link flex items-center justify-center w-full px-5 py-3 text-xs font-bold text-stone-950 bg-amber-400 hover:bg-amber-300 rounded-full shadow-xs transition-colors"
      >
        Start a Project / Consultation →
      </a>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const header = document.getElementById('main-header');
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const bar1 = document.getElementById('bar-1');
    const bar2 = document.getElementById('bar-2');
    const bar3 = document.getElementById('bar-3');
    const links = document.querySelectorAll('.mobile-nav-link');

    // Sticky Header Scroll Blur & Shadow Effect
    const handleScroll = () => {
      if (!header) return;
      if (window.scrollY > 15) {
        header.classList.add('shadow-xs', 'bg-[#FBFBFA]/95', 'dark:bg-[#121214]/95');
        header.classList.remove('bg-[#FBFBFA]/85', 'dark:bg-[#121214]/85');
      } else {
        header.classList.remove('shadow-xs', 'bg-[#FBFBFA]/95', 'dark:bg-[#121214]/95');
        header.classList.add('bg-[#FBFBFA]/85', 'dark:bg-[#121214]/85');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Modern Animated Hamburger Transition to X
    if (btn && menu && bar1 && bar2 && bar3) {
      let isOpen = false;

      const toggleMenu = () => {
        isOpen = !isOpen;
        btn.setAttribute('aria-expanded', isOpen.toString());

        if (isOpen) {
          menu.classList.remove('hidden');
          // Animate bars to X
          bar1.style.transform = 'translateY(5px) rotate(45deg)';
          bar2.style.opacity = '0';
          bar2.style.transform = 'scale(0)';
          bar3.style.transform = 'translateY(-5px) rotate(-45deg)';
        } else {
          menu.classList.add('hidden');
          // Reset bars
          bar1.style.transform = 'none';
          bar2.style.opacity = '1';
          bar2.style.transform = 'none';
          bar3.style.transform = 'none';
        }
      };

      btn.addEventListener('click', toggleMenu);

      links.forEach((link) => {
        link.addEventListener('click', () => {
          if (isOpen) toggleMenu();
        });
      });
    }
  }

  setupHeader();
  document.addEventListener('astro:after-swap', setupHeader);
</script>
