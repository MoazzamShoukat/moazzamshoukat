---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import { siteData } from '../data/siteData';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = "Moazzam Shoukat | PTE, NAATI CCL & IELTS Trainer",
  description = "Expert 1-on-1 coaching for PTE Academic, NAATI CCL Urdu, and IELTS in Lahore and online. Strategic guidance for Australian PR points and skills assessment.",
  ogImage = "/images/moazzam.png",
  ogType = "website",
  noindex = false,
  schema
} = Astro.props;

// Ensure normalized canonical URL with trailing slash for directory routes
let pathname = Astro.url.pathname;
if (!pathname.endsWith('/') && !pathname.includes('.')) {
  pathname += '/';
}
const canonicalUrl = new URL(pathname, Astro.site || "https://moazzamshoukat.com/").href;
const absoluteOgImage = new URL(ogImage, Astro.site || "https://moazzamshoukat.com/").href;

// SEO Title & Description Build-Time Length Validations
if (title && title.length > 60) {
  console.warn(`[SEO Warning] Title exceeds 60 characters (${title.length} chars): "${title}" on path ${pathname}`);
}
if (description && (description.length > 155 || description.length < 70)) {
  console.warn(`[SEO Warning] Description outside 70-155 characters (${description.length} chars): "${description}" on path ${pathname}`);
}

const baseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://moazzamshoukat.com/#website",
      "url": "https://moazzamshoukat.com/",
      "name": "Moazzam Shoukat",
      "description": "PTE Academic, NAATI CCL Urdu, and IELTS Coaching in Lahore and Online. Australia PR Points Guidance.",
      "inLanguage": "en-US",
      "publisher": {
        "@id": "https://moazzamshoukat.com/#person"
      }
    },
    {
      "@type": "Person",
      "@id": "https://moazzamshoukat.com/#person",
      "name": "Moazzam Shoukat",
      "url": "https://moazzamshoukat.com/",
      "image": "https://moazzamshoukat.com/images/moazzam.png",
      "jobTitle": "PTE, NAATI CCL & IELTS Master Trainer, Australia PR Guidance Specialist",
      "telephone": "+92-328-048-4399",
      "email": "moazzamshoukat1@gmail.com",
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "Information Technology University (ITU) Lahore"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lahore",
        "addressRegion": "Punjab",
        "addressCountry": "PK"
      },
      "knowsAbout": [
        "PTE Academic Preparation",
        "PTE Core Preparation",
        "IELTS Academic & General Training",
        "NAATI CCL Urdu",
        "Australian Skilled Migration (Subclass 189, 190, 491)",
        "Australian Skills Assessment (ACS, Engineers Australia, VETASSESS)"
      ],
      "sameAs": [
        "https://scholar.google.com/citations?user=uU550yYAAAAJ",
        "https://www.linkedin.com/in/moazzamshoukat/",
        "https://github.com/moazzamshoukat"
      ]
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://moazzamshoukat.com/#organization",
      "name": "Moazzam Shoukat Coaching & PR Guidance",
      "url": "https://moazzamshoukat.com/",
      "logo": "https://moazzamshoukat.com/favicon.svg",
      "image": "https://moazzamshoukat.com/images/moazzam.png",
      "telephone": "+92-328-048-4399",
      "email": "moazzamshoukat1@gmail.com",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lahore",
        "addressRegion": "Punjab",
        "addressCountry": "PK"
      },
      "areaServed": [
        {
          "@type": "City",
          "name": "Lahore"
        },
        {
          "@type": "Country",
          "name": "Pakistan"
        },
        {
          "@type": "Country",
          "name": "Australia"
        }
      ],
      "founder": {
        "@id": "https://moazzamshoukat.com/#person"
      }
    }
  ]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="google3f3b78b78c472c84" />

    <!-- Robots Directives -->
    <meta
      name="robots"
      content={noindex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta
      name="googlebot"
      content={noindex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />

    <!-- SEO Meta Tags (no keywords) -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteData.name} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social Sharing (Absolute URLs) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Moazzam Shoukat - PTE, NAATI CCL & IELTS Trainer" />
    <meta property="og:site_name" content={siteData.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Google Fonts Preconnect & Display Optimization -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400..700&display=swap" rel="stylesheet" />

    <!-- Base Schema.org JSON-LD -->
    <SchemaOrg schema={baseSchema} />
    
    <!-- Page-Specific JSON-LD Schema (e.g. Course, FAQPage, Article, BreadcrumbList) -->
    {schema && <SchemaOrg schema={schema} />}

    <!-- Theme Initialization Script to Prevent FOUC -->
    <script is:inline>
      if (
        localStorage.getItem('color-theme') === 'dark' ||
        (!('color-theme' in localStorage) &&
          window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- GA4 Analytics & Click Measurement -->
    <script is:inline define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID || '' }}>
      if (gaId) {
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', gaId, { anonymize_ip: true });
      }

      document.addEventListener('click', function(e) {
        const target = e.target.closest('a');
        if (!target) return;
        const href = target.getAttribute('href') || '';
        const location = target.getAttribute('data-track-whatsapp') || 
                         target.getAttribute('data-track-phone') || 
                         target.getAttribute('title') || 
                         target.innerText.trim().slice(0, 30) || 'unspecified';

        if (href.includes('wa.me') || href.includes('whatsapp.com')) {
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'whatsapp_click', {
              page_path: window.location.pathname,
              link_location: location,
              link_url: href
            });
          }
        } else if (href.startsWith('tel:')) {
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'phone_click', {
              page_path: window.location.pathname,
              link_location: location,
              phone_number: href.replace('tel:', '')
            });
          }
        }
      });
    </script>
  </head>
  <body class="bg-[#F8FAFC] text-[#0A1128] dark:bg-[#0B0F19] dark:text-slate-100 min-h-screen flex flex-col antialiased selection:bg-amber-400 selection:text-slate-950 font-['Plus_Jakarta_Sans',system-ui,sans-serif] overflow-x-hidden">
    <!-- Accessibility Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2.5 focus:bg-amber-400 focus:text-slate-950 focus:rounded-xl focus:font-extrabold focus:shadow-2xl focus:outline-none focus:ring-2 focus:ring-slate-900 transition-all"
    >
      Skip to main content
    </a>

    <Header />
    <main id="main-content" class="flex-grow w-full overflow-x-hidden">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
  </body>
</html>
