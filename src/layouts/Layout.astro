---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { siteData } from '../data/siteData';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = `${siteData.name} | AI Researcher & Immigration Strategist`,
  description = siteData.tagline,
  keywords = "IELTS Trainer in Lahore, Best PTE Coaching Pakistan, NAATI CCL Urdu Trainer, Canada Immigration Consultant, Australia Immigration Expert, Student Visa Consultant Pakistan, Skills Assessment Australia, AI Researcher Speech Processing, Large Audio Models",
  ogImage = "/images/moazzam.png",
  schema
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || "https://moazzamshoukat.com").href;
const absoluteOgImage = new URL(ogImage, Astro.site || "https://moazzamshoukat.com").href;

const baseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://moazzamshoukat.com/#website",
      "url": "https://moazzamshoukat.com",
      "name": "Moazzam Shoukat",
      "description": "AI Researcher, Senior Software Engineer, Canada/Australia Immigration Consultant, and IELTS/PTE Trainer in Lahore",
      "publisher": {
        "@id": "https://moazzamshoukat.com/#person"
      }
    },
    {
      "@type": "Person",
      "@id": "https://moazzamshoukat.com/#person",
      "name": "Moazzam Shoukat",
      "url": "https://moazzamshoukat.com",
      "jobTitle": "AI Researcher & Immigration Consultant",
      "telephone": "+92-328-048-4399",
      "email": "moazzamshoukat1@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lahore",
        "addressRegion": "Punjab",
        "addressCountry": "PK"
      },
      "sameAs": [
        "https://www.linkedin.com/in/moazzamshoukat/",
        "https://scholar.google.com/citations?user=uU550yYAAAAJ",
        "https://www.upwork.com/freelancers/~013acf6cdef10719d7",
        "https://www.instagram.com/moazzamshoukat/",
        "http://facebook.com/moazzamshoukat"
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={siteData.name} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social Sharing (Absolute URLs) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Moazzam Shoukat - AI Researcher and Migration Strategist" />
    <meta property="og:site_name" content={siteData.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Google Fonts Preconnect & Display Optimization -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Base Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
    
    <!-- Page-Specific JSON-LD Schema (e.g. FAQPage, Article) -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Theme Initialization Script to Prevent FOUC -->
    <script is:inline>
      if (
        localStorage.getItem('color-theme') === 'dark' ||
        (!('color-theme' in localStorage) &&
          window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-[#F8FAFC] text-[#0A1128] dark:bg-[#0B0F19] dark:text-slate-100 min-h-screen flex flex-col antialiased selection:bg-amber-400 selection:text-slate-950 font-['Plus_Jakarta_Sans',system-ui,sans-serif] overflow-x-hidden">
    <!-- Accessibility Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2.5 focus:bg-amber-400 focus:text-slate-950 focus:rounded-xl focus:font-extrabold focus:shadow-2xl focus:outline-none focus:ring-2 focus:ring-slate-900 transition-all"
    >
      Skip to main content
    </a>

    <Header />
    <main id="main-content" class="flex-grow w-full overflow-x-hidden">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
  </body>
</html>
