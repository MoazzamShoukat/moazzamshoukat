# ----------------------------------------------------------------------
# Hostinger Static Website Configuration (.htaccess)
# ----------------------------------------------------------------------

# Ensure index.html is used as the directory index
DirectoryIndex index.html

# Custom 404 Error Page
ErrorDocument 404 /404.html

# Default Charset
AddDefaultCharset UTF-8

# ----------------------------------------------------------------------
# Clean URLs, HTTPS, Canonical Apex & 301 Redirects
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://moazzamshoukat.com/$1 [R=301,L]

  # Force Apex Domain (redirect www to apex)
  RewriteCond %{HTTP_HOST} ^www\.moazzamshoukat\.com$ [NC]
  RewriteRule ^(.*)$ https://moazzamshoukat.com/$1 [R=301,L]

  # 301 Redirects for Retired / Merged Pages
  RewriteRule ^pte-coaching/?$ /online-pte-classes/ [R=301,L]
  RewriteRule ^naati-ccl-urdu/?$ /naati-ccl-urdu-preparation/ [R=301,L]
  RewriteRule ^australia-immigration/?$ /australia-skilled-migration/ [R=301,L]
  RewriteRule ^skills-assessment-australia/?$ /skill-assessment-guidance/ [R=301,L]
  RewriteRule ^immigration/?$ /services/ [R=301,L]
  RewriteRule ^english-training/?$ /services/ [R=301,L]
  RewriteRule ^education-research/?$ /research/ [R=301,L]

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Allow path/ to serve path/index.html
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]

  # If requesting path without slash, check if path/index.html exists and 301 redirect to slashed
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ https://moazzamshoukat.com/$1/ [R=301,L]
</IfModule>

# ----------------------------------------------------------------------
# Gzip / Brotli Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE font/woff
</IfModule>

# ----------------------------------------------------------------------
# Browser Caching Headers
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML - Short/revalidate for instant updates
  ExpiresByType text/html "access plus 0 seconds"

  # Static Assets with cache busting / hashes (_astro/...)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images & Icons
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# Security Headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
